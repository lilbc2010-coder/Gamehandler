			end
		end
		lastFrameCheck = t
		frameRate = frames
		frames = 1
		blendFactor = (originalBlendFactor / (frameRate / 30))
	end

	if anims[p.."climb"].IsPlaying and not humanStates["climb"] then
		anims[p.."climb"]:Stop(0.2)
	end

	if camSetting["Mode"] == "Track" then
		cam.CFrame = char.HumanoidRootPart.CFrame * camSetting["Offset"]
	end

	local lastMouseState = mouseState
	if platform == "Desktop" then
		local ray = Ray.new(cam.CFrame.p, (mouse.Hit.p - cam.CFrame.p).unit * 100)
		mouseTarget, mouseHit, mouseNormal = work:FindPartOnRayWithIgnoreList(ray, ignoreList)
		if mouseTarget then
			local isHumanoid = CheckIfPartIsHumanoid(mouseTarget)
			if mouseTarget.Name == "Click" then
				mouseState = "Hovering"
				mouseIcon.NameTag.Text = ""
			elseif mouseTarget.Name == "OwnedProp" then
				mouseState = "OwnedProp"
				mouseIcon.NameTag.Text = ""
			elseif isHumanoid then
				mouseState = "Hovering"
				mouseIcon.NameTag.Text = isHumanoid.Name
			elseif (mouseState == "Hovering" or mouseState == "OwnedProp") and not (mouseTarget.Name == "OwnedProp" or 
				mouseTarget.Name == "Click" or isHumanoid) then
				mouseState = "None"
				mouseIcon.NameTag.Text = ""
			end
		elseif mouseState ~= "None" then
			mouseState = "None"
			mouseIcon.NameTag.Text = ""
		end
	elseif platform == "Mobile" and leftMouseDown then
		local ray = Ray.new(cam.CFrame.p, (mouse.Hit.p - cam.CFrame.p).unit * 100)
		mouseTarget, mouseHit, mouseNormal = work:FindPartOnRayWithIgnoreList(ray, ignoreList)
	end
	if dragProp["Mode"] and mouseTarget then
		if dragProp["Mode"] == "Drag" then
			local cf = CFrame.new(mouseHit)
			if dragProp["RefMode"] == "Local" then
				cf = CFrame.new(mouseHit, mouseHit + mouseNormal) * CFrame.Angles(math.rad(-90), 0, 0)
			end
			dragProp["Prop"]:SetPrimaryPartCFrame(cf)
		end
	end
	if lastMouseState ~= mouseState then
		mouseIcon.Image = TNS1..mouseIcons[mouseState]..TNS2
	end
	mouseIcon.Position = UDim2.new(-0.007, mouse.X, -0.013, mouse.Y)

	if not GUI.FirstEntry.Value then
		NonFirstEntryProcesses(t)
	elseif gameId == fl2Id then
		game.Lighting.Ambient = Color3.fromRGB(50, 50, 50)
		game.Lighting.OutdoorAmbient = Color3.fromRGB(50, 50, 50)
		game.Lighting.Brightness = 0
		game.Lighting.TimeOfDay = 0
	end
end)

