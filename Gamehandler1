	objectRunner = RunService.Stepped:connect(function()
		local t = tick()
		if (t - lastInterval) >= 0.04 then
			lift:SetPrimaryPartCFrame(lift.PrimaryPart.CFrame + Vector3.new(0, movement, 0))
		end
		if (limit.CFrame.p - lift.PrimaryPart.CFrame.p).magnitude < 0.1 then
			objectRunner:disconnect()
			CoroutineLauncher("PlaySound", lift.PrimaryPart, "InteractiveSounds", "ElevatorStop", 0, {75, 85})
			sound:Destroy()
			wait(0.4)
			lift.Debounce.Value = false
			lift.Parent.Debounce.Value = false
		end
	end)
end

function InteractStove(button)
