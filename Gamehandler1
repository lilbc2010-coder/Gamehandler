					for _,v in pairs(tool:GetChildren()) do
						if v.Name == "Magazine" then
							v.Transparency = 0
						end
					end
				else
					for _,v in pairs(tool:GetChildren()) do
						if v:IsA("Model") then
							for _,b in pairs(v:GetChildren()) do
								b.Transparency = 1
							end
						end
					end
