	local groundTouched, boltParts = false, {}
	local newPart = serv.Lightning:Clone()
	local startingLocation = CFrame.new(math.random(-1300, 1000), 500, math.random(-3000, 2000)) * 
		CFrame.Angles(math.rad(math.random(-15, 15)), math.rad(math.random(-15, 15)), math.rad(math.random(-15, 15)))
	newPart.CFrame = startingLocation
	newPart.Size = Vector3.new(2, math.random(8, 40), 2)
	rep.WeatherUpdate:FireAllClients("Thunder", startingLocation)
	boltParts[1] = newPart
	local currentCentralSegment = newPart
	while not groundTouched do
		local newSegment = NewLightningSegment(currentCentralSegment, 2)
		currentCentralSegment = newSegment
		boltParts[#boltParts + 1] = newSegment
		if math.random(1, 8) == 8 then
			local width = 2
			boltParts[#boltParts + 1] = NewLightningSegment(newSegment, 2)
			while width > 0.5 do
				local strayPart = NewLightningSegment(boltParts[#boltParts], width)
				boltParts[#boltParts + 1] = strayPart
				width = width - (math.random(25, 50) * 0.01)
				wait()
			end
		end
		if newSegment.CFrame.p.Y < 0 then
			groundTouched = true
		end
		wait()
	end
	for _,v in pairs(boltParts) do
		v.Parent = work
	end
	wait(0.4)
	for i = 1, 4 do
		for _,v in pairs(boltParts) do
			v.Transparency = 1
		end
		wait(0.2)
		for _,v in pairs(boltParts) do
			v.Transparency = 0
		end
	end
	for i = 1, 20 do
		for _,v in pairs(boltParts) do
			v.Transparency = (1 / 20) * i
		end
		wait(0.1)
	end
	for _,v in pairs(boltParts) do
		v:Destroy()
	end
end

function WorldCycle()
	local cycleRunner
	local lastTick = tick()
	local testTick = lastTick

	-- Separate loop for player time tracking (runs once per second instead of 60 times/sec)
	spawn(function()
		local lastPlayerUpdate = tick()
		while true do
			wait(1) -- Update once per second
			local currentTime = tick()
			local deltaTime = currentTime - lastPlayerUpdate
			lastPlayerUpdate = currentTime

			for plrName, entry in pairs(gameData) do
				local charBio = rep.CharacterBios:FindFirstChild(plrName)
				if charBio then
					local timePlayed = entry["Account"]["TimePlayed"]
					local beforeLevel = math.floor(timePlayed / 1800)
					timePlayed = timePlayed + deltaTime
					local afterLevel = math.floor(timePlayed / 1800)
					gameData[plrName]["Account"]["TimePlayed"] = timePlayed
					if afterLevel > beforeLevel then
						charBio.Level.Value = afterLevel
						local plr = game.Players:FindFirstChild(plrName)
						if plr then
							-- Save data outside physics loop
							spawn(function()
								SaveData(plr.UserId, gameData[plrName]["Account"], DataStore)
								rep.ServerNotification:FireClient(plr, "You are now level "..afterLevel.."!", afterLevel)
							end)
						elseif gameData[plrName] then
							gameData[plrName] = nil
						end
					end
				end
			end
		end
	end)

	CoroutineLauncher("Radio")
	cycleRunner = RunService.Stepped:Connect(function()
		local t = tick()
		local hour, minute, second = string.sub(light.TimeOfDay, 1, 2), string.sub(light.TimeOfDay, 4, 5), string.sub(light.TimeOfDay, 7, 8)
		local timeSinceLastTick = (t - lastTick)
		timeSinceLastTick = timeSinceLastTick * timeSpeed
		lastTick = t
		second = second + timeSinceLastTick
		weatherCounter = weatherCounter + 0.00001
		if not omniToolProcess["Weather"] then
			weather = (math.noise(weatherCounter, 0.051, 1.323) + 1) * 0.5
			if currentWeather == "Clear" and (weather >= PWL and weather < BWL) then
				currentWeather = weatherTable[math.random(#weatherTable)]
				weatherSettings.Weather.Value = currentWeather
				if currentWeather == "Sandstorm" then
					rep.WeatherUpdate:FireAllClients("Sandstorm")
				end
			elseif currentWeather ~= "Clear" and weather < PWL then
				currentWeather = "Clear"
				weatherSettings.Weather.Value = currentWeather
				rep.WeatherUpdate:FireAllClients("Clear")
				if clouds[1].Transparency ~= 1 then
					for _,cloud in pairs(clouds) do
						cloud.Transparency = 1
					end
				end
			elseif currentWeather == "Stormfront" and weather > BWL then
				currentWeather = cloudPathTable[math.random(#cloudPathTable)]
				weatherSettings.Weather.Value = currentWeather
			elseif cloudPathways[currentWeather] and (weather >= PWL and weather < BWL) then
				currentWeather = "Stormfront"
				weatherSettings.Weather.Value = currentWeather
			elseif currentWeather == "Sandstorm" and weather > PWL then
				weatherSettings.Weather.Value = currentWeather
			end
		else
			uWeather = (math.noise(weatherCounter, 0.051, 1.323) + 1) * 0.5
		end
		if currentWeather ~= "Clear" and weather >= PWL then
			if (weather < BWL and weather >= PWL) and currentWeather == "Stormfront" then
				local cloudCover = (weather - PWL) / (BWL - PWL)
				for _,cloud in pairs(clouds) do
					cloud.Transparency = 1 - cloudCover
				end
				weatherSettings.Severity.Value = cloudCover
			elseif weather >= BWL and cloudPathways[currentWeather] then
				weatherSettings.Severity.Value = (weather - BWL) / (1 - BWL)
			elseif currentWeather == "Sandstorm" then
				weatherSettings.Severity.Value = (weather - PWL) / (1 - PWL)
			elseif currentWeather == "Tornado" then
				--not yet programmed
			end
			if (currentWeather == "Stormy" or currentWeather == "Lightning") and weather >= BWL then
				if (t - lastLightningBolt) >= timeBetweenLightningBolts then
					lastLightningBolt = t
					timeBetweenLightningBolts = ((1 - ((weather - BWL) / (1 - BWL))) * 30) + math.random(1, 10)
					CoroutineLauncher("GenerateLightning")
				end
			end
		end
		
		if not omniToolProcess["Time"] then
			if second >= 60 then
				second = second - 60
				minute = minute + 1
				if minute >= 60 then
					CoroutineLauncher("CodesUpdate")
					minute = 0
					hour = hour + 1
					if hour >= 24 then
						hour = 0
					elseif timeSpeed ~= nightSpeed and hour >= hourTwilightBegin then
						timeSpeed = nightSpeed
					elseif timeSpeed ~= daySpeed and (hour >= hourMorningBegin and hour < hourTwilightBegin) then
						timeSpeed = daySpeed
					end
					if hour == 7 then
						for _,lamp in pairs(lampPosts) do
							lamp.Light.Material = Enum.Material.Ice
							lamp.Light.BrickColor = BrickColor.new("Black")
							lamp.Light.Light.Enabled = false
						end
					elseif hour == 18 then
						for _,lamp in pairs(lampPosts) do
							lamp.Light.Material = Enum.Material.Neon
							lamp.Light.Color = lamp.Light.PreferredPartColor.Value
							lamp.Light.Light.Brightness = lamp.Light.PreferredBrightness.Value
							lamp.Light.Light.Color = lamp.Light.PreferredLightColor.Value
							lamp.Light.Light.Enabled = true
						end
					end
					if hour == hourMorningEnd and gameId ~= fl2Id then
						CoroutineLauncher("Announcement")
					end
				end
			end
			light.TimeOfDay = hour..":"..minute..":"..second
		end
		
		for _,v in pairs(seatConnections) do
			if v[1]:FindFirstChild("VehicleSeat") then
				if v[1].Parent.Parent and v[1].VehicleSeat.Occupant then
					--local velocity = v[1].VehicleSeat.Throttle * v[1].VehicleSeat.speed.Value
					--v[1].PrimaryWeld.Running.PlaybackSpeed = 1 + math.max(math.min((velocity / 75), 1), 0)
					v[1].PrimaryWeld.Running.PlaybackSpeed = 1 + math.max(math.min(v[1].PrimaryWeld.Velocity.magnitude / 75, 1), 0)
				end
			end
		end
	end)
end

function NewLightningSegment(previousPart, width)
	local newPart = serv.Lightning:Clone()
	newPart.Size = Vector3.new(width, math.random(8, 40), width)
	newPart.CFrame = previousPart.CFrame * CFrame.new(0, -previousPart.Size.Y * 0.5, 0)
	local r = newPart.Orientation
	local xRot = math.random(-89 - r.X, 89 - r.X)
	local zRot = math.random(-89 - r.Z, 89 - r.Z)
	newPart.CFrame = newPart.CFrame * CFrame.Angles(math.rad(xRot), 0, math.rad(zRot))
	newPart.CFrame = newPart.CFrame * CFrame.new(0, -newPart.Size.Y * 0.5, 0)
	return newPart
end

