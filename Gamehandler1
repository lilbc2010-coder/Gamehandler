local seatConnections = {}
function rep.VehicleUpdate.OnServerInvoke(plr, item1, item2, item3)
	local char = plr.Character
	if char and char.Parent then
		if item1 == "Delete" then
			for i,v in pairs(gameData[plr.Name]["Server"]["PropsPlaced"]) do
				if v:FindFirstChild("Chassis") then
					table.remove(gameData[plr.Name]["Server"]["PropsPlaced"], i)
					v:Destroy()
					if seatConnections[plr.Name] then
						seatConnections[plr.Name][2]:Disconnect()
						seatConnections[plr.Name] = nil
					end
					break
				end
			end
			return true
		elseif item1 == "Toggle Lights" then
			local vehicle
			for _,v in pairs(gameData[plr.Name]["Server"]["PropsPlaced"]) do
				if v:FindFirstChild("Chassis") then
					vehicle = v
					break
				end
			end
			if vehicle then
				if vehicle.BodyKit.Light_White.Material == mat.Neon then
					ChangeLights(vehicle.BodyKit, {Light_White = true, Light_Yellow = true, Light_Red = true}, "Off")
				else
					ChangeLights(vehicle.BodyKit, {Light_White = true, Light_Yellow = true, Light_Red = true}, "On")
					if vehicle.Chassis.VehicleSeat.Throttle == -1 then
						ChangeLights(vehicle.BodyKit, {Light_Red = true}, "Reverse")
					end
				end
			end
		else
			for i,v in pairs(gameData[plr.Name]["Server"]["PropsPlaced"]) do
				if v:FindFirstChild("Chassis") then
					table.remove(gameData[plr.Name]["Server"]["PropsPlaced"], i)
					v:Destroy()
					break
				end
			end
			local vehicleName, vehicleColor = item1, item2
			local vehicle = game.ServerStorage.Vehicles:FindFirstChild(vehicleName):Clone()
			local timeStamp = Instance.new("NumberValue")
			timeStamp.Name = "TimeStamp"
			timeStamp.Parent = vehicle.BodyKit
			timeStamp.Value = item3
			timeStamp = Instance.new("NumberValue")
			timeStamp.Name = "TimeStamp"
			timeStamp.Parent = vehicle.BodyKit.Color
			timeStamp.Value = item3
			for _,v in pairs(vehicle:GetChildren()) do
				if string.find(v.Name, "Weld") then
					local weldBase = vehicle.Chassis:FindFirstChild(string.sub(v.Name, 6, string.len(v.Name)))
					for _,b in pairs(v:GetChildren()) do
						local w = Instance.new("Weld") 
						w.Part0 = b 
						w.Part1 = weldBase
						w.C0 = w.Part0.CFrame:toObjectSpace(w.Part1.CFrame)
						w.Parent = w.Part1
					end
				elseif v.Name == "BodyKit" then
					for _,b in pairs(v:GetChildren()) do
						if b:IsA("Model") then
							for _,n in pairs(b:GetChildren()) do
								if n:IsA("BasePart") or n:IsA("UnionOperation") then
									local w = Instance.new("Weld") 
									w.Part0 = n
									w.Part1 = vehicle.Chassis.PrimaryWeld
									w.C0 = w.Part0.CFrame:toObjectSpace(w.Part1.CFrame) 
									w.Parent = w.Part1
									if b.Name == "Color" then
										n.BrickColor = vehicleColor
									end
								elseif n.Name == "Owner" then
									n.Value = plr.Name
								end
							end
						elseif b:IsA("BasePart") then
							local w = Instance.new("Weld") 
							w.Part0 = b 
							w.Part1 = vehicle.Chassis.PrimaryWeld
							w.C0 = w.Part0.CFrame:toObjectSpace(w.Part1.CFrame) 
							w.Parent = w.Part1
						elseif b.Name == "Owner" then
							b.Value = plr.Name
						end
					end
				end
			end
			Scan(vehicle.BodyKit)
			local seat = vehicle.Chassis.VehicleSeat
			local chassis, accel = vehicle.Chassis, seat.acceleration.Value
			chassis.A.Motor.MotorMaxTorque = accel
			chassis.AA.Motor.MotorMaxTorque = accel
			chassis.B.Motor.MotorMaxTorque = accel
			chassis.BB.Motor.MotorMaxTorque = accel
			seatConnections[plr.Name] = {chassis, seat.Changed:Connect(function(property)
				if property == "Occupant" then
					local human = seat.Occupant
					local primaryWeld = chassis:FindFirstChild("PrimaryWeld")
					if human --[[and human.Parent:FindFirstChild("Torso")]] and primaryWeld then
						if human.Parent.MeshHead.Transparency == 1 then
							human.Health = 0
							return
						end
						--human.Parent.CollisionPart.Name = "CollisionPart"
						seat.speed.Value = 0
						primaryWeld.Stopping:Stop()
						primaryWeld.Starting:Play()
						wait(1.4)
						ChangeLights(vehicle.BodyKit, {Light_White = true, Light_Yellow = true, Light_Red = true}, "On")
						primaryWeld.Running:Play()
						seat.speed.Value = seat.defaultSpeed.Value
					else
						seat.speed.Value = 0
						ChangeLights(vehicle.BodyKit, {Light_White = true, Light_Yellow = true, Light_Red = true}, "Off")
						primaryWeld.Starting:Stop()
						primaryWeld.Running:Stop()
						primaryWeld.Stopping:Play()
						wait(primaryWeld.Stopping.TimeLength)
					end
				elseif property == "Throttle" then
					if vehicle.BodyKit.Light_Red.Material == mat.Neon then
						local lightStr = ""
						if seat.Throttle == -1 then
							lightStr = "Reverse"
						elseif seat.Throttle ~= -1 then
							lightStr = "On"
						end
						ChangeLights(vehicle.BodyKit, {Light_Red = true}, lightStr)
					end
				end
			end)}
			vehicle:SetPrimaryPartCFrame(char.PrimaryPart.CFrame * CFrame.new(0, 10, -20))
			table.insert(gameData[plr.Name]["Server"]["PropsPlaced"], vehicle)
			vehicle.Parent = game.Workspace
			return true
		end
	end
end

function ChangeLights(bodykit, lightList, setting)
	for _,part in pairs(bodykit:GetChildren()) do
		if string.find(part.Name, "Light") then
			local lName = part.Name
			if lightList[lName] then
				local lightSetting = vehicleLightSettings[lName][setting]
				part.Material = lightSetting["Material"]
				part.BrickColor = lightSetting["Color"]
				if part:FindFirstChild("Light") then
					part.Light.Enabled = lightSetting["LightOn"]
				end
			end
		end
	end
end

