function CharScan(item, mode)
	for _,v in pairs(item:GetChildren()) do
		if #item:GetChildren() > 0 then
			CharScan(v, mode)
		end
	end
	if (item.Name ~= "Head" and item.Name ~= "CollisionPart") and 
		(item:IsA("BasePart") or item:IsA("UnionOperation") or item:IsA("MeshPart") or item:IsA("Decal")) then
		if mode then
			local oT = Instance.new("NumberValue")
			oT.Value = item.Transparency
			oT.Name = "StoredTransparency"
			oT.Parent = item
			item.Transparency = 0.95
		elseif item:FindFirstChild("StoredTransparency") then
			item.Transparency = item.StoredTransparency.Value
			item.StoredTransparency:Destroy()
		end
	end
end

