function InitializeButton(v)
	local index = #buttons + 1
	buttons[index] = {v, v.Parent, {}}
	for _,n in pairs({v, v.Parent}) do
		local connection
		if v:IsDescendantOf(toolboxFrame) and v.Name == "Button" and v.Parent.Name ~= "ToggleFrame" then
			connection = n.TouchLongPress:Connect(function(pos, state)
				if state == Enum.UserInputState.Begin and v.Text ~= "None" then
					if MouseInsideFrame(v.AbsolutePosition.X, v.AbsolutePosition.X + v.AbsoluteSize.X, 
						v.AbsolutePosition.Y, v.Parent.AbsolutePosition.Y + v.Parent.AbsoluteSize.Y) then
						v.Parent.DisplayToggleDebounce.Value = true
						ToggleToolDisplay(v)
					end
				end
			end)
			table.insert(buttons[index][3], connection)
		end
		connection = n.MouseEnter:Connect(function()
			local vBs = n
			if n.Name == "Button" then
				vBs = n.Parent
			end
			while vBs.Moving.Value do wait() end
			if MouseInsideFrame(v.AbsolutePosition.X, v.AbsolutePosition.X + v.AbsoluteSize.X, 
				v.AbsolutePosition.Y, vBs.AbsolutePosition.Y + vBs.AbsoluteSize.Y) and leftMouseDown then
				v:TweenPosition(UDim2.new(0, 0, 0, 0), "Out", "Sine", 0.1)
				vBs.Moving.Value = true
				wait(0.1)
				vBs.Moving.Value = false
			end
		end)
		table.insert(buttons[index][3], connection)
		connection = n.MouseButton1Down:Connect(function()
			local vBs = n
			if n.Name == "Button" then
				vBs = n.Parent
			end
			while vBs.Moving.Value do wait() end
			if MouseInsideFrame(v.AbsolutePosition.X, v.AbsolutePosition.X + v.AbsoluteSize.X, 
				v.AbsolutePosition.Y, vBs.AbsolutePosition.Y + vBs.AbsoluteSize.Y) then 
				v:TweenPosition(UDim2.new(0, 0, 0, 0), "Out", "Sine", 0.1)
				vBs.Moving.Value = true
				if mobileFrame.Visible and v.Parent.Name == "UseToolButton" then
					leftMouseDown = true
					ClickAction()
				else
					wait(0.1)
				end
				vBs.Moving.Value = false
			end
		end)
		table.insert(buttons[index][3], connection)
		connection = n.MouseButton1Up:Connect(function()
			local vBs = n
			if n.Name == "Button" then
				vBs = n.Parent
			end
			if plrState == "Dead" then return end
			while vBs.Moving.Value do wait() end
			if (notifier.Text == "LOADING" and notifier.Visible) or not MouseInsideFrame(v.AbsolutePosition.X, 
				v.AbsolutePosition.X + v.AbsoluteSize.X, v.AbsolutePosition.Y, v.Parent.AbsolutePosition.Y + 
					v.Parent.AbsoluteSize.Y) then 
				return 
			end
			local moveTime = 0.1
			script.GUISounds.Click:Play()
			v:TweenPosition(UDim2.new(0, 0, vBs.Origin.Value, 0), "Out", "Sine", 0.1)
			vBs.Moving.Value = true
			if plrState ~= "Customizing" then
				if v.Parent.Name == "CustomizeFrame" then
					plrState = "Customizing"
					if gameFrame.OOCFrame.On.Value then
						gameFrame.OOCFrame.On.Value = false
						rep.OOCModeUpdate:InvokeServer(false)
					end
					human:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
					ChangeSpeed("Walk")
					StopSittingAnims()
					if platform == "Mobile" then
						mobileFrame.Visible = false
					end
					gameFrame:TweenPosition(UDim2.new(-1.2, 0, 0.35, 0), "In", "Sine", moveTime)
					toolboxFrame:TweenPosition(UDim2.new(0, 0, 1.2, 0), "In", "Sine", moveTime)
					tsFrame.BackgroundTransparency = 1
					tsFrame.Visible = true
					tsFrame.TransitionPhase.Value = "In"
					tpFrame.Ready.Value = false
					tpFrame:TweenPosition(UDim2.new(0.7, 0, 1.7, 0), "Out", "Sine", 0)
					animFrame.Visible = false
					settingFrame.Visible = false
					plrFrame.Visible = false
					characterBioName = nil
					customizationRoom = rep.CustomizationRoom:Clone()
					customizationRoom:SetPrimaryPartCFrame(CFrame.new(math.random(-250, 250), -150, math.random(50, 350)) * 
						CFrame.Angles(math.rad(-90), 0, 0))
					customizationRoom.CamPart.Origin.Value = customizationRoom.CamPart.CFrame
					customizationRoom.Parent = work
					rep.Teleport:InvokeServer("Transitioning_Customize", customizationRoom.CharacterPosition.CFrame)
					while cam.CameraType == Enum.CameraType.Custom do
						wait()
					end
					humanStates = {moving = false, stand = true, run = false, crouch = false, prone = false, climb = false, fall = false, 
						swim = false, climbDirection = "None", resting = false, animated = false}
					for _,v in pairs(anims) do
						v:Stop()
					end
					anims[p.."stand"]:Play(0, 1, 1)
					if equippedTool["Variant"] ~= "None" then
						if equippedTool["Config"] ~= equippedTool["Variant"] then
							ReconfigureUndermount()
						end
						rep.EquipTool:InvokeServer("Unequip", equippedTool["Base"], equippedTool["Config"], equippedTool["Slot"])
						equippedTool["Toggle"] = "Unequipped"
						ResetTool()
					end
					customizeFrame:TweenPosition(UDim2.new(0, 0, 0.1, 0), "In", "Sine", moveTime)
					GUI.Wallet:TweenPosition(UDim2.new(0.8, -5, 0.925, -5), "In", "Sine", moveTime)
				elseif v.Parent.Name == "DiceFrame" and not v.Parent.Rolling.Value then
					v.Parent.Rolling.Value = true
