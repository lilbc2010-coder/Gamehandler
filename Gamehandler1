function GunFlash(part, activateSound, hitPositions, baseName, variantName)
	local hitPos = hitPositions["HitData"][1]["HitPos"]
	CoroutineLauncher("PlaySound", part, "ToolSounds", activateSound, 0, {95, 105})
	if variantName == "AKIRA-18" or variantName == "NLR" then
		CoroutineLauncher("ParticleEffect", "LaserImpact", CFrame.new(hitPos, part.CFrame.p), "Emission", 30)
	elseif variantName == "Virtual:Smoke_Launcher" or variantName == "M32 Smoke" then
		if variantName == "Virtual:Smoke_Launcher" then
			part = part.Parent.SecondaryTip
		end
		CoroutineLauncher("SmokeGrenade", CFrame.new(hitPos, part.CFrame.p))
	elseif variantName == "Virtual:Shockbreach" then
		part = part.Parent.SecondaryTip
		GenerateTargetedLightning(part.CFrame.p, hitPositions["HitData"][1]["HitPos"])
		return
	end
	for _,v in pairs(part:GetChildren()) do
		if v:IsA("ParticleEmitter") then
			v:Emit(5)
		end
	end
	if part:FindFirstChild("Flash") then
		CoroutineLauncher("FlashEffect", part)
	end
	local shotType = FindToolSetting(baseName, variantName, "Setting_shotType")
	for i,v in pairs(gameData) do
		local plr = game.Players:FindFirstChild(i)
		if plr and v["Server"]["BulletTrails"] then
			rep.ProjectileTrail:FireClient(plr, hitPositions, shotType)
		end
	end
end

