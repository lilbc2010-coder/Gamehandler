function ParticleDropImpact(particle)
	particle.Enabled = false
	local pName, pPos = particle.Name, particle.Attachment0.Position
	particle.Attachment0:Destroy()
	particle.Attachment1:Destroy()
	particle:Destroy()
	if rainSplashActive then
		if pName == "RainParticle" then
			local part
			for _,p in pairs(splashPool) do
				if p.Available.Value then
					part = p 
					p.Available.Value = false
					break
				end
			end
			if part then
				part.CFrame = CFrame.new(pPos)
				part.Splash:Emit(2)
				delay(0.6, function() 
					part.CFrame = CFrame.new()
					part.Available.Value = true
				end)
			end
		end
	end
end

function rep.Teleport.OnClientInvoke(target)
	if not tpFrame.Ready.Value then
		tpFrame.Ready.Value = true
		local str = target
		if string.find(target, "Teleporter") then
			str = string.sub(target, 12, string.len(target))
		end
		tpFrame.Label.Text ="Travel to "..str.."?"
		tpFrame:TweenPosition(UDim2.new(0.7, 0, 0.7, 0), "In", "Sine", 0)
	end
