					cap.Transparency = 1
				end
			elseif interaction == "Lid Close" then
				local cap = tool:FindFirstChild("Cap")
				if cap then
					cap.Transparency = 0
				end
			elseif string.find(interaction, "Hammer") then
				local rotation = 45
				if string.find(interaction, "HammerIn") then
					rotation = -rotation
				end
				if FindToolSetting(baseName, variantName, "Setting_isDualWielded") then
