function WeldToolParts(tool)
	for _,v in pairs(tool:GetChildren()) do
		if not v:IsA("Model") and v ~= tool.PrimaryPart then
			local w = Instance.new("Weld") 
			w.Part0 = v 
			w.Part1 = tool.PrimaryPart 
			w.C0 = w.Part0.CFrame:toObjectSpace(w.Part1.CFrame)
			w.Name = "Weld_"..v.Name 
			w.Parent = w.Part1
		elseif v:IsA("Model") then
			for _,n in pairs(v:GetChildren()) do
				if n ~= v.PrimaryPart then
					local w = Instance.new("Weld") 
					w.Part0 = n 
					w.Part1 = v.PrimaryPart 
					w.C0 = w.Part0.CFrame:toObjectSpace(w.Part1.CFrame)
					w.Name = "Weld_"..n.Name 
					w.Parent = w.Part1
				end
			end
			local w = Instance.new("Weld") 
			w.Part0 = v.PrimaryPart
			w.Part1 = tool.PrimaryPart 
			w.C0 = w.Part0.CFrame:toObjectSpace(w.Part0.CFrame)
			w.C1 = w.Part1.CFrame:toObjectSpace(w.Part0.CFrame)
			w.Name = "Weld_"..v.Name 
			w.Parent = w.Part1
		end
	end
end

function WeldToHolster(char, storedTool, effectSustained)
	local tool = storedTool.Model:Clone()
	local models = {tool}
	local offHandTool = storedTool:FindFirstChild("Model_OffHand")
	if offHandTool then
		models[2] = offHandTool:Clone()
	end
	for i,model in pairs(models) do
		local weldBase = char:FindFirstChild(model.Holster.WeldBase.Value)
		model:SetPrimaryPartCFrame(weldBase.CFrame)
		model.Holster:Destroy()
		model.PrimaryPart = model.Handle
		WeldToolParts(model)
		local w = Instance.new("Weld") 
		w.Part0 = weldBase
		w.Part1 = model.PrimaryPart
		w.C0 = w.Part0.CFrame:toObjectSpace(w.Part0.CFrame) 
		w.C1 = w.Part1.CFrame:toObjectSpace(w.Part0.CFrame)
		w.Parent = w.Part1
		w.Name = "PrimaryWeld"
		local suffix = ""
		if i == 2 then
			suffix = "_OffHand"
		end
		model.Name = storedTool.Name..suffix
