function fnv(current, goal, factor)
	if not factor then
		factor = blendFactor
	end
	if math.abs(current - goal) > factor then
		if current > goal then
			return math.max(current - factor, goal)
		else
			return math.min(current + factor, goal)
		end
	else
		return goal
	end
end

function fiv(current, goal, interval)
	return current + (goal - current) * interval
end

function CloneTable(tab, index)
	local result = type(tab[index]) == "table" and {unpack(tab[index])}
	local defaultWeather = weatherLighting[index]
	if result then
		for i,v in pairs(result) do
			if not v then
				result[i] = defaultWeather[i]
			end
		end
		return result
	else
		return {unpack(defaultWeather)}
	end
end

