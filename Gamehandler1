		color, material = stove.OriginalColor.Value, mats[string.sub(matVal, 15, string.len(matVal))]
		stove.Activated.Value = false
	else
		stove.Activated.Value = true
	end
	for _,v in pairs(stove:GetChildren()) do
		if v.Name == "HeatedPad" then
			v.Color = color
			v.Material = material
		end
	end
	wait(0.2)
	stove.Debounce.Value = false
end

function InteractDrawer(button)
	local drawer = button.Parent
	drawer.Debounce.Value = true
	local goalCF = drawer.OutCF.Value
	if drawer.Drawn.Value then
		drawer.Drawn.Value = false
		goalCF = drawer.InCF.Value
	else
		drawer.Drawn.Value = true
	end
	CoroutineLauncher("PlaySound", button, "InteractiveSounds", "Drawer", 0, {95, 105})
	local startT = tick()
	local startCF = drawer.PrimaryPart.CFrame
	local objectRunner
	objectRunner = RunService.Stepped:connect(function()
		if drawer.Parent then
			local rawProgress = math.min((tick() - startT) / 0.4, 1)
			local easedProgress = EaseInOutSine(rawProgress)
			drawer:SetPrimaryPartCFrame(startCF:lerp(goalCF, easedProgress))
			if rawProgress >= 1 then
				objectRunner:Disconnect()
				wait(0.2)
				drawer.Debounce.Value = false
			end
		else
			objectRunner:Disconnect()
		end
	end)
end

