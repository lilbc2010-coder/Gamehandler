function rep.OmnitoolCommand.OnServerInvoke(plr, command, input)
	if string.find(command, ":") then
		return
	end
	if gameData[plr.Name]["Server"]["ATFABRank"] >= 200 or (game.PrivateServerId and game.PrivateServerOwnerId == plr.UserId) then
		if command == "change_time" then
			if input == "freeze" then
				omniToolProcess["Time"] = true
			elseif input == "run" then
				omniToolProcess["Time"] = false
			else
				omniToolProcess["Time"] = true
				local startTime = tick()
				local start = tonumber(string.sub(light.TimeOfDay, 1, 2)..string.sub(light.TimeOfDay, 4, 5))
				if input < start then
					input = input + 2400
				end
				local cycleTime = (input - start) * 0.01
				local elapsedSeconds = 0
				while elapsedSeconds < cycleTime do
					wait()
					elapsedSeconds = tick() - startTime
					local newTime = math.floor(start + ((input - start) * (elapsedSeconds / cycleTime)))
					local newHour = (newTime * 0.01) - ((newTime * 0.01) % 1)
					local newMinute = ((newTime * 0.01) % 1) * 60
					newMinute = math.min((newMinute - (newMinute % 1)), 60)
					light.TimeOfDay = tostring(newHour)..":".. tostring(newMinute)..":00"
				end
				omniToolProcess["Time"] = true
			end
		elseif command == "change_weather" then
			omniToolProcess["Weather"] = true
			local _,_,wMode, wIntensity = string.find(input, "(%w+)_(%w+)")
			if not wMode and string.find(input, "clear") then
				wMode = "clear"
			end
			if input ~= "default" then
				if wMode ~= "clear" and (currentWeather == "Clear" or currentWeather == "Stormfront") then
					if wMode == "sandstorm" then
						rep.WeatherUpdate:FireAllClients("Sandstorm")
						BlendWeather("Clear_Sandstorm", wMode, wIntensity)
					else
						BlendWeather("Clear_Stormfront", wMode, wIntensity)
						BlendWeather("Stormfront_Inclement", wMode, wIntensity)	
					end
				elseif wMode == "clear" and currentWeather ~= "Clear" then
					if currentWeather == "Sandstorm" then
						BlendWeather("Sandstorm_Clear", wMode, wIntensity)
					else
						BlendWeather("Inclement_Stormfront", wMode, wIntensity)
						BlendWeather("Stormfront_Clear", wMode, wIntensity)
					end
					rep.WeatherUpdate:FireAllClients("Clear")
				elseif wMode ~= "clear" and (currentWeather ~= "Stormfront" and currentWeather ~= "Clear") then
					if currentWeather == "Sandstorm" and wMode ~= "sandstorm" then
						BlendWeather("Sandstorm_Clear", wMode, wIntensity)
						BlendWeather("Clear_Stormfront", wMode, wIntensity)
					elseif string.lower(currentWeather) ~= string.lower(wMode) then
						BlendWeather("Inclement_Stormfront", wMode, wIntensity)
					end
					if wMode == "sandstorm" then
						if currentWeather ~= "Sandstorm" then
							BlendWeather("Stormfront_Clear", wMode, wIntensity)
							rep.WeatherUpdate:FireAllClients("Sandstorm")
						end
						BlendWeather("Clear_Sandstorm", wMode, wIntensity)
					else
						BlendWeather("Stormfront_Inclement", wMode, wIntensity)
					end
				end
			else
				if uCurrentWeather == currentWeather then
					RestoreWeatherValue()
				else
					if uCurrentWeather == "Clear" then
						if currentWeather ~= "Stormfront" and currentWeather ~= "Sandstorm" then
							BlendWeather("Inclement_Stormfront", "clear", 1)
							BlendWeather("Stormfront_Clear", "clear", 1)
						elseif currentWeather == "Sandstorm" then
							BlendWeather("Sandstorm_Clear", "clear", 1)
						else
							BlendWeather("Stormfront_Clear", "clear", 1)
						end
						weather = uWeather
						rep.GlobalWeather.Severity.Value = weather
					elseif uCurrentWeather == "Stormfront" then
						if currentWeather == "Clear" then
							BlendWeather("Clear_Stormfront", wMode, wIntensity)
							RestoreWeatherValue()
						elseif currentWeather == "Sandstorm" then
							BlendWeather("Sandstorm_Clear", "stormfront", 0)
							rep.WeatherUpdate:FireAllClients("Clear")
							RestoreWeatherValue()
						else
							BlendWeather("Inclement_Stormfront", "clear", 1)
							RestoreWeatherValue()
						end
					elseif uCurrentWeather == "Sandstorm" then
						if currentWeather == "Stormfront" then
							BlendWeather("Stormfront_Clear", "clear", 1)	
						elseif currentWeather ~= "Clear" then
							BlendWeather("Inclement_Stormfront", "clear", 1)
							BlendWeather("Stormfront_Clear", "clear", 1)
						end
						currentWeather = "Sandstorm"
						rep.GlobalWeather.Weather.Value = "Sandstorm"
						rep.WeatherUpdate:FireAllClients("Sandstorm")
						RestoreWeatherValue()
					else
						BlendWeather("Inclement_Stormfront", "clear", 1)
						currentWeather = uCurrentWeather
						rep.GlobalWeather.Weather.Value = currentWeather
						RestoreWeatherValue()
					end
				end
				omniToolProcess["Weather"] = true
			end
		end
	end
end

function RestoreWeatherValue()
	local direction = 1
	if uWeather < weather then
		direction = -1
	end
	while math.abs(uWeather - weather) > 0.001 do
		wait()
		weather = weather + (0.0005 * direction)
		rep.GlobalWeather.Severity.Value = weather
	end
end

function BlendWeather(switchMode, wMode, wIntensity)
	if switchMode == "Stormfront_Inclement" then
		local trueName = string.upper(string.sub(wMode, 1, 1))..string.sub(wMode, 2, string.len(wMode))
		currentWeather = trueName
		rep.GlobalWeather.Weather.Value = trueName
		local startTime, elapsedSeconds, cycleTime = tick(), 0, wIntensity * 0.1
		while elapsedSeconds < cycleTime do
			wait()
			elapsedSeconds = tick() - startTime
			local trueIntensity = (wIntensity * 0.01)
			local severity = math.min(trueIntensity * (elapsedSeconds / cycleTime), trueIntensity)
			local newVal = BWL + (severity * (1 - BWL))
			weather = newVal
			rep.GlobalWeather.Severity.Value = severity
		end
	elseif switchMode == "Clear_Sandstorm" then
		local trueName = string.upper(string.sub(wMode, 1, 1))..string.sub(wMode, 2, string.len(wMode))
		currentWeather = trueName
		rep.GlobalWeather.Weather.Value = trueName
		local startTime, elapsedSeconds, cycleTime = tick(), 0, wIntensity * 0.1
		while elapsedSeconds < cycleTime do
			wait()
			elapsedSeconds = tick() - startTime
			local trueIntensity = (wIntensity * 0.01)
			local severity = math.min(trueIntensity * (elapsedSeconds / cycleTime), trueIntensity)
			local newVal = PWL + (severity * (1 - PWL))
			weather = newVal
			rep.GlobalWeather.Severity.Value = severity
		end
	elseif switchMode == "Clear_Stormfront" then
		local startTime, elapsedSeconds, cycleTime = tick(), 0, 10
		if currentWeather == "Stormfront" then
			cycleTime = 10 - (10 * rep.GlobalWeather.Severity.Value)
		else
			currentWeather = "Stormfront"
			rep.GlobalWeather.Weather.Value = "Stormfront"
		end
		while elapsedSeconds < cycleTime do
			wait()
			elapsedSeconds = tick() - startTime
			local severity = math.min(elapsedSeconds / cycleTime, 1)
			local newVal = PWL + ((BWL - PWL) * severity)
			weather = newVal
			rep.GlobalWeather.Severity.Value = severity
		end
	elseif switchMode == "Inclement_Stormfront" then
		local startTime, elapsedSeconds, cycleTime = tick(), 0, rep.GlobalWeather.Severity.Value * 10
		local sSev, sWeather = rep.GlobalWeather.Severity.Value, weather
		while elapsedSeconds < cycleTime do
			wait()
			elapsedSeconds = tick() - startTime
			local severity = math.max(sSev - (sSev * (elapsedSeconds / cycleTime)), 0)
			local newVal = sWeather - ((sWeather - BWL) * (elapsedSeconds / cycleTime))
			weather = newVal
			rep.GlobalWeather.Severity.Value = severity
		end
		currentWeather = "Stormfront"
		rep.GlobalWeather.Weather.Value = "Stormfront"
		rep.GlobalWeather.Severity.Value = 1
	elseif switchMode == "Stormfront_Clear" then
		local startTime, elapsedSeconds, cycleTime = tick(), 0, 10
		local sVal = weather
		if rep.GlobalWeather.Severity.Value ~= 1 then
			cycleTime = rep.GlobalWeather.Severity.Value * 10
		end
		while elapsedSeconds < cycleTime do
			wait()
			elapsedSeconds = tick() - startTime
			local severity = math.min(elapsedSeconds / cycleTime, 1)
			local newVal = BWL - ((BWL - PWL) * severity)
			weather = newVal
			rep.GlobalWeather.Severity.Value = 1 - severity
		end
		currentWeather = "Clear"
		rep.GlobalWeather.Weather.Value = "Clear"
		rep.GlobalWeather.Severity.Value = 1
	elseif switchMode == "Sandstorm_Clear" then
		local startTime, elapsedSeconds, cycleTime = tick(), 0, rep.GlobalWeather.Severity.Value * 10
		local sSev, sWeather = rep.GlobalWeather.Severity.Value, weather
		while elapsedSeconds < cycleTime do
			wait()
			elapsedSeconds = tick() - startTime
			local severity = math.max(sSev - (sSev * (elapsedSeconds / cycleTime)), 0)
			local newVal = sWeather - ((sWeather - PWL) * (elapsedSeconds / cycleTime))
			weather = newVal
			rep.GlobalWeather.Severity.Value = severity
		end
		if wMode ~= "clear" then
			currentWeather = "Stormfront"
			rep.GlobalWeather.Weather.Value = "Stormfront"
			rep.GlobalWeather.Severity.Value = 0
		else
			currentWeather = "Clear"
			rep.GlobalWeather.Weather.Value = "Clear"
			rep.GlobalWeather.Severity.Value = 1
		end
	end
end

function SetupTeleporter(touch)
	local target = work:FindFirstChild(touch.Target.Value)
	if target then
		teleporterIndex[touch.Target.Value] = {target.CFrame.p, Vector2.new(target.Size.X / 2, target.Size.Z / 2)}
	end
	touch.Touched:Connect(function(part)
		local isCharacter = part.Parent:findFirstChild("Humanoid")
		if isCharacter then
			local plr = game.Players:FindFirstChild(part.Parent.Name)
			if plr then
				if not teleportingIndex[plr.Name] and plrStatus[plr.Name] ~= "Teleporting" then
					local teleportAllowed = true
					if touch.Target.Value == "Last location" and not 
						rep.CharacterBios:FindFirstChild(plr.Name):FindFirstChild("Last_location") then
						teleportAllowed = false
					end	
					if teleportAllowed then
						teleportingIndex[plr.Name] = touch.Target.Value		
						rep.Teleport:InvokeClient(plr, touch.Target.Value)
					end
				end
			end
		end
	end)
end

function rep.Teleport.OnServerInvoke(plr, mode, setting)
	if mode == "Teleporting" then
		local char = plr.Character
		if char then
			while not char.PrimaryPart do
				wait()
				if not game.Players:FindFirstChild(plr.Name) then
					return
				end
			end
			local location = teleportingIndex[plr.Name]
			if location then
				if typeof(location) == "string" then
					if teleporterIndex[location] then
						local x, z = teleporterIndex[location][2].x, teleporterIndex[location][2].y
						char:SetPrimaryPartCFrame(CFrame.new(teleporterIndex[location][1]) + Vector3.new(math.random(-x,x), 3, math.random(-z,z)))
						plrStatus[plr.Name] = "Playing"
						--REMOVE PROP TELEPORTERS AND ADD SHELTERED REGIONS
					elseif location == "Last location" then
						local lastLocation = rep.CharacterBios:FindFirstChild(plr.Name).Last_location
						char:SetPrimaryPartCFrame(CFrame.new(lastLocation.Value))
						lastLocation:Destroy()
						plrStatus[plr.Name] = "Playing"
					end
				elseif typeof(location) == "Instance" and location.PrimaryPart then
					char:SetPrimaryPartCFrame(teleportingIndex[plr.Name].PrimaryPart.CFrame + Vector3.new(0, 2, 0))
					--FIX FALSE CHARACTER FOR NON-HUMANOIDS
					char.FalseCharacter.Value:Destroy()
					char.FalseCharacter:Destroy()
					plrStatus[plr.Name] = "Playing"
					char.HumanoidRootPart.Anchored = false
					char.Humanoid.WalkSpeed = 8
				elseif typeof(location) == "table" and location.Type == "FriendTeleport" then
					-- Friend teleport - simple position change with offset
					local offset = Vector3.new(3, 0, 0)
					char:SetPrimaryPartCFrame(location.Position + offset)
					plrStatus[plr.Name] = "Playing"
					print("[Friend Teleport] " .. plr.Name .. " arrived at friend's location")
				elseif typeof(location) == "CFrame" then
					char.Archivable = true
					local falseChar = char:Clone()
					char.Archivable = false
					falseChar:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
					falseChar:FindFirstChild(rep.CharacterBios:FindFirstChild(plr.Name).RPName.Value).Name = plr.Name..": customizing..."
					for _,v in pairs(falseChar:GetChildren()) do
						if v:IsA("MeshPart") and v.Name ~= "CollisionPart" then
							v.Anchored = true
							v.CanCollide = false
							v.Transparency = 0.5
						end
					end
					falseChar.Name = plr.Name.."_PlaceHolder"
					falseChar.Parent = work
					local obval = Instance.new("ObjectValue")
					obval.Name = "FalseCharacter"
					obval.Value = falseChar
					obval.Parent = char
					char:SetPrimaryPartCFrame(location)
					char.HumanoidRootPart.Anchored = true
					char.Humanoid.WalkSpeed = 0
					plrStatus[plr.Name] = "Customizing"
				end
				teleportingIndex[plr.Name] = nil
			end
		end
	elseif string.find(mode, "Transitioning") then
		plrStatus[plr.Name] = "Teleporting"
		local category = string.sub(mode, 15, string.len(mode))
		if category == "Friend" and setting then
			-- Friend teleportation - parse the position from the setting string
			-- Format: "PlayerName|CFrame"
			local separatorPos = string.find(setting, "|")
			if separatorPos then
				local friendName = string.sub(setting, 1, separatorPos - 1)
				local cframeString = string.sub(setting, separatorPos + 1)

				-- Parse the CFrame string (format: "x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22")
				local success, friendPosition = pcall(function()
					-- Remove any parentheses or extra whitespace
					cframeString = string.gsub(cframeString, "[%(%)]", "")
					local components = {}
					for num in string.gmatch(cframeString, "[%-%d%.]+") do
						table.insert(components, tonumber(num))
					end
					if #components >= 12 then
						return CFrame.new(
							components[1], components[2], components[3],
							components[4], components[5], components[6],
							components[7], components[8], components[9],
							components[10], components[11], components[12]
						)
					elseif #components >= 3 then
						return CFrame.new(components[1], components[2], components[3])
					end
					error("Invalid CFrame format")
				end)

				if success and friendPosition then
					-- Store as a table to distinguish from customizing mode CFrame
					teleportingIndex[plr.Name] = {
						Type = "FriendTeleport",
						Position = friendPosition
					}
					print("[Friend Teleport] " .. plr.Name .. " teleporting to " .. friendName .. "'s captured location")
				else
					print("[Friend Teleport] ERROR: Could not parse CFrame from setting")
					teleportingIndex[plr.Name] = nil
				end
			else
				print("[Friend Teleport] ERROR: Invalid setting format (missing separator)")
				teleportingIndex[plr.Name] = nil
			end
		elseif category ~= "Map" then
			teleportingIndex[plr.Name] = setting
		else
			local char = plr.Character
			if char and char:FindFirstChild("FalseCharacter") then
				teleportingIndex[plr.Name] = char.FalseCharacter.Value
			end
		end
	elseif mode == "Cancel" then
		teleportingIndex[plr.Name] = nil
	end
end

