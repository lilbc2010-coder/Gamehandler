function LaunchThrowable(startCF, power, angle, mode, target)
	local throwable = serv.Throwables:FindFirstChild(mode):Clone()
	throwable:SetPrimaryPartCFrame(startCF)
	WeldToolParts(throwable)
	throwable.PrimaryPart.Velocity = (CFrame.new(startCF.p * Vector3.new(1, 0, 1), target * Vector3.new(1, 0, 1)) * 
		CFrame.Angles(math.rad(angle), 0, 0)).LookVector * power
	throwable.PrimaryPart.RotVelocity = Vector3.new(math.random(), math.random(), math.random())
	throwable.Parent = work
	wait(4)
	throwable.PrimaryPart.Anchored = true
	throwable.PrimaryPart.Transparency = 1
	for _,v in pairs(throwable:GetChildren()) do
		if v ~= throwable.PrimaryPart then
			v:Destroy()
		end
	end
	if mode == "Frag" then
		CoroutineLauncher("PlaySound", throwable.PrimaryPart, "ToolSounds", "ThrowableFragNear1", 0, {95, 105})
		CoroutineLauncher("PlaySound", throwable.PrimaryPart, "ToolSounds", "ThrowableFragFar1", 0, {95, 105})
		throwable.PrimaryPart.Blast:Emit(35)
		throwable.PrimaryPart.Dust:Emit(20)
