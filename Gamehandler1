function GeigerCounter(handle)
	local t = tick()
	while handle.Parent do
		local distance, closestPoint = 100000, nil
		for _,point in pairs(radiationPoints) do
			local mag = (point.CFrame.p - handle.CFrame.p).magnitude
			if mag < distance then
				closestPoint = point
				distance = mag
			end
		end
		if closestPoint then
			handle.Counter.Pitch = 0.5 + math.max((1 - (distance / closestPoint.Range.Value)) * closestPoint.Intensity.Value, 0)
		end
		while (tick() - t) < 0.4 do
			wait()
		end
		wait()
	end
end

