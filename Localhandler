function EquipTool(button, previouslyHeldTool)
	local baseName, variantName = button.Parent.Base.Value, button.Text
	if plrState == "Customizing" or (humanStates["prone"] and FindToolSetting("Setting_proneNull", baseName, variantName)) or 
		(humanStates["crouch"] and FindToolSetting("Setting_crouchNull", baseName, variantName)) then
		return
	end
	local state = "stand"
	if humanStates["climb"] then
		state = "climb"
	elseif humanStates["crouch"] then
		state = "crouch"
	elseif humanStates["prone"] then
		state = "prone"
		if humanStates["moving"] then
			return
		end
	end
	local anim = toolAnims[FindToolSetting("Anim_"..state.."ToggleEquip", baseName, variantName)]
	if not anim then
		return
	end
	if humanStates["prone"] and not previouslyHeldTool then
		ChangeSpeed("ProneToggling")
	end
	button.Parent.BackgroundColor3 = Color3.fromRGB(156, 61, 37)
	button.BackgroundColor3 = Color3.fromRGB(255, 100, 61)
	local baseLocation = rep.Tools:FindFirstChild(baseName)
	local toolExtraFunctions = baseLocation:FindFirstChild(variantName):FindFirstChild("Functions")
	local zFunction, tFunction, yFunction
	if FindToolSetting("Setting_reloadMethod", baseName, variantName) == "None" then
		button.Parent.ChamberState.Value = "Loaded"
	end
	if humanStates["animated"] then
		StopAnimatedState()
	end
	equippedTool["Base"] = baseName
	equippedTool["Variant"] = button.Text
	equippedTool["Slot"] = button.Parent.Name
	equippedTool["Toggle"] = "Equipping"
	equippedTool["Config"] = button.Text
	if toolExtraFunctions then
		zFunction, tFunction, yFunction = toolExtraFunctions:FindFirstChild("zFunction"), toolExtraFunctions:FindFirstChild("tFunction"), 
		toolExtraFunctions:FindFirstChild("yFunction")
		local virtualToolName
		if zFunction and baseLocation:FindFirstChild("Virtual:"..zFunction.Value) then
			virtualToolName = "Virtual:"..zFunction.Value
		elseif tFunction and baseLocation:FindFirstChild("Virtual:"..tFunction.Value) then
			virtualToolName = "Virtual:"..tFunction.Value
		elseif yFunction and baseLocation:FindFirstChild("Virtual:"..yFunction.Value) then
			virtualToolName = "Virtual:"..yFunction.Value
		end
		if virtualToolName and FindToolSetting("Setting_reloadMethod", baseName, virtualToolName) == "None" then
			button.Parent.ChamberState_underMount.Value = "Loaded"
		end
	end
	if mobileFrame.Visible then
		if string.find(equippedTool["Slot"], "Utility") then
			mobileFrame.RelaxButton.Visible = false
			mobileFrame.ChamberButton.Visible = false
			mobileFrame.ReloadButton.Visible = false
			mobileFrame.zFunctionButton.Visible = false
			mobileFrame.tFunctionButton.Visible = false
			mobileFrame.yFunctionButton.Visible = false
		elseif not string.find(baseName, "Melee") then
			mobileFrame.RelaxButton.Visible = true
			mobileFrame.ChamberButton.Visible = true
			mobileFrame.ReloadButton.Visible = true
			if string.find(FindToolSetting("Setting_chambering"), "Automatic") then
				mobileFrame.UseToolButton.Visible = true
			end
			if toolExtraFunctions then
				if zFunction then
					mobileFrame.zFunctionButton.Button.Text = functionEffectNames[zFunction.Value]
					mobileFrame.zFunctionButton.Visible = true
				end
				if tFunction then
					mobileFrame.tFunctionButton.Button.Text = functionEffectNames[tFunction.Value]
					mobileFrame.tFunctionButton.Visible = true
				end
				if yFunction then
					mobileFrame.yFunctionButton.Button.Text = functionEffectNames[yFunction.Value]
					mobileFrame.yFunctionButton.Visible = true
				end
			end
		end
	end
	local model = char:FindFirstChild(variantName)
	if baseName == "Lights" and model and model:IsA("Model") and model.Light.Light.Enabled then
		button.Parent.SelectedItem.Value = true
	end
	anim:Play(0.2, 1, 1)
	local animConnection, stopConnection
	animConnection = anim.KeyframeReached:Connect(function(keyframe)
		if keyframe == "Grab" then
			wait(0.1)
			anim:AdjustSpeed(0)
			rep.EquipTool:InvokeServer("Equip", equippedTool["Base"], equippedTool["Config"])
			anim:AdjustSpeed(1)
		elseif keyframe == "Equipped" then
			local startIdle = "stand"
			local playSpeed = 1
			equippedTool["Toggle"] = "Equipped"
			equippedTool["Aiming"] = true
			if humanStates["crouch"] then
				startIdle = "crouch"
			elseif humanStates["prone"] then
				startIdle = "prone"
			end
			local idleAnim = toolAnims[FindToolSetting("Anim_"..startIdle)]
			if not humanStates["climb"] then
				idleAnim:Play(0, 1, 1)
			end
			local startMovement
			if humanStates["climb"] then
				startMovement = "climb"
				if humanStates["moving"] then
					if mKs["LeftShift"] then
						playSpeed = 1.8
					end
					if humanStates["climbDirection"] == "Down" then
						playSpeed = -playSpeed
					end
				else
					playSpeed = 0
				end
			elseif humanStates["run"] and humanStates["moving"] then
				startMovement = "run"
			elseif humanStates["stand"] and humanStates["moving"] then
				startMovement = "walk"
			elseif humanStates["moving"] then
				startMovement = startIdle.."Move"
			end
			if startMovement then
				startMovement = p..startMovement
				if humanStates["prone"] then
					ChangeSpeed("Prone")
				end
				idleAnim:AdjustWeight(0.001)
				local movementAnimName = FindToolSetting("Anim_"..startMovement)
				if movementAnimName then
					local movementAnim = toolAnims[movementAnimName]
					movementAnim:Play(0, 1, playSpeed)
					movementAnim.TimePosition = anims[startMovement].TimePosition
				end
			end
			keyFunctions = {}
			local extraFunctions = CheckForFunctions(button.Parent.Base.Value, variantName)
			if extraFunctions then
				for _,v in pairs(extraFunctions:GetChildren()) do
					keyFunctions[v.Name] = {Effect = v.Value, Setting = 1}
				end
			end
			if model then
				if model.Name == "Prop Placer" then
					propFrame.Visible = true
					txtFrame.Visible = false
				elseif model.Name == "Vehicle Placer" then
					vehicleFrame.Visible = true
					txtFrame.Visible = false
				elseif model.Name == "Hunter's Clipboard" then
					GUI.ClipboardFrame.Visible = true
					txtFrame.Visible = false
				elseif baseName == "Throwables" then
					GUI.ThrowableFrame.Visible = true
					txtFrame.Visible = false
				end
			end
			local model = char:FindFirstChild(equippedTool["Variant"])
			model.Parent = weaponFolder
			ignoreList[#ignoreList + 1] = model
			if FindToolSetting("Setting_isDualWielded") then
				model = char:FindFirstChild(equippedTool["Variant"].."_OffHand")
				model.Parent = weaponFolder
				ignoreList[#ignoreList + 1] = model
			end
			animConnection:Disconnect()
		end
		stopConnection = anim.Stopped:Connect(function()
			animConnection:Disconnect()
			stopConnection:Disconnect()
			if humanStates["prone"] then
				ChangeSpeed("Prone")
				if CheckMovementKeys() then
					anims["proneMove"]:Play(0.2, 1, 1)
					toolAnims[FindToolSetting("Anim_proneMove")]:Play(0.2, 1, 1)
					humanStates["moving"] = true
				end
			end
		end)
	end)
end

function CheckForFunctions(baseName, variantName)
	local base = rep.Tools:FindFirstChild(baseName)
	local variant = base:FindFirstChild(variantName)
	if variant:FindFirstChild("Functions") then
		return variant.Functions
	elseif base:FindFirstChild("Functions") then
		return base.Functions
	else
		return false
	end
end

function FindToolSetting(itemName, baseName, variantName)
	if not baseName then
		baseName = equippedTool["Base"]
	end
	if not variantName then
		variantName = equippedTool["Variant"]
	end
	local toolHome = rep.Tools:FindFirstChild(baseName)
	local toolItem = toolHome:FindFirstChild(variantName):FindFirstChild(itemName)
	if not toolItem then
		toolItem = toolHome:FindFirstChild(itemName)
		if toolItem then
			toolItem = toolItem.Value
		else
			toolItem = false
		end
	else
		toolItem = toolItem.Value
	end
	return toolItem
end

function StopAnimatedState()
	anims[humanStates["animated"]]:Stop(0.2)
	for _,v in pairs(animFrame.ScrollFrame:FindFirstChild(humanState.."Frame"):GetChildren()) do
		if v.Button.Text == humanStates["animated"] then
			v.BackgroundColor3 = Color3.fromRGB(46, 89, 163)
			v.Button.BackgroundColor3 = Color3.fromRGB(73, 137, 255)
			break
		end
	end
	humanStates["animated"] = false
	anims[p.."stand"]:Play(0, 1, 1)
end

function Animate(input)
	if humanStates["resting"] or plrState == "Customizing" then
		return
	end
	if input == "LeftShift" then
		local startMovement, stopIdle, stopMovement 
		local startIdle, animPlaySpeed, newState = "stand", 1, "Run"
		local soundPlaySpeed = 1
		if mKs["LeftShift"] then
			if not humanStates["climb"] and not humanStates["fall"] then
				if humanStates["crouch"] then
					stopIdle, stopMovement = "crouch", "crouchMove"
				elseif humanStates["prone"] then
					stopIdle, stopMovement = "prone", "proneMove"
				elseif humanStates["swim"] then
					startIdle = nil
					if humanStates["moving"] then
						startMovement = "swimMove"
					end
				else
					stopMovement = "walk"
				end
				if humanStates["moving"] and not humanStates["swim"] then
					startMovement = "run"
					soundPlaySpeed = 1.4
				end
			else
				animPlaySpeed = 0
				if humanStates["moving"] and not humanStates["fall"]  then
					animPlaySpeed = 1.8
				end
			end
		else
			if not humanStates["climb"] and not humanStates["fall"] then
				stopMovement, newState = "run", "Walk"
				if humanStates["swim"] then
					stopMovement, startIdle = "swimMove", nil
				elseif humanStates["moving"] then
					startMovement = "walk"
				end
			else
				stopMovement, animPlaySpeed, newState = "run", 0, "Walk"
				if humanStates["moving"] or humanStates["fall"] then
					animPlaySpeed = 1
				end
			end
		end
		local startSuffix, stopSuffix, idleSuffix = "", "", ""
		local toolEquipped = equippedTool["Toggle"] == "Equipped"
		if toolEquipped and not equippedTool["Aiming"] then
			idleSuffix = "Relax"
			if startMovement ~= "run" then
				startSuffix = "Relax"
			end
			if stopMovement ~= "run" then
				stopSuffix = "Relax"
			end
		end
		if startIdle and humanStates["stand"] then
			startIdle = nil
		end
		if not humanStates["climb"] and not humanStates["fall"] then
			if startIdle then
				if not humanStates[startIdle] then
					humanStates[startIdle] = true
					anims[p..startIdle]:Play(0.2, 1, 1)
				end
				if toolEquipped then
					toolAnims[FindToolSetting("Anim_"..startIdle..idleSuffix)]:Play(0.2, 1, 1)
				end
			end
			if stopMovement then
				anims[p..stopMovement]:Stop(0.2)
				if toolEquipped then
					toolAnims[FindToolSetting("Anim_"..stopMovement..stopSuffix)]:Stop(0.2)
				end
			end
			if stopIdle then
				humanStates[stopIdle] = false
				anims[p..stopIdle]:Stop(0.2)
				if toolEquipped then
					toolAnims[FindToolSetting("Anim_"..stopIdle..idleSuffix)]:Stop(0.2)
					if equippedTool["Reloading"] ~= "None" and equippedTool["Reloading"] ~= "Chambering" then
						CoroutineLauncher("ReloadSequence", toolboxFrame:FindFirstChild(equippedTool["Slot"]), stopIdle)
					end
				end
			end
			if startMovement then
				anims[p..startMovement]:Play(0.2, 1, animPlaySpeed)
				if toolEquipped and not humanStates["swim"] then
					toolAnims[FindToolSetting("Anim_"..startMovement..startSuffix)]:Play(0.2, 1, animPlaySpeed)
				end
				if startMovement ~= "swimMove" then
					rep.CharacterSound:FireServer(p, floorMaterialSounds[currentFloorMaterial], soundPlaySpeed, true)
				elseif humanStates["animated"] and not 
					script.Animations:FindFirstChild(humanStates["animated"]).UsableWhenMoving.Value then
					StopAnimatedState()
				end
			end
			if stopMovement == "run" then
				humanStates["run"] = false
			elseif startMovement == "run" then
				humanStates["run"] = true
			end
		else
			if humanStates["animated"] then
				StopAnimatedState()
			end
			if humanStates["climb"] then
				if not anims[p.."climb"] then
					print("Failed to load anim: "..p.."climb")
				end
				if anims[p.."climb"].Speed < 0 then
					animPlaySpeed = -animPlaySpeed
				end
				anims[p.."climb"]:AdjustSpeed(animPlaySpeed)
			end
		end
		ChangeSpeed(newState)
	else
		local beginMoving = CheckMovementKeys()
		local anim = "walk"
		local idleAnim = "stand"
		local soundPlaySpeed = 1
		if mKs["LeftShift"] then
			anim = "run"
			soundPlaySpeed = 1.4
			if humanStates["swim"] then
				anim = "swimMove"
			end
		elseif humanStates["crouch"] then
			anim = "crouchMove"
			idleAnim = "crouch"
			soundPlaySpeed = 0.9
		elseif humanStates["prone"] then
			anim = "proneMove"
			idleAnim = "prone"
			soundPlaySpeed = 0.7
		elseif humanStates["swim"] or humanStates["climb"] then
			anim = nil
		end
		local idleSuffix, moveSuffix = "", ""
		if equippedTool["Toggle"] == "Equipped" and not equippedTool["Aiming"] then
			if (not mKs["LeftShift"] and humanStates["stand"]) or humanStates["crouch"] then
				idleSuffix, moveSuffix = "Relax", "Relax"
			elseif humanStates["prone"] or not beginMoving then
				idleSuffix = "Relax"
			end
		end
		if not humanStates["moving"] and beginMoving then
			if anim == "proneMove" and equippedTool["Variant"] ~= "None" and equippedTool["Recovering"] then
				return
			end
			humanStates["moving"] = true
			if humanStates["animated"] and not 
				script.Animations:FindFirstChild(humanStates["animated"]).UsableWhenMoving.Value then
				StopAnimatedState()
			end
			if not humanStates["fall"] and anim then
				anims[p..anim]:Play(0.2, 1, 1)
				if anim == "run" and not humanStates["run"] then
					humanStates["run"] = true
					if equippedTool["Toggle"] == "Equipped" then
						local endEffect = FindToolSetting("Setting_endEffect")
						if endEffect and toolboxFrame:FindFirstChild(equippedTool["Slot"]).SelectedItem.Value then
							CoroutineLauncher("ToolEffect", string.sub(endEffect, 8, string.len(endEffect)))
						end
					end
				end
				rep.CharacterSound:FireServer(p, floorMaterialSounds[currentFloorMaterial], soundPlaySpeed, true)
				if equippedTool["Toggle"] == "Equipped" then
					toolAnims[FindToolSetting("Anim_"..anim..moveSuffix)]:Play(0.2, 1, 1)
				end
				if humanStates["prone"] and not equippedTool["Aiming"] then
					toolAnims[FindToolSetting("Anim_proneRelax")]:Stop(0.2)
				end
			end
		elseif humanStates["moving"] and not beginMoving then
			humanStates["moving"] = false
			if anim then
				if not humanStates["climb"] then
					anims[p..anim]:Stop(0.2)
					if humanStates["run"] then
						humanStates["run"] = false
					end
				else
					anims[p..anim]:AdjustSpeed(0)
				end
				rep.CharacterSound:FireServer(p, floorMaterialSounds[currentFloorMaterial], 0, false)
				if equippedTool["Toggle"] == "Equipped" then
					toolAnims[FindToolSetting("Anim_"..anim..moveSuffix)]:Stop(0.2)
					idleAnim = toolAnims[FindToolSetting("Anim_"..idleAnim..idleSuffix)]
					if idleAnim.IsPlaying and idleAnim.WeightCurrent ~= 1 then
						idleAnim:AdjustWeight(1)
					elseif not humanStates["fall"] then
						idleAnim:Play(0.2, 1, 1)
					end
				end
				if not humanStates["fall"] and humanStates["prone"] and not equippedTool["Aiming"] then
					toolAnims[FindToolSetting("Anim_proneRelax")]:Play(0.2, 1, 1)
				end
			end
		end
	end
end

function CheckMovementKeys()
	local beginMoving = false
	if (mKs["W"] or mKs["S"]) and (mKs["W"] ~= mKs["S"]) then
		beginMoving = true
	end
	if not beginMoving and (mKs["A"] or mKs["D"]) and (mKs["A"] ~= mKs["D"]) then
		beginMoving = true
	end
	if not beginMoving and (mKs["Up"] or mKs["Down"]) and (mKs["Up"] ~= mKs["Down"]) then
		beginMoving = true
	end
	if humanSpeed > 0.2 then
		beginMoving = true
	end
	return beginMoving
end

function ChangeState(state)
	if equippedTool["Reloading"] ~= "None" then
		return
	end
	local oldAnim, newAnim, oldMovementAnim, newMovementAnim, newState, soundPlaySpeed
	if state == "Crouch" then
		if humanStates["crouch"] then
			oldAnim, newAnim, oldMovementAnim, newMovementAnim, newState = "crouch", "stand", "crouchMove", "walk", "Walk"
		elseif humanStates["prone"] then
			oldAnim, newAnim, oldMovementAnim, newMovementAnim, newState = "prone", "crouch", "proneMove", "crouchMove", "Crouch"
		else
			oldAnim, newAnim, oldMovementAnim, newMovementAnim, newState = "stand", "crouch", "walk", "crouchMove", "Crouch"
		end
	else
		if humanStates["crouch"] then
			oldAnim, newAnim, oldMovementAnim, newMovementAnim, newState = "crouch", "prone", "crouchMove", "proneMove", "Prone"
		elseif humanStates["prone"] then
			oldAnim, newAnim, oldMovementAnim, newMovementAnim, newState = "prone", "stand", "proneMove", "walk", "Walk"
		else
			oldAnim, newAnim, oldMovementAnim, newMovementAnim, newState = "stand", "prone", "walk", "proneMove", "Prone"
		end
	end
	local oldSuffix, newSuffix, oldMovementSuffix, newMovementSuffix = "", "", "", ""
	if equippedTool["Toggle"] == "Equipped" and not equippedTool["Aiming"] then
		if newAnim == "prone" then
			oldSuffix, newSuffix, oldMovementSuffix = "Relax", "Relax", "Relax"
		elseif humanStates["prone"] then
			oldSuffix, newSuffix, newMovementSuffix = "Relax", "Relax", "Relax"
		else
			oldSuffix, newSuffix, oldMovementSuffix, newMovementSuffix = "Relax", "Relax", "Relax", "Relax"
		end
	end
	ChangeSpeed(newState)
	if newState == "Walk" then
		soundPlaySpeed = 1
	elseif newState == "Crouch" then
		soundPlaySpeed = 0.9
	elseif newState == "Prone" then
		soundPlaySpeed = 0.7
		if humanStates["animated"] then
			StopAnimatedState()
		end
	end
	humanStates[oldAnim] = false
	humanStates[newAnim] = true
	anims[p..oldAnim]:Stop(0.2)
	anims[p..newAnim]:Play(0.2, 1, 1)
	if humanStates["moving"] then
		anims[p..oldMovementAnim]:Stop(0.2)
		anims[p..newMovementAnim]:Play(0.2, 1, 1)
		rep.CharacterSound:FireServer(p, floorMaterialSounds[currentFloorMaterial], soundPlaySpeed, true)
		if equippedTool["Toggle"] == "Equipped" then
			toolAnims[FindToolSetting("Anim_"..newMovementAnim..newMovementSuffix)]:Play(0.2, 1, 1)
			toolAnims[FindToolSetting("Anim_"..oldMovementAnim..oldMovementSuffix)]:Stop(0.2)
		end
	end
	if equippedTool["Toggle"] == "Equipped" then
		toolAnims[FindToolSetting("Anim_"..oldAnim..oldSuffix)]:Stop(0.2)
		local idleAnim = toolAnims[FindToolSetting("Anim_"..newAnim..newSuffix)]
		idleAnim:Play(0.2, 1, 1)
		if humanStates["moving"] then
			toolAnims[FindToolSetting("Anim_"..oldMovementAnim..oldSuffix)]:Stop(0.2)
			toolAnims[FindToolSetting("Anim_"..newMovementAnim..newSuffix)]:Play(0.2, 1, 1)
			idleAnim:AdjustWeight(0.001)
		end
		local isContinuous = FindToolSetting("Setting_isContinuous")
		local isAnimated = FindToolSetting("Setting_isAnimated")
		if string.find(equippedTool["Slot"], "Utility") and toolboxFrame:FindFirstChild(equippedTool["Slot"]).SelectedItem.Value 
			and isContinuous and isAnimated then
			toolAnims[FindToolSetting("Anim_"..oldAnim.."Activate")]:Stop(0.2)
			utilityAnimConnection:Disconnect()
			utilityAnim = toolAnims[FindToolSetting("Anim_"..newAnim.."Activate")]
			utilityAnim:Play(0.2, 1, 1)
			MakeUtilityAnimConnection()
		end
	end
end

