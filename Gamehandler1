						w.C1 = w.C1 * CFrame.Angles(math.rad(rotation), 0, 0)
						tool = char:FindFirstChild(variantName.."_OffHand")
						w = tool.Handle.Weld_Hammer
						w.C1 = w.C1 * CFrame.Angles(math.rad(rotation), 0, 0)
					end
				end
			elseif string.find(interaction, "Barrel") then
				local rotation, pitchRange = -45, {105, 115}
