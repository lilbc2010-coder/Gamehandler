local reloadSequences = 0
function ReloadSequence(toolButton)
	reloadSequences = reloadSequences + 1
	if reloadSequences == 1 and humanStates["prone"] then
		ChangeSpeed("ProneToggling")
	end
	while reloadSequences > 1 do
		wait()
	end
	local sequence = {Main = ""}
	local startTime = 0
	local transitionTime = 0.2
	if FindToolSetting("Setting_reloadMethod") ~= "Individual" then
		sequence = {Main = ""}
	else
		sequence = {Prepare = "Prepare", Main = "", Recover = "Recover"}
	end
	local state = "stand"
	local reloadMethod = FindToolSetting("Setting_reloadMethod")
	local chambering = FindToolSetting("Setting_chambering")
	if humanStates["prone"] then
		state = "prone"
	elseif humanStates["crouch"] then
		state = "crouch"
	end
	local breakSequence = false
	local lastReloadAnim
	for tag,suffix in pairs(sequence) do
		equippedTool["Reloading"] = tag
		local animName = FindToolSetting("Anim_"..state.."Reload"..suffix)
		local reloadAnim = toolAnims[animName]
		local keyframeConnection
		keyframeConnection = reloadAnim.KeyframeReached:Connect(function(keyframe)
			local isOffHand, magSuffix = false, ""
			if string.find(keyframe, "OffHand") then
				isOffHand, magSuffix = true, "_OffHand"
			end
			if keyframe == "Load" then
				if reloadMethod == "Individual" then
					rep.ToolSound:FireServer(equippedTool["Base"], equippedTool["Variant"], "Sound_reload", false)
					local mag = toolButton:FindFirstChild("MagCount"..magSuffix)
					mag.Value = mag.Value + 1
				elseif string.find(reloadMethod, "Magazine") or string.find(reloadMethod, "SingleRound") or reloadMethod == "Bulk" then
					if string.find(reloadMethod, "SingleRound") then
						if chambering == "Hammer" then
							toolButton.ChamberState.Value = "Empty"
						else
							toolButton.ChamberState.Value = "Loaded"
						end
					elseif string.find(reloadMethod, "Magazine") then
						local extraSettings = {}
						if FindToolSetting("Setting_shotType") == "Throwable" then
							local tFunction = keyFunctions["tFunction"]
							extraSettings = {Power = GUI.ThrowableFrame.PowerFrame.Val.Value, 
								Angle = GUI.ThrowableFrame.AngleFrame.Val.Value, 
								Mode = functionEffects[tFunction["Effect"]][tFunction["Setting"]], Target = mouse.Hit.p}
						end
						rep.ToolInteraction:FireServer("Load", equippedTool["Base"], equippedTool["Variant"], nil, isOffHand, extraSettings)
						if reloadMethod == "MagazineBeltFeed" then
							toolButton.ChamberState.Value = "Loaded"
						end
					elseif reloadMethod == "Bulk" and string.find(chambering, "Semiauto") then
						toolButton.ChamberState.Value = "Loaded"
					end
					rep.ToolSound:FireServer(equippedTool["Base"], equippedTool["Variant"], "Sound_reload", false)
					toolButton.MagCount.Value = toolButton.MagSize.Value
					if isOffHand then
						toolButton.MagCount_OffHand.Value = toolButton.MagSize.Value
						toolButton.MagSize_OffHand.Value = toolButton.MagSize.Value
					end
				end
			elseif keyframe == "Empty" then
				rep.ToolInteraction:FireServer("Empty", equippedTool["Base"], equippedTool["Variant"], nil, isOffHand)
			elseif string.find(keyframe, "Sound_") then
				local soundName = string.sub(keyframe, 7, string.len(keyframe))
				rep.ToolSound:FireServer(equippedTool["Base"], equippedTool["Variant"], soundName, true)
			elseif string.find(keyframe, "Interaction_") then
				local interactionName = string.sub(keyframe, 13, string.len(keyframe))
				rep.ToolInteraction:FireServer(interactionName, equippedTool["Base"], equippedTool["Variant"])
			elseif actionKeyframes[keyframe] or (isOffHand and actionKeyframes[string.sub(keyframe, 1, string.len(keyframe) - 8)]) then
				rep.ToolInteraction:FireServer(keyframe, equippedTool["Base"], equippedTool["Variant"], 
					toolButton.ChamberState.Value, isOffHand)
			elseif string.find(keyframe, "Weld_") then
				local weldName = string.sub(keyframe, 6, string.len(keyframe))
				reloadAnim:AdjustSpeed(0)
				local handleName = "HandleWeld"
				if string.find(weldName, "OffHand") then
					weldName = string.sub(weldName, 1, string.len(weldName) - 7)
					handleName = "OffHandleWeld"
				end
				local currentWeld
				for _,v in pairs(char:GetChildren()) do
					local w = v:FindFirstChild(handleName)
					if v:IsA("MeshPart") and w then
						currentWeld = w
						break
					end
				end
				local weldPart = char:FindFirstChild(weldName)
				local newC0 = weaponFolder:FindFirstChild(equippedTool["Variant"]).PrimaryPart.CFrame:toObjectSpace(weldPart.CFrame):inverse()
				rep.Weld:InvokeServer(weldPart, equippedTool["Variant"], handleName, currentWeld, newC0)
				reloadAnim:AdjustSpeed(1)
			end
		end)
		reloadAnim:Play(transitionTime, 1, 1)
		reloadAnim.TimePosition = startTime
		if lastReloadAnim then
			lastReloadAnim:Stop()
		end
		lastReloadAnim = reloadAnim
		local timeLeft = reloadAnim.Length - startTime
		startTime = 0
		transitionTime = 0
		if reloadAnim.Looped and reloadMethod == "Individual" then
			local magCount, magSize = toolButton.MagCount.Value, toolButton.MagSize.Value
			timeLeft = reloadAnim.Length * (magSize - magCount)
		end
		local waitBegin
		while timeLeft > 0.05 do
			waitBegin = tick()
			wait(0.1)
			timeLeft = math.max(timeLeft - (tick() - waitBegin), 0.05)
			if reloadSequences > 1 then
				breakSequence = true
				break
			end
		end
		if timeLeft == 0.05 then
			reloadAnim:AdjustSpeed(0)
		end
		keyframeConnection:Disconnect()
		if FindToolSetting("Setting_isDualWielded") then
			toolButton.MagCount_OffHand.Value = toolButton.MagSize.Value
			toolButton.MagSize_OffHand.Value = toolButton.MagSize.Value
		end
		if breakSequence then
			break
		end
	end
	lastReloadAnim:Stop()
	if not breakSequence then
		equippedTool["Reloading"] = "None"
	end
	if humanStates["prone"] then
		ChangeSpeed("Prone")
		if CheckMovementKeys() then
			anims[p.."proneMove"]:Play(0.2, 1, 1)
			toolAnims[FindToolSetting("Anim_proneMove")]:Play(0.2, 1, 1)
			humanStates["moving"] = true
		end
	end
	reloadSequences = reloadSequences - 1
end

function CoroutineLauncher(mode, input1, input2, input3)
	if mode == "ParticleDropImpact" then
		local test=coroutine.create(function() 
			local e,m=pcall(ParticleDropImpact, input1) 
			if not e then print('ERROR 1: ',m) end 
		end) 
		coroutine.resume(test) 
	elseif mode == "NotifierDelay" then
		local test=coroutine.create(function() 
			local e,m=pcall(NotifierDelay, input1, input2) 
			if not e then print('ERROR 3: ',m) end 
		end) 
		coroutine.resume(test) 
	elseif mode == "MouseCooldown" then
		local test=coroutine.create(function() 
			local e,m=pcall(MouseCooldown) 
			if not e then print('ERROR 4: ',m) end 
		end) 
		coroutine.resume(test)
	elseif mode == "MetavisionUpdater" then
		local test=coroutine.create(function() 
			local e,m=pcall(MetavisionUpdater) 
			if not e then print('ERROR 5: ',m) end 
		end) 
		coroutine.resume(test) 
	elseif mode == "ReloadSequence" then
		local test=coroutine.create(function() 
			local e,m=pcall(ReloadSequence, input1, input2) 
			if not e then print('ERROR 6: ',m) end
		end) 
		coroutine.resume(test) 
	elseif mode == "ProjectileImpact" then
		local test=coroutine.create(function() 
			local e,m=pcall(ProjectileImpact, input1) 
			if not e then print('ERROR 7: ',m) end 
		end) 
		coroutine.resume(test)
	elseif mode == "ToolEffect" then
		local test=coroutine.create(function() 
			local e,m=pcall(ToolEffect, input1, input2) 
			if not e then print('ERROR 2: ',m) end 
		end) 
		coroutine.resume(test)
	end
end

function ProjectileImpact(impact)
	wait(math.max(impact.ImpactSound.TimeLength, impact.Impact.Lifetime.Max))
	impact:Destroy()
end

function ToolEffect(effect, boundKey)
	if equippedTool["Reloading"] ~= "None" or equippedTool["Recovering"] or 
		(equippedTool["Base"] == "Throwables" and toolboxFrame:FindFirstChild(equippedTool["Slot"]).MagCount.Value == 0) then
		return
	end
	local effectPrefix
	if functionEffects[effect] then
		local effectIndex = keyFunctions[boundKey]["Setting"]
		if effectIndex + 1 > #functionEffects[effect] then
			effectIndex = 1
		else
			effectIndex = effectIndex + 1
		end
		effectPrefix = effect
		effect = functionEffects[effect][effectIndex]
		keyFunctions[boundKey]["Setting"] = effectIndex
	else
		_,_,effectPrefix, effect = string.find(effect, "(%w+):(%w+)")
	end
	if effectPrefix == "Binoculars" or effectPrefix == "Scope" then
		local guiItem = GUI.ToolEffectFrame.Binoculars
		if effectPrefix == "Scope" then
			guiItem = GUI.ToolEffectFrame.Scope
		end
		script.GUISounds.BinocularToggle:Play()
		if effect == "Up" then
			cam.CameraType = Enum.CameraType.Track
			cam.FieldOfView = 10
			guiItem.Visible = true
			plr.CameraMaxZoomDistance = 0.01
			weaponFolder:FindFirstChild(equippedTool["Config"]).Parent = char
		else
			cam.CameraType = Enum.CameraType.Custom
			cam.FieldOfView = 70
			guiItem.Visible = false
			plr.CameraMaxZoomDistance = 75
			char:FindFirstChild(equippedTool["Config"]).Parent = weaponFolder
		end
	elseif effectPrefix == "ThermalBinoculars" then
		script.GUISounds.BinocularToggle:Play()
		if effect == "Up" then
			local cc = GUI.ToolEffectFrame.ThermalEffect:Clone()
			cc.Parent = light
			cam.CameraType = Enum.CameraType.Track
			cam.FieldOfView = 10
			GUI.ToolEffectFrame.Binoculars.Visible = true
			plr.CameraMaxZoomDistance = 0.01
			for _,v in pairs(game.Players:GetChildren()) do
				if v ~= plr and v.Character then
					NeonCharacter(v.Character, "On")
				end
			end
			weaponFolder:FindFirstChild(equippedTool["Config"]).Parent = char
		else
			for _,v in pairs(game.Players:GetChildren()) do
				if v ~= plr and v.Character then
					NeonCharacter(v.Character, "Off")
				end
			end
			light.ThermalEffect:Destroy()
			cam.CameraType = Enum.CameraType.Custom
			cam.FieldOfView = 70
			GUI.ToolEffectFrame.Binoculars.Visible = false
			plr.CameraMaxZoomDistance = 75
			char:FindFirstChild(equippedTool["Config"]).Parent = weaponFolder
		end
	elseif effectPrefix == "Multinade1" then
		rep.ToolInteraction:FireServer("Multinade_"..effect, equippedTool["Base"], equippedTool["Variant"])
	elseif effectPrefix == "Smoke_Launcher" or effectPrefix == "Shockbreach" then
		if effect == "Enabled" then
			equippedTool = {Base = equippedTool["Base"], Variant = "Virtual:"..effectPrefix, Slot = equippedTool["Slot"], 
				Config = equippedTool["Config"], Aiming = equippedTool["Aiming"], Toggle = "Equipped", 
				Reloading = "None", Recovering = false}
			local slot = toolboxFrame:FindFirstChild(equippedTool["Slot"])
			slot.ChamberState.Name = "ChamberState_"..equippedTool["Config"]
			slot.ChamberState_underMount.Name = "ChamberState"
			slot.MagSize.Name = "MagSize_"..equippedTool["Config"]
			slot.MagSize_underMount.Name = "MagSize"
			slot.MagCount.Name = "MagCount_"..equippedTool["Config"]
			slot.MagCount_underMount.Name = "MagCount"
			local virtualTool = rep.Tools:FindFirstChild(equippedTool["Base"]):FindFirstChild(equippedTool["Variant"])
			if virtualTool.Setting_magSize.Value > 0 and slot.MagSize.Value == 0 then
				slot.MagSize.Value = virtualTool.Setting_magSize.Value
			end
		else
			ReconfigureUndermount()
		end
	elseif effectPrefix == "Light_Laser" then
		if effect == "Light" then
			rep.ToolInteraction:FireServer("Light On", equippedTool["Base"], equippedTool["Variant"])
		elseif effect == "Laser" then
			rep.ToolInteraction:FireServer("Laser On", equippedTool["Base"], equippedTool["Variant"])
		else
			rep.ToolInteraction:FireServer("Light Off", equippedTool["Base"], equippedTool["Variant"])
		end
	elseif effectPrefix == "Laser" then
		if effect == "Laser" then
			rep.ToolInteraction:FireServer("Laser On", equippedTool["Base"], equippedTool["Variant"])
		else
			rep.ToolInteraction:FireServer("Light Off", equippedTool["Base"], equippedTool["Variant"])
		end
	elseif effectPrefix == "Light" then
		if effect == "Light" then
			rep.ToolInteraction:FireServer("Light On", equippedTool["Base"], equippedTool["Variant"])
		else
			rep.ToolInteraction:FireServer("Light Off", equippedTool["Base"], equippedTool["Variant"])
		end
	elseif effectPrefix == "Bipod" then
		if effect == "Down" then
			rep.ToolInteraction:FireServer("Bipod Down", equippedTool["Base"], equippedTool["Variant"])
		else
			rep.ToolInteraction:FireServer("Bipod Up", equippedTool["Base"], equippedTool["Variant"])
		end
	end
end

function NeonCharacter(foreignChar, mode)
	if mode == "On" then
		for _,n in pairs(foreignChar:GetChildren()) do
			if n:IsA("MeshPart") then
				n.Material = mat.Neon
				local originalColor = Instance.new("Color3Value")
				originalColor.Name = "OriginalColor"
				originalColor.Value = n.Color
				originalColor.Parent = n
				n.BrickColor = BrickColor.new("White")
			elseif n:IsA("Shirt") or n:IsA("Pants") then
				n.Parent = foreignChar.Humanoid
			end
		end
		if foreignChar:FindFirstChild("HumanState") and foreignChar.HumanState.Value ~= "Humanoid" then
			for _,n in pairs(foreignChar:GetChildren()) do
				if n:IsA("Folder") then
					for _,m in pairs(n:GetChildren()) do
						if m:IsA("MeshPart") then
							local originalColor = Instance.new("Color3Value")
							local originalMat = Instance.new("StringValue")
							originalColor.Name = "OriginalColor"
							originalMat.Name = "OriginalMat"
							originalColor.Value = m.Color
							local matStr = tostring(m.Material)
							originalMat.Value = string.sub(matStr, 15, string.len(matStr))
							originalColor.Parent = m
							originalMat.Parent = m
							m.BrickColor = BrickColor.new("White")
							m.Material = mat.Neon
						end
					end
				end
			end
		end
	else
		for _,n in pairs(foreignChar:GetChildren()) do
			if n:IsA("MeshPart") and n:FindFirstChild("OriginalColor") then
				n.Color = n.OriginalColor.Value
				n.OriginalColor:Destroy()
				n.Material = mat.SmoothPlastic
			end
		end
		for _,n in pairs(foreignChar.Humanoid:GetChildren()) do
			if n:IsA("Shirt") or n:IsA("Pants") then
				n.Parent = foreignChar
			end
		end
		if foreignChar.HumanState.Value ~= "Humanoid" then
			for _,n in pairs(foreignChar:GetChildren()) do
				if n:IsA("Folder") then
					for _,m in pairs(n:GetChildren()) do
						if m:IsA("MeshPart") and m:FindFirstChild("OriginalColor") then
							m.Color = m.OriginalColor.Value
							m.OriginalColor:Destroy()
							m.Material = mat[m.OriginalMat.Value]
							m.OriginalMat:Destroy()
						end
					end
				end
			end
		end
	end
end

function ReconfigureUndermount()
	equippedTool = {Base = equippedTool["Base"], Variant = equippedTool["Config"], Slot = equippedTool["Slot"], 
		Config = equippedTool["Config"], Aiming = equippedTool["Aiming"], Toggle = "Equipped", 
		Reloading = "None", Recovering = false}
	local slot = toolboxFrame:FindFirstChild(equippedTool["Slot"])
	slot.ChamberState.Name = "ChamberState_underMount"
	slot:FindFirstChild("ChamberState_"..equippedTool["Variant"]).Name = "ChamberState"
	slot.MagSize.Name = "MagSize_underMount"
	slot:FindFirstChild("MagSize_"..equippedTool["Variant"]).Name = "MagSize"
	slot.MagCount.Name = "MagCount_underMount"
	slot:FindFirstChild("MagCount_"..equippedTool["Variant"]).Name = "MagCount"
end

