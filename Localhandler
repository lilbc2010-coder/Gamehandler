function MouseInsideFrame(x0, x1, y0, y1)
	if mouse.X >= x0 and mouse.X < x1 and mouse.Y >= y0 and mouse.Y < y1 then
		return true
	end
	return false
end

function TpFrameButtons()
	for _,n in pairs({tpFrame.Confirm.Button, tpFrame.Confirm, tpFrame.Deny.Button, tpFrame.Deny}) do
		n.MouseEnter:Connect(function()
			local cn, bt = n.Parent, n
			if n.Name ~= "Button" then
				cn, bt = n, n.Button
			end
			while cn.Moving.Value do wait() end
			if MouseInsideFrame(bt.AbsolutePosition.X, bt.AbsolutePosition.X + bt.AbsoluteSize.X, 
				bt.AbsolutePosition.Y, bt.AbsolutePosition.Y + bt.AbsoluteSize.Y) and leftMouseDown then
				bt:TweenPosition(UDim2.new(0, 0, 0, 0), "Out", "Sine", 0.1)
				cn.Moving.Value = true
				wait(0.1)
				cn.Moving.Value = false
			end
		end)
		n.MouseButton1Down:Connect(function()
			local cn, bt = n.Parent, n
			if n.Name ~= "Button" then
				cn, bt = n, n.Button
			end
			while cn.Moving.Value do wait() end
			if MouseInsideFrame(bt.AbsolutePosition.X, bt.AbsolutePosition.X + bt.AbsoluteSize.X, 
				bt.AbsolutePosition.Y, bt.AbsolutePosition.Y + bt.AbsoluteSize.Y) then 
				bt:TweenPosition(UDim2.new(0, 0, 0, 0), "Out", "Sine", 0.1)
				cn.Moving.Value = true
				wait(0.1)
				cn.Moving.Value = false
			end
		end)
		n.MouseButton1Up:Connect(function()
			local cn, bt = n.Parent, n
			if n.Name ~= "Button" then
				cn, bt = n, n.Button
			end
			if plrState == "Dead" then return end
			while cn.Moving.Value do wait() end
			if (notifier.Text == "LOADING" and notifier.Visible) or not MouseInsideFrame(bt.AbsolutePosition.X, 
				n.AbsolutePosition.X + bt.AbsoluteSize.X, bt.AbsolutePosition.Y, bt.Parent.AbsolutePosition.Y + 
					n.Parent.AbsoluteSize.Y) then 
				return 
			end
			local moveTime = 0.1
			script.GUISounds.Click:Play()
			bt:TweenPosition(UDim2.new(0, 0, cn.Origin.Value, 0), "Out", "Sine", 0.1)
			cn.Moving.Value = true
			if not tpFrame.Ready.Value then return end
			if tsFrame.TransitionPhase.Value == "None" and cn.Name == "Confirm" then
				tsFrame.BackgroundTransparency = 1
				tsFrame.Visible = true
				tsFrame.TransitionPhase.Value = "In"
				rep.Teleport:InvokeServer("Transitioning_Map")
			else
				rep.Teleport:InvokeServer("Cancel")
			end
			tpFrame.Ready.Value = false
			tpFrame:TweenPosition(UDim2.new(0.7, 0, 1.7, 0), "Out", "Sine", 0)
			wait(0.1)
			cn.Moving.Value = false
		end)
		n.MouseLeave:Connect(function()
			local cn, bt = n.Parent, n
			if n.Name ~= "Button" then
				cn, bt = n, n.Button
			end
			while cn.Moving.Value do wait() end
			bt:TweenPosition(UDim2.new(0, 0, cn.Origin.Value, 0), "Out", "Sine", 0.1)
			cn.Moving.Value = true
			wait(0.1)
			cn.Moving.Value = false
		end)
	end
end

