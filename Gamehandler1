function ClearProps(plrName)
	local regionsCleared = false
	for _,v in pairs(gameData[plrName]["Server"]["PropsPlaced"]) do
		if v:FindFirstChild("TeleporterReference") or v:FindFirstChild("ShelteredRegionReference") then
			for _,n in pairs(v:GetChildren()) do
				if n.Name == "TeleporterReference" then
					local tp = n.Value
					if teleporterIndex[tp.Target.Value] then
						teleporterIndex[tp.Target.Value] = nil
					end
					work:FindFirstChild(tp.Target.Value):Destroy()
					tp:Destroy()
				elseif n.Name == "ShelteredRegionReference" then
					n.Value:Destroy()
					regionsCleared = true
				end
			end
		end
		v:Destroy()
	end
	if seatConnections[plrName] then
		seatConnections[plrName][2]:Disconnect()
		seatConnections[plrName] = nil
	end
	if regionsCleared then
		rep.UpdateShelteredRegions:FireAllClients()
	end
	gameData[plrName]["Server"]["PropsPlaced"] = {}
end

