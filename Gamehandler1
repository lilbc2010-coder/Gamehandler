					gateModel.Turn3Goals:SetPrimaryPartCFrame(gateModel.Turn3Goals.PrimaryPart.CFrame * 
						CFrame.Angles(math.rad(rot * gateModel.Turn3.RotDirection.Value), 0, 0))
					gateModel.Turn4Goals:SetPrimaryPartCFrame(gateModel.Turn4Goals.PrimaryPart.CFrame * 
