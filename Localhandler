function ChamberAction()
	if equippedTool["Toggle"] == "Equipped" and equippedTool["Reloading"] == "None" and 
		not (humanStates["run"] or humanStates["climb"] or humanStates["fall"] or humanStates["swim"] or not 
			equippedTool["Aiming"] or equippedTool["Recovering"]) and FindToolSetting("Anim_standSlide") then
		local toolBase = rep.Tools:FindFirstChild(equippedTool["Base"])
		local toolButton = toolboxFrame:FindFirstChild(equippedTool["Slot"])
		if FindToolSetting("Setting_chambering") == "Hammer" and (toolButton.MagCount.Value == 0 or 
			toolButton.ChamberState.Value == "Loaded") or not FindToolSetting("Sound_chambering") 
			or string.find(FindToolSetting("Setting_chambering"), "None") or 
			FindToolSetting("Setting_chambering") == "AutomaticNoChamber" then
			return
		end
		if toolBase then
			equippedTool["Reloading"] = "Chambering"
			local state = "stand"
			if humanStates["prone"] then
				state = "prone"
			elseif humanStates["crouch"] then
				state = "crouch"
			end
			rep.ToolSound:FireServer(equippedTool["Base"], equippedTool["Variant"], "Sound_chambering", false)
			local anim = toolAnims[FindToolSetting("Anim_"..state.."Slide")]
			anim:Play(0.2, 1, 1)
			local stopConnection, keyframeConnection
			keyframeConnection = anim.KeyframeReached:Connect(function(keyframe)
				local isOffHand = string.find(keyframe, "OffHand")
				if keyframe ~= "Keyframe" then
					--if actionKeyframes[keyframe] or (isOffHand and actionKeyframes[string.sub(keyframe, 1, string.len(keyframe) - 8)])
					--or string.find(keyframe, "Weld_") then
					if not string.find(keyframe, "Weld_") then
						rep.ToolInteraction:FireServer(keyframe, equippedTool["Base"], equippedTool["Variant"], 
							toolButton.ChamberState.Value, isOffHand)
					else
						local weldName = string.sub(keyframe, 6, string.len(keyframe))
						anim:AdjustSpeed(0)
						local handleName = "HandleWeld"
						if string.find(weldName, "OffHand") then
							weldName = string.sub(weldName, 1, string.len(weldName) - 7)
							handleName = "OffHandleWeld"
						end
						local currentWeld
						for _,v in pairs(char:GetChildren()) do
							local w = v:FindFirstChild(handleName)
							if v:IsA("MeshPart") and w then
								currentWeld = w
								break
							end
						end
						local weldPart = char:FindFirstChild(weldName)
						local wep = weaponFolder:FindFirstChild(equippedTool["Variant"])
						if not wep then
							wep = char:FindFirstChild(equippedTool["Variant"])
						end
						local newC0 = wep.PrimaryPart.CFrame:toObjectSpace(weldPart.CFrame):inverse()
						rep.Weld:InvokeServer(weldPart, equippedTool["Variant"], handleName, currentWeld, newC0)
						anim:AdjustSpeed(1)
					end
					if isOffHand and string.find(keyframe, "Out") then
						rep.ToolSound:FireServer(equippedTool["Base"], equippedTool["Variant"], "Sound_chambering", false)
					end
				end
			end)
			stopConnection = anim.Stopped:Connect(function()
				stopConnection:Disconnect()
				keyframeConnection:Disconnect()
				if toolButton.MagCount.Value > 0 then
					local isDualWielded = FindToolSetting("Setting_isDualWielded")
					toolButton.MagCount.Value = toolButton.MagCount.Value - 1
					toolButton.ChamberState.Value = "Loaded"
					if isDualWielded then
						toolButton.MagCount_OffHand.Value = toolButton.MagCount_OffHand.Value - 1
						toolButton.ChamberState_OffHand.Value = "Loaded"
					end
				elseif toolButton.ChamberState.Value ~= "Empty" then
					toolButton.ChamberState.Value = "Empty"
				end
				equippedTool["Reloading"] = "None"
			end)
		end
	end
end

function ReloadAction()
	if equippedTool["Toggle"] == "Equipped" and equippedTool["Reloading"] == "None" and 
		not (humanStates["climb"] or humanStates["fall"] or humanStates["swim"] or not equippedTool["Aiming"]
			or equippedTool["Recovering"]) and FindToolSetting("Setting_reloadMethod") ~= "None" and 
		not string.find(equippedTool["Slot"], "Utility") then
		local toolButton = toolboxFrame:FindFirstChild(equippedTool["Slot"])
		if (toolButton.MagSize.Value ~= 0 and toolButton.MagCount.Value == toolButton.MagSize.Value) or
			(toolButton.ChamberState.Value == "Loaded" and (FindToolSetting("Setting_chambering") == "Hammer" or
				FindToolSetting("Setting_reloadMethod") == "SingleRoundTension")) then
			return
		end
		CoroutineLauncher("ReloadSequence", toolButton)
	end
end

function RelaxAction()
	if equippedTool["Toggle"] == "Equipped" and equippedTool["Reloading"] == "None" and 
		not (humanStates["climb"] or humanStates["fall"] or humanStates["swim"] or equippedTool["Recovering"] or 
			string.find(equippedTool["Slot"], "Utility")) and FindToolSetting("Anim_standRelax") then
		if mobileFrame.Visible then
			local sprintButton = mobileFrame.RelaxButton
			if not equippedTool["Aiming"] then
				sprintButton.Button.BackgroundColor3 = Color3.fromRGB(89, 255, 122)
				sprintButton.BackgroundColor3 = Color3.fromRGB(62, 179, 84)
			else
				sprintButton.Button.BackgroundColor3 = Color3.new(1, 1, 1)
				sprintButton.BackgroundColor3 = Color3.fromRGB(175, 175, 175)
			end
		end
		local idleAnim = "stand"
		local movementAnim
		if humanStates["prone"] then
			idleAnim = "prone"
		elseif humanStates["crouch"] then
			idleAnim = "crouch"
		end
		if humanStates["moving"] then
			if idleAnim == "stand" then
				if not humanStates["run"] then
					movementAnim = "walk"
				end
			elseif idleAnim == "crouch" then
				movementAnim = "crouchMove"
			end
		end
		if equippedTool["Aiming"] then
			if not (humanStates["prone"] and humanStates["moving"]) then
				toolAnims[FindToolSetting("Anim_"..idleAnim)]:Stop(0.2)
				if not humanStates["run"] then
					toolAnims[FindToolSetting("Anim_"..idleAnim.."Relax")]:Play(0.2, 1, 1)
				end
				if movementAnim then
					local newMovement = toolAnims[FindToolSetting("Anim_"..movementAnim.."Relax")]
					local oldMovement = toolAnims[FindToolSetting("Anim_"..movementAnim)]
					newMovement:Play(0.2, 1, 1)
					newMovement.TimePosition = oldMovement.TimePosition
					if humanStates["moving"] then
						oldMovement:Stop(0.2)
					end
				end
			end
			equippedTool["Aiming"] = false
		else
			if not (humanStates["prone"] and humanStates["moving"]) then
				toolAnims[FindToolSetting("Anim_"..idleAnim.."Relax")]:Stop(0.2)
				if not humanStates["run"] then
					toolAnims[FindToolSetting("Anim_"..idleAnim)]:Play(0.2, 1, 1)
				end
				if movementAnim then
					local oldMovement = toolAnims[FindToolSetting("Anim_"..movementAnim.."Relax")]
					local timePos = oldMovement.TimePosition
					oldMovement:Stop(0.2)
					if humanStates["moving"] then
						local newAnim = toolAnims[FindToolSetting("Anim_"..movementAnim)]
						newAnim:Play(0.2, 1, 1)
						newAnim.TimePosition = timePos
					end
				end
			end
			equippedTool["Aiming"] = true
		end
	end
end

function ChangePropMode(input)
	if input == "Tuning" then
		if dragProp["Mode"] then
			if dragProp["Mode"] == "Drag" then
				dragProp["Mode"] = "Tune"
				propFrame.TuningFrame.Visible = true
				propFrame.MobilePropFrame.MovementButton.Button.Text = "Tuning Mode"
				dragProp["Location"] = dragProp["Prop"].PrimaryPart.CFrame
			else
				dragProp["Mode"] = "Drag"
				propFrame.TuningFrame.Visible = false
				propFrame.MobilePropFrame.MovementButton.Button.Text = "Drag Mode"
			end
		end
	else
		if dragProp["RefMode"] then
			if dragProp["RefMode"] == "Local" then
				dragProp["RefMode"] = "Global"
			else
				dragProp["RefMode"] = "Local"
			end
		end
	end
end

function PickUpPropForEditing(placedProp)
	-- Find the prop data in our tracking table
	local propData
	local propDataIndex
	for i, v in pairs(placedPropData) do
		if v["Prop"] == placedProp then
			propData = v
			propDataIndex = i
			break
		end
	end

	-- If prop not in tracking table (e.g., loaded from save), create default data
	if not propData then
		propData = {
			Prop = placedProp,
			RefMode = "Global",
			rX = 0, rY = 0, rZ = 0,
			tX = 0, tY = 0, tZ = 0,
			sRX = 0, sRY = 0, sRZ = 0,
			sTX = 0, sTY = 0, sTZ = 0
		}
		propDataIndex = nil  -- Won't remove from table since it wasn't in there
	end

	-- If we're already editing a prop, restore it first
	if editingPropData and dragProp["Mode"] then
		-- Remove highlight from current editing prop
		if dragProp["Highlight"] then
			dragProp["Highlight"]:Destroy()
			dragProp["Highlight"] = nil
		end
		-- Restore the previously edited prop to its original position
		rep.PropPlace:InvokeServer(work, editingPropData.OriginalCFrame, editingPropData.RefMode,
			editingPropData.rX, editingPropData.rY, editingPropData.rZ,
			editingPropData.tX, editingPropData.tY, editingPropData.tZ,
			editingPropData.sRX, editingPropData.sRY, editingPropData.sRZ,
			editingPropData.sTX, editingPropData.sTY, editingPropData.sTZ,
			editingPropData.PropName)
		-- Destroy the dragged prop
		dragProp["Prop"]:Destroy()
		dragProp["Mode"] = nil
		dragProp["Prop"] = nil
		-- Update count
		local countLabel = propFrame.CountLabel
		countLabel.Count.Value = countLabel.Count.Value + 1
		countLabel.Text = tostring(countLabel.Count.Value) .."/".. tostring(rep.PropLimit.Value)
	end

	-- IMPORTANT: Capture the placed prop's actual world CFrame BEFORE deleting it
	local placedPropCFrame = placedProp.PrimaryPart.CFrame

	-- Store the editing prop data so we can restore it later if needed
	editingPropData = {
		OriginalCFrame = placedPropCFrame,
		RefMode = propData["RefMode"],
		rX = propData["rX"],
		rY = propData["rY"],
		rZ = propData["rZ"],
		tX = propData["tX"],
		tY = propData["tY"],
		tZ = propData["tZ"],
		sRX = propData["sRX"],
		sRY = propData["sRY"],
		sRZ = propData["sRZ"],
		sTX = propData["sTX"],
		sTY = propData["sTY"],
		sTZ = propData["sTZ"],
		PropName = placedProp.Name
	}

	-- Delete the placed prop from the server (but keep it in placedPropData to avoid duplication)
	placedProp.Owner.Value = ""
	rep.PropDelete:FireServer(placedProp)
	script.GUISounds.DeleteSound:Play()

	-- Update the prop count
	local countLabel = propFrame.CountLabel
	countLabel.Count.Value = countLabel.Count.Value - 1
	countLabel.Text = tostring(countLabel.Count.Value) .."/".. tostring(rep.PropLimit.Value)
	countLabel.TextColor3 = Color3.new(0, 0, 0)
	propFrame.Label.TextColor3 = Color3.new(0, 0, 0)

	-- Remove from placed prop data tracking (to prevent duplication)
	-- Only remove if it was in the tracking table
	if propDataIndex then
		table.remove(placedPropData, propDataIndex)
	end

	-- Get the prop template from ReplicatedStorage
	local propTemplate = rep.Props:FindFirstChild(placedProp.Name)
	if not propTemplate then return end

	-- Create a new draggable version - reset transformations to 0
	-- Start in Drag mode so player can move it with cursor
	dragProp = {
		Mode = "Drag",
		RefMode = propData["RefMode"],
		Prop = propTemplate:Clone(),
		Location = CFrame.new(),
		rX = 0,
		rY = 0,
		rZ = 0,
		tX = 0,
		tY = 0,
		tZ = 0
	}

	-- Set up the prop container (same as when initially selecting a prop)
	local container = Instance.new("Model")
	container.Name = dragProp["Prop"].Name
	dragProp["Prop"].Name = "Prop"
	dragProp["Prop"].Parent = container
	dragProp["Prop"] = container
	local falsePrimary = dragProp["Prop"].Prop.PrimaryPart:Clone()
	falsePrimary.Parent = container
	container.PrimaryPart = falsePrimary
	ignoreList[#ignoreList + 1] = dragProp["Prop"]
	ScanProp(dragProp["Prop"])
	dragProp["Prop"].Parent = work

	-- Reset sliders to center position (0 transformations) when editing
	for _, v in pairs({"Rot", "Translate"}) do
		for _, n in pairs({"X", "Y", "Z"}) do
			local slider = propFrame.TuningFrame:FindFirstChild(v.."Frame"..n).Slider
			slider.Position = UDim2.new(0.45, 0, -.25, 0)
			propSlider[string.lower(string.sub(v, 1, 1))..n] = 0
		end
	end

	-- Set Location to the actual placed position (no need to calculate base)
	-- Prop can be freely edited from this position
	dragProp["Location"] = placedPropCFrame

	-- Position the container (and inner prop) at the placed location with orientation preserved
	-- Use container's PrimaryPart (falsePrimary) so the inner Prop model moves with it
	dragProp["Prop"]:SetPrimaryPartCFrame(placedPropCFrame)

	-- Create blue outline highlight for the selected prop (local to this player only)
	local highlight = Instance.new("Highlight")
	highlight.Adornee = dragProp["Prop"]
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(126, 193, 255)
	highlight.Parent = cam  -- Parent to camera to ensure it's local only
	dragProp["Highlight"] = highlight

	-- Don't show tuning frame initially - player is in Drag mode
	propFrame.TuningFrame.Visible = false
	propFrame.MobilePropFrame.MovementButton.Button.Text = "Drag Mode"
end

