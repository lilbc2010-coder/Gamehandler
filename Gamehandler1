function rep.PlaceProp.OnServerInvoke(plr, itemName, cf, mouseTarget)
	if (itemName == "Bunker" or itemName == "Abandoned Bunker") and 
		(not mouseTarget or not (mouseTarget.Material == Enum.Material.Sand and 
		(mouseTarget.BrickColor == BrickColor.new("Oyster") or mouseTarget.BrickColor == BrickColor.new("Light orange")))) then
		return false
	elseif plr.Character.PrimaryPart.CFrame.p.Y < -110 or plr.Character.PrimaryPart.CFrame.p.X > 1900 then
		return false
	end
	if gameData[plr.Name]["Server"]["PropLimit"] > #gameData[plr.Name]["Server"]["PropsPlaced"] then
		local prop = rep.Props:FindFirstChild(itemName)
		if prop:FindFirstChild("Limit") and prop.Limit.Value then
			local propCount = 0
			for _,v in pairs(gameData[plr.Name]["Server"]["PropsPlaced"]) do
				if v.Name == prop.Name then
					propCount = propCount + 1
					if propCount == prop.Limit.Value then
						return false
					end
				end
			end
		end
		local prop = PlaceProp(plr.Name, prop, cf, os.time())
		return prop
	else
		return false
	end
end

function PlaceProp(plrName, prop, cf, creationTime, signDetails)
	prop = prop:Clone()
	prop:SetPrimaryPartCFrame(cf)
	local m = Instance.new("Model")
	prop.Parent = m
	prop.Owner.Value = plrName
	local shelteredRegionInside = false
	if prop:FindFirstChild("ShelteredRegion") then
		shelteredRegionInside = true
	end
	local mode = "Prop"
	if string.find(prop.Name, "Bunker") then
		mode = nil
	end
	Scan(m, mode)
	if prop:FindFirstChild("ScrapSegment") then
		for _,v in pairs(prop:GetChildren()) do
			if v:IsA("BasePart") and v.Material == mat.Metal and v.BrickColor == BrickColor.new("Bright yellow") then
				local setting = scrapSegmentTable[math.random(1, #scrapSegmentTable)]
				v.Material = setting[1]
				v.BrickColor = BrickColor.new(setting[2][math.random(1, #setting[2])])
			end
		end
	end
	if signDetails and string.find(prop.Name, "Sign") then
		for _,v in pairs(prop:GetChildren()) do
			if v:FindFirstChild("SignGui") then
				local sign = v.SignGui.Label
				sign.Text = signDetails[1]
				sign.TextColor3 = Color3.new(signDetails[2][1], signDetails[2][2], signDetails[2][3])
				sign.TextSize = signDetails[3]
				sign.TextStrokeTransparency = signDetails[4]
				sign.TextScaled = signDetails[5]
				sign.Font = Enum.Font[signDetails[6]]
				sign.TextXAlignment = Enum.TextXAlignment[signDetails[7]]
				sign.TextYAlignment = Enum.TextYAlignment[signDetails[8]]
				break
			end
		end
	end
	local timeStamp = Instance.new("NumberValue")
	timeStamp.Name = "TimeStamp"
	timeStamp.Parent = prop
	timeStamp.Value = creationTime
	prop.Parent = work
	if shelteredRegionInside then
		rep.UpdateShelteredRegions:FireAllClients()
	end
	m:Destroy()
	table.insert(gameData[plrName]["Server"]["PropsPlaced"], prop)
	return prop
end

function rep.CheckCode.OnServerInvoke(plr, code)
	if codes[code] then
		local newItemAdded = false
		local newTools, newMorphs = {}, {}
		for i,v in pairs(codes[code]["Tools"]) do
			if not gameData[plr.Name]["Account"]["ToolsOwned"][v] then
				newItemAdded = true
				gameData[plr.Name]["Account"]["ToolsOwned"][v] = "Code_Obtained"
				newTools[i] = {v, serv.Tools:FindFirstChild(i).Value}
			end
		end
		for _,v in pairs(codes[code]["Morphs"]) do
			if not gameData[plr.Name]["Account"]["MorphsOwned"][v] then
				newItemAdded = true
				gameData[plr.Name]["Account"]["MorphsOwned"][v] = "Code_Obtained"
				newMorphs[#newMorphs + 1] = v
			end
		end
		if newItemAdded then
			SaveData(plr.UserId, gameData[plr.Name]["Account"], DataStore)
		end
		return newTools, newMorphs
	else
		return false
	end
