		ACCOUNT = {time played, currency, {tools owned}, {morphs owned}, {vehicles owned}, {prop owned}, 
			{expansions owned}, {prop placer saves}}
		SERVER = {RP name, bio, {equipped tools}, {equipped morph parts}, equipped shirt, equipped pants, {props placed}, 
			bulletTrailActive, propLimit, ATFABRank, itemsLoaded}
]]
function FetchData(plr)
	local t = tick()
	local plrData = DataStore:UpdateAsync(plr.userId, function(old) return old end)
	print("Time taken to load: ", tick()-t," :for ",plr.Name)
	local userId = plr.UserId
	local rank = 0
	if userId > 0 then
		rank = plr:GetRankInGroup(groupId)
	end
	if plrData then	
		--old player found
		gameData[plr.Name] = {Account = plrData, 
			Server = {RPName = "[ No name ]", Bio = "[ No bio ]", Accessories = {}, BodyColor = {}, 
			Equipment = {Head = "None", Torso = "None", RightArm = "None", LeftArm = "None", RightLeg = "None", LeftLeg = "None"}, 
			Shirt = "Custom", Pants = "Custom", PropsPlaced = {}, BulletTrails = false, PropLimit = rep.PropLimit.Value, 
			ATFABRank = rank, LastSave = tick()}, ItemsLoaded = false}
		--UPDATES TO SYSTEM
		-- if u have expansion then you have a higher prop limit
		if not gameData[plr.Name]["Account"]["Currency"] then
			if gameData[plr.Name]["Account"]["ScrapParts"] then
				gameData[plr.Name]["Account"]["Currency"] = gameData[plr.Name]["Account"]["ScrapParts"]
				gameData[plr.Name]["Account"]["ScrapParts"] = nil
			else
				gameData[plr.Name]["Account"]["Currency"] = 0
			end
		end
		if not gameData[plr.Name]["Account"]["PropsOwned"] then
			gameData[plr.Name]["Account"]["PropsOwned"] = {}
		end
		if not gameData[plr.Name]["Account"]["ExpansionsOwned"] then
			gameData[plr.Name]["Account"]["ExpansionsOwned"] = {}
		end
		if gameData[plr.Name]["Account"]["PropsOwned"]["Bunker"] then
			gameData[plr.Name]["Account"]["ExpansionsOwned"]["xmas18SuperMysteryBox"] = true
		end
		if devIds["id"..userId] then
			gameData[plr.Name]["Account"]["ExpansionsOwned"]["xmas18SuperMysteryBox"] = true
			gameData[plr.Name]["Account"]["ExpansionsOwned"]["scrapSettlementExpansion"] = true
			gameData[plr.Name]["Account"]["ExpansionsOwned"]["signCreatorExpansion"] = true
		end
		if gameData[plr.Name]["Account"]["ExpansionsOwned"]["xmas18SuperMysteryBox"] then
			gameData[plr.Name]["Server"]["PropLimit"] = gameData[plr.Name]["Server"]["PropLimit"] + 15
		end
		if gameData[plr.Name]["Account"]["ExpansionsOwned"]["scrapSettlementExpansion"] then
			gameData[plr.Name]["Server"]["PropLimit"] = gameData[plr.Name]["Server"]["PropLimit"] + 30
		end
		if gameData[plr.Name]["Account"]["ExpansionsOwned"]["signCreatorExpansion"] then
			gameData[plr.Name]["Server"]["PropLimit"] = gameData[plr.Name]["Server"]["PropLimit"] + 10
		end
		if gameData[plr.Name]["Account"]["ExpansionsOwned"]["militaryMedicalExpansion"] then
			gameData[plr.Name]["Server"]["PropLimit"] = gameData[plr.Name]["Server"]["PropLimit"] + 30
		end
		if not gameData[plr.Name]["Account"]["LastReset"] then
			gameData[plr.Name]["Account"]["LastReset"] = "never"
		end
		if not gameData[plr.Name]["Account"]["Achievements"] then
			gameData[plr.Name]["Account"]["Achievements"] = {}
		end
	else
		--new player!
		gameData[plr.Name] = {Account = {TimePlayed = 0, Currency = 0, ToolsOwned = {}, MorphsOwned = {}, 
			MountsOwned = {}, PropsOwned = {}, ExpansionsOwned = {}, LastReset = "never", Achievements = {}}, 
			Server = {RPName = "[ No name ]", Bio = "[ No bio ]", Accessories = {}, BodyColor = {}, 
			Equipment = {Head = "None", Torso = "None", RightArm = "None", LeftArm = "None", RightLeg = "None", LeftLeg = "None"}, 
			Shirt = "Custom", Pants = "Custom", PropsPlaced = {}, BulletTrails = false, PropLimit = rep.PropLimit.Value, 
			ATFABRank = rank, LastSave = tick()}, ItemsLoaded = false}
	end
	if not gameData[plr.Name]["Account"]["PropSaves"] then
		gameData[plr.Name]["Account"]["PropSaves"] = {}
		for i = 1, 5 do
			gameData[plr.Name]["Account"]["PropSaves"]["Build"..i] = {Name = "Empty Save", Props = {}}
		end
	elseif not gameData[plr.Name]["Account"]["PropSaves"]["Build4"] then
		gameData[plr.Name]["Account"]["PropSaves"]["Build4"] = {Name = "Empty Save", Props = {}}
		gameData[plr.Name]["Account"]["PropSaves"]["Build5"] = {Name = "Empty Save", Props = {}}
	end
	if not gameData[plr.Name]["Account"]["CharSaves"] then
		gameData[plr.Name]["Account"]["CharSaves"] = {}
		for i = 1, 10 do
			gameData[plr.Name]["Account"]["CharSaves"]["Character"..i] = {Name = "Empty Save"}
		end
	elseif not gameData[plr.Name]["Account"]["CharSaves"]["Character6"] then
		for i = 6, 10 do
			gameData[plr.Name]["Account"]["CharSaves"]["Character"..i] = {Name = "Empty Save"}
		end
	end
	if not gameData[plr.Name]["Server"]["Tools"] then
		gameData[plr.Name]["Server"]["Tools"] = {}
		for _,v in pairs({"Primary", "Secondary", "Utility1", "Utility2", "Utility3"}) do
			gameData[plr.Name]["Server"]["Tools"][v] = {Base = "None", Variant = "None"}
		end
	end
	
	local saveData = false
	if gameData[plr.Name]["Account"]["LastReset"] ~= lastReset then
		gameData[plr.Name]["Account"]["OldTools"] = gameData[plr.Name]["Account"]["ToolsOwned"]
		gameData[plr.Name]["Account"]["OldMorphs"] = gameData[plr.Name]["Account"]["MorphsOwned"]
		for _,v in pairs(serv.Tools:GetChildren()) do
			for _,n in pairs(v:GetChildren()) do
				if n:IsA("Folder") and gameData[plr.Name]["Account"]["ToolsOwned"][n.Name] and n:FindFirstChild("Pass") and 
					(n.Pass.Value ~= "forSale" and n.Pass.Value ~= "easterEggHunt2019" and n.Pass.Value ~= "hiddenOnMap") 
					and gameData[plr.Name]["Account"]["ToolsOwned"][n.Name] ~= "Code_Obtained" then
					gameData[plr.Name]["Account"]["ToolsOwned"][n.Name] = nil
				end
			end
		end
		for i,v in pairs(gameData[plr.Name]["Account"]["MorphsOwned"]) do
			local morph = serv.Morphs:FindFirstChild(i)
			if morph and morph:FindFirstChild("Pass") and (morph.Pass.Value ~= "forSale" and 
				morph.Pass.Value ~= "easterEggHunt2019" and morph.Pass.Value ~= "secretPack" and morph.Pass.Value ~= "hiddenOnMap") 
				and gameData[plr.Name]["Account"]["MorphsOwned"] ~= "Code_Obtained" then
				gameData[plr.Name]["Account"]["MorphsOwned"][i] = nil
			end
		end
		gameData[plr.Name]["Account"]["LastReset"] = lastReset
		saveData = true
	end
	
	if saveData then
		SaveData(plr.UserId, gameData[plr.Name]["Account"], DataStore)
	end
	---------------------------------------
	
	local searchTable = {}
	for _,v in pairs(serv.Tools:GetChildren()) do
		for _,n in pairs(v:GetChildren()) do
			local added = false
			if not gameData[plr.Name]["Account"]["ToolsOwned"][n.Name] and n:IsA("Folder") and 
				(n:FindFirstChild("Pass") or n:FindFirstChild("LevelReq")) then
				searchTable[#searchTable + 1] = {"ToolsOwned", n}
				added = true
			end
		end
	end
	for _,v in pairs(rep.Props:GetChildren()) do
		if not gameData[plr.Name]["Account"]["PropsOwned"][v.Name] and v:FindFirstChild("Pass") then
			searchTable[#searchTable + 1] = {"PropsOwned", v}
		end
	end
	for _,v in pairs(serv.Morphs:GetChildren()) do
		if not gameData[plr.Name]["Account"]["MorphsOwned"][v.Name] and (v:FindFirstChild("Pass") or v:FindFirstChild("LevelReq")) then
			searchTable[#searchTable + 1] = {"MorphsOwned", v}
		end
	end
	for _,v in pairs(serv.Vehicles:GetChildren()) do
		if not gameData[plr.Name]["Account"]["MountsOwned"][v.Name] then
			searchTable[#searchTable + 1] = {"MountsOwned", v}
		end
	end
	for _,v in pairs(searchTable) do
		local ownsItem = true
		if not devIds["id"..userId] and plr.Name ~= "Player1" then
			local pass = v[2]:FindFirstChild("Pass")
			local levelReq = v[2]:FindFirstChild("LevelReq")
			local specialCaseId = pass and specialCaseIds["id"..userId] and specialCaseIds["id"..userId][pass.Value]
			if not specialCaseId then
				if levelReq and math.floor(gameData[plr.Name]["Account"]["TimePlayed"] / 1800) < levelReq.Value then
					ownsItem = false
				end
				if pass and ownsItem then
					local ownershipIds = passIds[pass.Value]
					if ownershipIds then
						if ownershipIds["Badge"] then
							for _,itemId in pairs(ownershipIds["Badge"]) do
								if not BadgeService:UserHasBadgeAsync(userId, itemId) then
									ownsItem = false
									break
								end
							end
						end
						if ownsItem and ownershipIds["GamePass"] then
							for _,itemId in pairs(ownershipIds["GamePass"]) do
								if not MarketService:UserOwnsGamePassAsync(userId, itemId) then
									ownsItem = false
									break
								end
							end
						end
						if ownsItem and not gameData[plr.Name]["Account"]["ExpansionsOwned"][pass.Value] and ownershipIds["Accessory"] then
							for _,itemId in pairs(ownershipIds["Accessory"]) do
								if itemId == 0 or not MarketService:PlayerOwnsAsset(plr, itemId) then
									ownsItem = false
									break
								end
							end
						end
					elseif pass.Value == "ARG" or pass.Value == "hiddenOnMap" or pass.Value == "forSale" then
						ownsItem = false
					elseif pass.Value == "mustOwnVehicle" and #gameData[plr.Name]["Account"]["MountsOwned"] == 0 then
						ownsItem = false
					elseif pass.Value == "staffOnly" and gameData[plr.Name]["Server"]["ATFABRank"] < 200 then
						-- check this out...
						ownsItem = false
					end	
				end
			end
		end
		if ownsItem then
			gameData[plr.Name]["Account"][v[1]][v[2].Name] = true
		end
	end
	CheckForVehicles(plr.Name)
	gameData[plr.Name]["ItemsLoaded"] = true
end

function CheckForVehicles(plrName)
	if not gameData[plrName]["Account"]["ToolsOwned"]["Vehicle Placer"] then
		local ownsVehicles = false
		for _,v in pairs(gameData[plrName]["Account"]["MountsOwned"]) do
			if v then
				ownsVehicles = true
				break
			end
		end
		if ownsVehicles then
			gameData[plrName]["Account"]["ToolsOwned"]["Vehicle Placer"] = true
		end
	end
end

