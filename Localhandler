function SprintAction(inputMethod)
	if inputMethod == "Keyboard" then
		mKs["LeftShift"] = true
		if equippedTool["Variant"] ~= "None" and string.find(equippedTool["Slot"], "Utility") then
			local selectedItem = toolboxFrame:FindFirstChild(equippedTool["Slot"]).SelectedItem
			if FindToolSetting("Setting_isContinuous") and selectedItem.Value then
				local currentState = "stand"
				if humanStates["crouch"] then
					currentState = "crouch"
				elseif humanStates["prone"] then
					currentState = "prone"
				end
				local endEffect = FindToolSetting("Setting_endEffect")
				if endEffect and toolboxFrame:FindFirstChild(equippedTool["Slot"]).SelectedItem.Value then
					CoroutineLauncher("ToolEffect", string.sub(endEffect, 8, string.len(endEffect)))
				end
				selectedItem.Value = false
				utilityAnimConnection:Disconnect()
				toolAnims[FindToolSetting("Anim_"..currentState.."Activate")]:Stop(0.2)
			end
		end
	else
		local sprintButton = mobileFrame.SprintButton
		if sprintButton.Sprinting.Value then
			mKs["LeftShift"] = false
			sprintButton.Sprinting.Value = false
			sprintButton.Button.BackgroundColor3 = Color3.fromRGB(89, 255, 122)
			sprintButton.BackgroundColor3 = Color3.fromRGB(62, 179, 84)
		else
			mKs["LeftShift"] = true
			sprintButton.Sprinting.Value = true
			sprintButton.Button.BackgroundColor3 = Color3.new(1, 1, 1)
			sprintButton.BackgroundColor3 = Color3.fromRGB(175, 175, 175)
		end
	end
	if humanStates["prone"] then
		if plrState == "Customizing" or (equippedTool["Toggle"] == "Equipping" or equippedTool["Toggle"] == "Unequipping" or
			equippedTool["Reloading"] ~= "None") then
			return
		end
	end
	if not humanStates["resting"] then
		if humanStates["prone"] then
			ChangeSpeed("Run")
		end
		Animate("LeftShift")
	end
end

function InteractiveAction()
	local interacted = false
	if mouseTarget.Name == "Click" and not mouseCooldown and not mouseTarget.Parent.Debounce.Value then
		interacted, mouseCooldown = true, true
		local tp = mouseTarget.Parent:FindFirstChild("Type")
		if not humanStates["resting"] and tp then
			if (humanState ~= "Humanoid" and (tp.Value == "Chair" or tp.Value == "Bed")) or
				(equippedTool["Toggle"] == "Equipped" and string.find(equippedTool["Slot"], "Utility") and 
					toolboxFrame:FindFirstChild(equippedTool["Slot"]).SelectedItem.Value) then
				interacted, mouseCooldown = false, false
				return
			end
			rep.MouseInteraction:FireServer(mouseTarget)
			if (tp.Value == "Chair" or tp.Value == "Bed") then
				SitAction(tp.Value)
			end
		end
		CoroutineLauncher("MouseCooldown")
	elseif CheckIfPartIsHumanoid(mouseTarget) then
		interacted = true
		local foreignChar = CheckIfPartIsHumanoid(mouseTarget)
		local foreignCharName
		for _,n in pairs(foreignChar:GetChildren()) do
			if n:FindFirstChild("Humanoid") then
				foreignCharName = n.Name
				break
			end
		end
		local foreignPlr = game.Players:GetPlayerFromCharacter(foreignChar)
		local foreignPlrId = game.Players:GetUserIdFromNameAsync(foreignPlr.Name)
		local foreignCharImage = game.Players:GetUserThumbnailAsync(foreignPlrId, Enum.ThumbnailType.HeadShot, 
			Enum.ThumbnailSize.Size100x100)
		local charBio = rep.CharacterBios:WaitForChild(foreignPlr.Name)
		local toggleMeta, lastMeta = "OFF", "NEVER"
		if charBio.ToggleMeta.Value then
			toggleMeta = "ON"
		end
		if charBio.LastMeta.Value ~= "NEVER" then
			local t, lM = os.time(), charBio.LastMeta.Value
			local s = tostring(math.max((t - (t % 1)) - (lM - (lM % 1)), 0))
			local m = math.floor(s / 60)
			s = s % 60
			lastMeta = m.."m "..s.."s ago"
		end
		plrFrame.CharacterFrame.Image = foreignCharImage
		plrFrame.CharName.Text = foreignCharName.." ("..foreignPlr.Name..")"
		plrFrame.CharBio.Text = charBio.Value
		plrFrame.Level.Text = "Level "..charBio.Level.Value
		plrFrame.LastMeta.Text = "Metavision: "..toggleMeta.." - "..lastMeta
		plrFrame.LastRoll.Text = "Last d20 Roll: ".. tostring(charBio.LastRoll.Value)
		plrFrame.Visible = true
		characterBioName = foreignPlr.Name
		while characterBioName == foreignPlr.Name do
			wait(1)
			if charBio.LastMeta.Value ~= "NEVER" then
				if charBio.ToggleMeta.Value then
					toggleMeta = "ON"
				else
					toggleMeta = "OFF"
				end
				local t, lM = os.time(), charBio.LastMeta.Value
				local s = tostring(math.max((t - (t % 1)) - (lM - (lM % 1)), 0))
				local m = math.floor(s / 60)
				s = s % 60
				lastMeta = m.."m "..s.."s ago"
				plrFrame.LastMeta.Text = "Metavision: "..toggleMeta.." - "..lastMeta
			end
			if charBio.LastRoll.Value ~= 0 then
				plrFrame.LastRoll.Text = "Last d20 Roll: ".. tostring(charBio.LastRoll.Value)
			end
		end
	end
end

local vVar = {Active = false}
function SitAction(tp, seatPart)
	if equippedTool["Base"] ~= "None" and (tp == "Bed" or not string.find(equippedTool["Slot"], "Utility")) then
		QuickUnequip(true)
	end
	for _,anim in pairs(anims) do
		anim:Stop(0.2)
	end
	for i,v in pairs(humanStates) do
		if i == "climbDirection" then
			humanStates[i] = "None"
		else
			humanStates[i] = false
		end
	end
	if tp ~= "Bed" and not humanStates["stand"] then
		for _,anim in pairs(toolAnims) do
			anim:Stop()
		end
		if equippedTool["Toggle"] ~= "Unequipped" then
			toolAnims[FindToolSetting("Anim_stand")]:Play(0, 1, 1)
			if toolboxFrame:FindFirstChild(equippedTool["Slot"]).SelectedItem.Value then
				toolAnims[FindToolSetting("Anim_standActivate")]:Play(0, 1, 1)
			end
		end
	end
	human.AutoRotate = false
	gameFrame.Visible = false
	toolboxFrame.Visible = false
	if tp == "Chair" or tp == "Driving" then
		for _,v in pairs(animFrame.ScrollFrame:GetChildren()) do
			v.Visible = false
		end
		local sitAnim = "Upright"
		if tp == "Driving" then
			sitAnim = "Drive"
			local speed = seatPart.speed
			local defaultSpeed	= speed.Value
			local steeringspeed = seatPart.steeringSpeed.Value
			local steeringangle = seatPart.steeringAngle.Value
			local chassis = seatPart.Parent
			local primaryPart = chassis.PrimaryWeld
			local A	= chassis.A		
			local AA = chassis.AA	
			local B	= chassis.B	
			local BB = chassis.BB
			local steerA = chassis.SteeringA.Servo
			local steerB = chassis.SteeringB.Servo
			vVar["speed"] = speed
			vVar["seat"] = seatPart
			vVar["defaultSpeed"] = defaultSpeed
			vVar["steeringSpeed"] = steeringspeed
			vVar["steeringAngle"] = steeringangle
			vVar["primaryPart"] = primaryPart
			vVar["A"] = A
			vVar["AA"] = AA
			vVar["B"] = B
			vVar["BB"] = BB
			vVar["steerA"] = steerA
			vVar["steerB"] = steerB
			vVar["Active"] = true
		else
			animFrame.ScrollFrame.SittingFrame.Visible = true
		end
		humanStates["resting"] = true
		anims[sitAnim]:Play(0.2, 1, 1)
	elseif tp == "Bed" then
		animFrame.Visible = false
		humanStates["resting"] = true
		anims["sleep"]:Play(0.2, 1, 1)
	end
	rep.CharacterSound:FireServer(p, floorMaterialSounds[currentFloorMaterial], 0, false)
end

function ClickAction()
	local interacted = false
	if mouseState == "Hovering" or (mouseTarget and mouseTarget.Name == "Click") then
		interacted = InteractiveAction()
	elseif mouseState == "OwnedProp" or (mouseTarget and (platform == "Mobile" and mouseTarget.Name == "OwnedProp")) then
		if mouseTarget.Parent.Owner.Value == plr.Name and propFrame.Visible then 
			if propFrame.ModeButton.Button.Mode.Value == "Delete" and mouseTarget.Anchored then
				mouseTarget.Parent.Owner.Value = ""
				rep.PropDelete:FireServer(mouseTarget.Parent)
				script.GUISounds.DeleteSound:Play()
				local countLabel = propFrame.CountLabel
				countLabel.Count.Value = countLabel.Count.Value - 1
				countLabel.Text = tostring(countLabel.Count.Value) .."/".. tostring(rep.PropLimit.Value)
				countLabel.TextColor3 = Color3.new(0, 0, 0)
				countLabel.Parent.Label.TextColor3 = Color3.new(0, 0, 0)
			elseif dragProp["Mode"] == "Orient" and mouseTarget.Anchored then
				local primary = mouseTarget.Parent.PrimaryPart
				local propData
				for _,v in pairs(placedPropData) do
					if v["Prop"] == mouseTarget.Parent then
						propData = v
						break
					end
				end
				dragProp = {Mode = "Orient", RefMode = propData["RefMode"], Prop = dragProp["Prop"], 
					Location = dragProp["Location"], rX = propData["rX"], rY = propData["rY"], rZ = propData["rZ"], 
					tX = propData["tX"], tY = propData["tY"], tZ = propData["tZ"]}
				for _,v in pairs({"Rot", "Translate"}) do
					for _,n in pairs({"X", "Y", "Z"}) do
						local slider = propFrame.TuningFrame:FindFirstChild(v.."Frame"..n).Slider
						local p = propData["s"..string.sub(v, 1, 1)..n]
						local absSize = (slider.Parent.AbsoluteSize.X - slider.AbsoluteSize.X)
						if v == "Rot" then
							p = ((math.deg(p) / 360) + 0.5) * absSize
						else
							p = ((p / 16) + 0.5) * absSize
						end
						slider.Position = UDim2.new(0, p, -.25, 0)
						propSlider[string.lower(string.sub(v, 1, 1))..n] = propData["s"..string.sub(v, 1, 1)..n]
					end
				end
				dragProp["Prop"].Prop:SetPrimaryPartCFrame(dragProp["Location"] * 
					CFrame.new(propSlider["tX"], propSlider["tY"], propSlider["tZ"]) *
					CFrame.Angles(propSlider["rX"], 0, propSlider["rZ"]) * CFrame.Angles(0, propSlider["rY"], 0))
			end
		elseif not propFrame.Visible and mouseTarget.Parent.Owner.Value == plr.Name and mouseTarget:FindFirstChild("SignGui") and 
			not (propFrame.Visible or vehicleFrame.Visible) then
			local sign = mouseTarget.SignGui.Label
			txtFrame.CurrentSign.Value = sign
			txtFrame.Visible = true
			txtFrame.TextBox.Text = sign.Text
			txtFrame.ColorBoxR.Text = math.floor(sign.TextColor3.r * 255)
			txtFrame.ColorBoxG.Text = math.floor(sign.TextColor3.g * 255)
			txtFrame.ColorBoxB.Text = math.floor(sign.TextColor3.b * 255)
			txtFrame.TextSizeBox.Text = sign.TextSize
			txtFrame.TextBox.Font = sign.Font
			txtFrame.TextBox.TextColor3 = sign.TextColor3
			if sign.TextStrokeTransparency == 1 then
				txtFrame.ToggleTextStroke.Button.Text = "Text Stroke Off"
				txtFrame.TextBox.TextStrokeTransparency = 1
			else
				txtFrame.ToggleTextStroke.Button.Text = "Text Stroke On"
				txtFrame.TextBox.TextStrokeTransparency = 0
			end
			if sign.TextScaled then
				txtFrame.ToggleTextScale.Button.Text = "Text Scale On"
				txtFrame.TextBox.TextScaled = true
			else
				txtFrame.ToggleTextScale.Button.Text = "Text Scale Off"
				txtFrame.TextBox.TextScaled = false
			end
		else
			notifierCount = notifierCount + 1
			local timeStamp, currentTime = mouseTarget.Parent.TimeStamp.Value, os.time()
			notifier.Text = "This object belongs to ".. mouseTarget.Parent.Owner.Value ..". Placed "..
				tostring(math.floor((currentTime - timeStamp) / 60)).."m ".. 
				tostring(math.floor((currentTime - timeStamp) % 60)).."s ago"
			notifier.Visible = true
			CoroutineLauncher("NotifierDelay")
		end
	end
	local toolButton = toolboxFrame:FindFirstChild(equippedTool["Slot"])
	if not interacted and equippedTool["Toggle"] == "Equipped" and equippedTool["Aiming"] and not 
		(humanStates["run"] or humanStates["climb"] or humanStates["fall"] or humanStates["swim"]
			or equippedTool["Recovering"]) and equippedTool["Reloading"] == "None" and not 
		(humanStates["prone"] and humanStates["moving"]) then
		local isUtility = string.find(toolButton.Name, "Utility")
		if not isUtility and not (toolButton.ChamberState.Value ~= "Loaded" and toolButton.ChamberState_OffHand.Value ~= "Loaded") then --WEAPON
			equippedTool["Recovering"] = true
			local isOffHand, animSuffix, toolSuffix = false, "", ""
			if toolButton.IsDualWielded.Value then
				if toolButton.CurrentHand.Value == "Hand" then
					toolButton.CurrentHand.Value = "OffHand"
				else
					toolButton.CurrentHand.Value = "Hand"
					isOffHand, animSuffix, toolSuffix = true, "OffHand", "_OffHand"
				end
			end
			local shotType = FindToolSetting("Setting_shotType")
			local firingState = "stand"
			if humanStates["prone"] then
				firingState = "prone"
			elseif humanStates["crouch"] then
				firingState = "crouch"
			end
			local tool = weaponFolder:FindFirstChild(equippedTool["Config"]..toolSuffix)
			if not tool then
				tool = char:FindFirstChild(equippedTool["Config"]..toolSuffix)
			end
			local activationAnim = toolAnims[FindToolSetting("Anim_"..firingState.."Activate"..animSuffix)]
			local activationAnimKeyframeConnection, activationAnimStopConnection
			activationAnimKeyframeConnection = activationAnim.KeyframeReached:Connect(function(keyframe)
				if string.find(keyframe, "Interaction") then
					local extraSettings = {}
					if shotType == "Throwable" and string.find(keyframe, "Toss") then
						local tFunction = keyFunctions["tFunction"]
						extraSettings = {Power = GUI.ThrowableFrame.PowerFrame.Val.Value, 
							Angle = GUI.ThrowableFrame.AngleFrame.Val.Value, 
							Mode = functionEffects[tFunction["Effect"]][tFunction["Setting"]], Target = mouse.Hit.p}
						toolButton.ChamberState.Value = "Spent"
					end
					rep.ToolInteraction:FireServer(keyframe, equippedTool["Base"], 
						equippedTool["Variant"], nil, isOffHand, extraSettings)
				elseif string.find(keyframe, "Sound") then
					rep.ToolSound:FireServer(equippedTool["Base"], equippedTool["Variant"], 
						string.sub(keyframe, 7, string.len(keyframe)), true)
				end
			end)
			if string.find(equippedTool["Variant"], "Pickaxe") then
				rep.ToolInteraction:FireServer("Pickaxe Swing", equippedTool["Base"], equippedTool["Variant"])
			elseif equippedTool["Variant"] == "Chainsaw" then
				rep.ToolInteraction:FireServer("ActivateStart", equippedTool["Base"], equippedTool["Variant"])
			end
			activationAnimStopConnection = activationAnim.Stopped:Connect(function()
				activationAnimStopConnection:Disconnect()
				activationAnimKeyframeConnection:Disconnect()
			end)
			local cooldown = FindToolSetting("Setting_cooldown")
			local chamberSetting = FindToolSetting("Setting_chambering")
			if shotType == "Throwable" then
				activationAnim:Play(0, 1, 1)
			else
				local bulletStart, ray, hitPart, bulletHit, surfaceNormal, startTime, hitPositions
				local isMelee = string.find(equippedTool["Base"], "Melee")
				local tip
				if not isMelee then
					local suffix = ""
					if FindToolSetting("Setting_chambering") == "NoneMultiBarrel" then
						suffix = tostring(1 + (toolButton.MagSize.Value - toolButton.MagCount.Value))
					end
					tip = tool:FindFirstChild("Tip"..suffix)
					if tip then
						bulletStart = tip.CFrame.p
					else
						for _,v in pairs(tool:GetChildren()) do
							tip = v:FindFirstChild("Tip"..suffix)
							if tip then
								bulletStart = tip.CFrame.p
								break
							end
						end
					end
					ray = Ray.new(bulletStart, (mouse.Hit.p - bulletStart).unit * 500)
					hitPart, bulletHit, surfaceNormal = work:FindPartOnRayWithIgnoreList(ray, ignoreList)
					startTime = os.time()
					hitPositions = {Time = startTime, StartPos = bulletStart, HitData = {{Normal = surfaceNormal, HitPos = bulletHit,
						HitPart = hitPart}}}
					if FindToolSetting("Setting_shotType") == "Multi" then
						local offsetRange = (mouse.Hit.p - bulletStart).magnitude * 0.05
						for i = 1, 3 do
							local newHitPos = Vector3.new(math.random(-offsetRange, offsetRange), math.random(-offsetRange, offsetRange), 
								math.random(-offsetRange, offsetRange))
							ray = Ray.new(bulletStart, ((mouse.Hit.p + newHitPos) - bulletStart).unit * 500)
							hitPart, bulletHit, surfaceNormal = work:FindPartOnRayWithIgnoreList(ray, ignoreList)
							hitPositions["HitData"][i + 1] = {Normal = surfaceNormal, HitPos = bulletHit, HitPart = hitPart}
						end
					end
				end
				if chamberSetting then
					if chamberSetting == "Slide" or chamberSetting == "Hammer" or chamberSetting == "None" or chamberSetting == "Battery" then
						rep.ProjectileFire:FireServer(equippedTool["Base"], equippedTool["Variant"], 
							equippedTool["Config"], hitPositions, tip, isOffHand)
						activationAnim:Play(0, 1, 1)
						toolButton:FindFirstChild("ChamberState"..toolSuffix).Value = "Spent"
						if chamberSetting == "Hammer" then
							local hammerNumber = "1"
							if animSuffix ~= "" then
								hammerNumber = "2"
							end
							rep.ToolInteraction:FireServer("Interaction_HammerIn"..hammerNumber, 
								equippedTool["Base"], equippedTool["Variant"], nil, isOffHand)
						elseif FindToolSetting("Setting_reloadMethod") == "SingleRoundTension" then
							rep.ToolInteraction:FireServer("BowLoose", equippedTool["Base"], equippedTool["Variant"], nil, isOffHand)
						end
					elseif string.find(chamberSetting, "Semiauto") or chamberSetting == "NoneMultiBarrel" then
						rep.ProjectileFire:FireServer(equippedTool["Base"], equippedTool["Variant"], 
							equippedTool["Config"], hitPositions, tip, isOffHand)
						activationAnim:Play(0, 1, 1)
						if chamberSetting == "Semiauto" then
							rep.ToolInteraction:FireServer("Slide", equippedTool["Base"], equippedTool["Variant"], nil, isOffHand)
						end
						toolButton.MagCount.Value = toolButton.MagCount.Value - 1
						if toolButton.MagCount.Value == 0 then
							toolButton.ChamberState.Value = "Empty"
							if FindToolSetting("Sound_finalRound") then
								rep.ToolSound:FireServer(equippedTool["Base"], equippedTool["Variant"], "Sound_finalRound", false)
							end
						end
					elseif string.find(chamberSetting, "Automatic") or chamberSetting == "Burst" then
						local burst = 0
						local tool = weaponFolder:FindFirstChild(equippedTool["Variant"])
						if not tool then
							tool = char:FindFirstChild(equippedTool["Variant"])
						end
						while leftMouseDown and toolButton.MagCount.Value > 0 do
							bulletStart = tool.Tip.CFrame.p
							ray = Ray.new(bulletStart, (mouse.Hit.p - bulletStart).unit * 500)
							hitPart, bulletHit, surfaceNormal = work:FindPartOnRayWithIgnoreList(ray, ignoreList)
							startTime = os.time()
							hitPositions = {Time = startTime, StartPos = bulletStart, HitData = {{Normal = surfaceNormal, HitPos = bulletHit,
								HitPart = hitPart}}}
							if FindToolSetting("Setting_shotType") == "Multi" then
								local offsetRange = (mouse.Hit.p - bulletStart).magnitude * 0.05
								for i = 1, 3 do
									local newHitPos = Vector3.new(math.random(-offsetRange, offsetRange), math.random(-offsetRange, offsetRange), 
										math.random(-offsetRange, offsetRange))
									ray = Ray.new(bulletStart, ((mouse.Hit.p + newHitPos) - bulletStart).unit * 500)
									hitPart, bulletHit, surfaceNormal = work:FindPartOnRayWithIgnoreList(ray, ignoreList)
									hitPositions["HitData"][i + 1] = {Normal = surfaceNormal, HitPos = bulletHit, HitPart = hitPart}
								end
							end
							rep.ProjectileFire:FireServer(equippedTool["Base"], equippedTool["Variant"], 
								equippedTool["Config"], hitPositions, tip, isOffHand)
							activationAnim:Play(0, 1, 1)
							local suffix = ""
							if string.find(chamberSetting, "Automatic") and (string.find(chamberSetting, "NoChamber") or 
								string.find(chamberSetting, "NoShell")) then
								suffix = "_"..string.sub(chamberSetting, 10, string.len(chamberSetting))
							end
							rep.ToolInteraction:FireServer("Slide"..suffix, equippedTool["Base"], equippedTool["Variant"], nil, isOffHand)
							toolButton.MagCount.Value = toolButton.MagCount.Value - 1
							if toolButton.MagCount.Value == 0 then
								toolButton.ChamberState.Value = "Empty"
							end
							wait(cooldown)
							if chamberSetting == "Burst" then
								burst = burst + 1
								if burst >= 3 then
									break
								end
							end
						end
					end
				else
					if not isMelee then
						rep.ProjectileFire:FireServer(equippedTool["Base"], equippedTool["Variant"], 
							equippedTool["Config"], hitPositions, tip, isOffHand)
					end
					local isContinuous = FindToolSetting("Setting_isContinuous")
					local startUpTime = 0
					if isContinuous then
						startUpTime = 0.2
					end
					activationAnim:Play(startUpTime, 1, 1)
					if humanStates["prone"] then
						ChangeSpeed("ProneToggling")
					end
					if not isContinuous then
						rep.ToolSound:FireServer(equippedTool["Base"], equippedTool["Variant"], "Sound_activate", false)
					else
						while leftMouseDown and not humanStates["run"] do
							wait()
						end
						rep.ToolInteraction:FireServer("ActivateStop", equippedTool["Base"], equippedTool["Variant"])
						activationAnim:Stop(0.2)
					end
				end
			end
			wait(cooldown)
			if humanStates["prone"] then
				ChangeSpeed("Prone")
				if CheckMovementKeys() then
					anims[p.."proneMove"]:Play(0.2, 1, 1)
					toolAnims[FindToolSetting("Anim_proneMove")]:Play(0.2, 1, 1)
					humanStates["moving"] = true
				end
			end
			if chamberSetting == "Battery" then
				toolButton.ChamberState.Value = "Loaded"
			end
			equippedTool["Recovering"] = false
		elseif isUtility then --UTILITY
			local cooldown = FindToolSetting("Setting_cooldown")
			if cooldown then
				equippedTool["Recovering"] = true
			end
			local isContinuous = FindToolSetting("Setting_isContinuous")
			local startEffect = FindToolSetting("Setting_startEffect")
			local endEffect = FindToolSetting("Setting_endEffect")
			local isAnimated = FindToolSetting("Setting_isAnimated")
			if not toolButton.SelectedItem.Value then
				toolButton.SelectedItem.Value = true
				local state = "stand"
				if humanStates["prone"] then
					state = "prone"
				elseif humanStates["crouch"] then
					state = "crouch"
				end
				if startEffect then
					if string.find(startEffect, "Server") then
						rep.ToolInteraction:FireServer(string.sub(startEffect, 8, string.len(startEffect)), 
							equippedTool["Base"], equippedTool["Variant"])
					else
						CoroutineLauncher("ToolEffect", string.sub(startEffect, 8, string.len(startEffect)))
					end
				end
				if isAnimated then
					utilityAnim = toolAnims[FindToolSetting("Anim_"..state.."Activate")]
					MakeUtilityAnimConnection()
					utilityAnim:Play(0.2, 1, 1)
				else
					utilityAnim = nil
				end
				if utilityAnim and not isContinuous then
					local utilityAnimStopped
					utilityAnimStopped = utilityAnim.Stopped:Connect(function()
						utilityAnimStopped:Disconnect()
						utilityAnimConnection:Disconnect()
						toolButton.SelectedItem.Value = false
						if endEffect then
							if string.find(endEffect, "Server") then
								rep.ToolInteraction:FireServer(string.sub(endEffect, 8, string.len(endEffect)), 
									equippedTool["Base"], equippedTool["Variant"])
							else
								CoroutineLauncher("ToolEffect", string.sub(endEffect, 8, string.len(endEffect)))
							end
						end
					end)
				elseif not utilityAnim and not isContinuous then
					toolButton.SelectedItem.Value = false
				end
				if equippedTool["Variant"] == "Prop Placer" and dragProp["Mode"] and dragProp["Mode"] ~= "Orient" then
					local previousMode = dragProp["Mode"]
					dragProp["Mode"] = false
					propFrame.TuningFrame.Visible = false
					local approvedProp = rep.PlaceProp:InvokeServer(dragProp["Prop"].Name, 
						dragProp["Prop"].Prop.PrimaryPart.CFrame, mouseTarget)
					if approvedProp then
						placedPropData[#placedPropData + 1] = {Prop = approvedProp, RefMode = dragProp["RefMode"], 
							rX = dragProp["rX"], rY = dragProp["rY"], rZ = dragProp["rZ"], tX = dragProp["tX"], 
							tY = dragProp["tY"], tZ = dragProp["tZ"], sRX = propSlider["rX"], sRY = propSlider["rY"],
							sRZ = propSlider["rZ"], sTX = propSlider["tX"], sTY = propSlider["tY"], 
							sTZ = propSlider["tZ"]}
						script.GUISounds.BuildSound:Play()
						-- Remove highlight before destroying prop
						if dragProp["Highlight"] then
							dragProp["Highlight"]:Destroy()
							dragProp["Highlight"] = nil
						end
						dragProp["Prop"]:Destroy()
						dragProp["Prop"] = nil
						-- Clear editing prop data since we successfully placed it
						editingPropData = nil
						propFrame.MobilePropFrame.MovementButton.Button.Text = "Drag Mode"
						local countLabel = propFrame.CountLabel
						countLabel.Count.Value = countLabel.Count.Value + 1
						countLabel.Text = tostring(countLabel.Count.Value) .."/".. tostring(rep.PropLimit.Value)
						if countLabel.Count.Value == rep.PropLimit.Value then
							countLabel.TextColor3 = Color3.new(1, 0, 0)
							propFrame.Label.TextColor3 = Color3.new(1, 0, 0)
						end
						for _,c in pairs({"RotFrame", "TranslateFrame"}) do
							for _,v in pairs({"X", "Y", "Z"}) do
								local slider = propFrame.TuningFrame:FindFirstChild(c..v).Slider
								slider.Position = UDim2.new(0.45, 0, -.25, 0)
								propSlider[string.lower(string.sub(c, 1, 1))..v] = 0
							end
						end
					else
						dragProp["Mode"] = previousMode
					end
				end
			elseif isContinuous then
				toolButton.SelectedItem.Value = false
				if utilityAnim then
					utilityAnim:Stop(0.2)
					utilityAnimConnection:Disconnect()
				end
				if endEffect then
					if string.find(endEffect, "Server") then
						rep.ToolInteraction:FireServer(string.sub(endEffect, 8, string.len(endEffect)), 
							equippedTool["Base"], equippedTool["Variant"])
					else
						CoroutineLauncher("ToolEffect", string.sub(endEffect, 8, string.len(endEffect)))
					end
				end
			end
			wait(cooldown)
			equippedTool["Recovering"] = false
		end
	end
end

