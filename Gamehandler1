					end
				end
			elseif string.find(interaction, "Multinade") then
				interaction = string.sub(interaction, 11, string.len(interaction))
				for _,v in pairs(tool:GetChildren()) do
					if v:IsA("Model") and v.PrimaryPart.Transparency == 0 then
						for _,b in pairs(v:GetChildren()) do
							b.Transparency = 1
						end
						break
					end
				end
				for _,v in pairs(tool:FindFirstChild(interaction):GetChildren()) do
					v.Transparency = 0
				end
			elseif interaction == "CameraPhoto" then
				CoroutineLauncher("PlaySound", tool.Handle, "ToolSounds", "CameraSound", 0, {97, 103}, 1, 0.375)
				tool.Light.Material = Enum.Material.Neon
				tool.Light.PointLight.Enabled = true
				tool.Light.SpotLight.Enabled = true
				tool.Light.Flash.Enabled = true
				wait(0.1)
				tool.Light.Material = Enum.Material.Ice
				tool.Light.PointLight.Enabled = false
				tool.Light.SpotLight.Enabled = false
				tool.Light.Flash.Enabled = false
			elseif interaction == "Light On" then
				CoroutineLauncher("PlaySound", tool.Handle, "ToolSounds", "ToggleButton1", 0, {95, 105})
