function OrganizePropFrame(ownedProps)
	local propFrame = GUI.PropFrame
	for i,v in pairs(buttons) do
		if v[2].Name == "PropButton" then
			for _,n in pairs(v[3]) do
				n:Disconnect()
			end
			v[2]:Destroy()
			buttons[i] = nil
		end
	end
	local propsList = {}
	local newButtons = {}
	for _,v in pairs(rep.Props:GetChildren()) do
		local pass = v:FindFirstChild("Pass")
		if pass and ownedProps[v.Name] then
			propsList[#propsList + 1] = v.Name
		elseif not pass then
			propsList[#propsList + 1] = v.Name
		end
	end
	table.sort(propsList)
	local y = 0
	local yAdd = 60
	if platform == "Mobile" then
		yAdd = 45
	end
	for _,item in pairs(propsList) do
		local prop = rep.Props:FindFirstChild(item)
		local limit = prop:FindFirstChild("Limit")
		if limit then
			limit = tostring(limit.Value)
		else
			limit = "None"
		end
		local clo = propFrame.PropTemplate:Clone()
		clo.Button.ItemName.Text = prop.Name
		clo.Button.ItemLimit.Text = "Limit: "..limit
		local pass = prop:FindFirstChild("Pass")
		if pass then
			clo.Button.ItemPassName.Text = rep.ExclusiveItemNames:FindFirstChild(prop.Pass.Value).Value
		else
			clo.Button.ItemPassName.Text = ""
		end
		clo.Button.ItemImage.Image = TNS1..prop.ImageId.Value..TNS2
		clo.Name = "PropButton"
		clo.Visible = true
		clo.Position = UDim2.new(0.025, 0, 0, y)
		if platform == "Mobile" then
			clo.Size = UDim2.new(0.88, 0, 0, 35)
			clo.Button.ItemImage.Size = UDim2.new(0, 35, 0, 35)
			clo.Button.ItemImage.Position = UDim2.new(1, -35, 0, 0)
		end
		y = y + yAdd
		clo.Parent = propFrame.ScrollFrame
		newButtons[#newButtons + 1] = clo.Button
	end
	for _,v in pairs(newButtons) do
		InitializeButton(v)
	end
	local propCount = propFrame.CountLabel.Count.Value
	propFrame.CountLabel.Text = tostring(propCount) .."/".. tostring(rep.PropLimit.Value)
	if propFrame.CountLabel.Count.Value == rep.PropLimit.Value then
		propFrame.CountLabel.TextColor3 = Color3.new(1, 0, 0)
		propFrame.Label.TextColor3 = Color3.new(1, 0, 0)
	end
end

function ToggleToolDisplay(button)
	if equippedTool["Variant"] ~= button.Text and equippedTool["Toggle"] ~= "Unequipping" and equippedTool["Toggle"] ~= "Equipping" then
		local isDiplayed = true
		if string.find(button.Parent.Name, "Utility") and not FindToolSetting("Setting_doesDisplay", button.Parent.Base.Value,
			button.Text) then
			isDiplayed = false
		end
		if isDiplayed then
			rep.ToolDisplayToggle:InvokeServer(button.Parent.Base.Value, button.Text, button.Parent.Name)
		end
	end
end

