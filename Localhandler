function ChangeSpeed(state)
	local morphSettings = morphTypeSettings[humanState][state]
	human.WalkSpeed = morphSettings["Speed"]
	if morphSettings["CS"] then
		SetCharacterCollision(char, morphSettings["CS"])
	end
	if state == "ProneToggling" then
		anims["proneMove"]:Stop()
	elseif state == "Walk" then
		state = "stand"
	end
	local changeViewConnection
	local sT = tick()
	local goal = morphSettings["CamOffset"]
	local start = human.CameraOffset
	changeViewConnection = RunService.RenderStepped:Connect(function()
		local interval = math.min((tick() - sT) / 0.2, 1)
		local lerpPos = start:Lerp(goal, interval)
		human.CameraOffset = lerpPos
		if interval == 1 or plrState ~= "Playing" or (state ~= "ProneToggling" and not humanStates[string.lower(state)]) then
			changeViewConnection:Disconnect()
		end
	end)
end

function SetCharacterCollision(char, standing)
	local prefix = ""
	local newGroup, oldGroup = "CharacterParts", "SpecialCaseParts"
	local newPartList = {LowerTorso = true}
	local oldPartList = {CollisionPart = true, UpperTorso = true}
	if not standing then
		newPartList = {CollisionPart = true, UpperTorso = true}
		oldPartList = {LowerTorso = true}
	end
	if gameFrame.OOCFrame.On.Value then
		prefix = "OOC"
	end
	if humanState ~= "Humanoid" then
		if standing then
			newPartList = {LowerTorso = true}
			oldPartList = {CollisionPart = true, UpperTorso = true}
		else
			newPartList = {CollisionPart = true, UpperTorso = true}
			oldPartList = {LowerTorso = true}
		end
	end
	for _,v in pairs(char:GetChildren()) do
		if v:IsA("BasePart") and not partIgnoreList[v.Name] and v ~= char.PrimaryPart then
			if newPartList[v.Name] then
				PhyService:SetPartCollisionGroup(v, prefix..newGroup)
			elseif oldPartList[v.Name] then
				PhyService:SetPartCollisionGroup(v, prefix..oldGroup)
			end
		elseif v == char.PrimaryPart then
			v.CanCollide = standing
		end
	end
end

function HumanoidEvent(event, input1)
	if event == "Jumping" or event == "FreeFalling" then
		if plrState ~= "Customizing" and not humanStates["fall"] and not humanStates["swim"] then
			if humanStates["animated"] then
				StopAnimatedState()
			end
			if not mKs["LeftShift"] then
				ChangeSpeed("Walk")
			else
				ChangeSpeed("Run")
			end
			rep.CharacterSound:FireServer(p, floorMaterialSounds[currentFloorMaterial], 0, false)
			humanStates["fall"] = true
			anims[p.."fall"]:Play(0.2, 1, 1)
			if event == "Jumping" then
				if humanStates["resting"] then
					humanStates["resting"] = false
					human.AutoRotate = true
					rep.JumpedOutOfResting:InvokeServer()
					gameFrame.Visible = true
					toolboxFrame.Visible = true
					animFrame.Visible = true
					animFrame.ScrollFrame.HumanoidFrame.Visible = true
					StopSittingAnims()
					anims[p.."stand"]:Play(0.2, 1, 1)
					anims["Drive"]:Stop()
				end
				anims[p.."jump"]:Play(0.1, 1, 1)
			end
			if CheckMovementKeys() then
				humanStates["moving"] = true
			end
			local oldState, oldIdle, oldMove = "stand", "stand", "walk"
			if humanStates["crouch"] then
				oldIdle, oldMove, oldState = "crouch", "crouchMove", "crouch"
			elseif humanStates["prone"] then
				oldIdle, oldMove, oldState = "prone", "proneMove", "prone"
			elseif humanStates["climb"] then
				oldIdle, oldState = "climb", "climb"
			elseif mKs["LeftShift"] then
				oldMove, oldState = "run", "run"
			end
			local stateSuffix = ""
			if not equippedTool["Aiming"] then
				if not (oldState == "run" or oldState == "climb") then
					stateSuffix = "Relax"
				elseif oldState == "run" and equippedTool["Toggle"] == "Equipped" then
					toolAnims[FindToolSetting("Anim_standRelax")]:Stop()
					toolAnims[FindToolSetting("Anim_walkRelax")]:Stop()
				end
			end
			if oldState then
				humanStates[oldState] = false
				anims[p..oldIdle]:Stop()
				if equippedTool["Toggle"] == "Equipped" then
					toolAnims[FindToolSetting("Anim_"..oldIdle..stateSuffix)]:Stop()
				end
			end
			if oldMove then
				anims[p..oldMove]:Stop()
				if equippedTool["Toggle"] == "Equipped" then
					toolAnims[FindToolSetting("Anim_"..oldMove..stateSuffix)]:Stop()
				end
			end
		end
	elseif event == "Climbing" then
		local animPlaySpeed, soundPlaySpeed = 1, 0.7
		local oldIdle, oldMove, oldState 
		if humanStates["animated"] then
			StopAnimatedState()
		elseif humanStates["resting"] then
			return
		end
		rep.CharacterSound:FireServer(p, floorMaterialSounds[currentFloorMaterial], 0, false)
		if humanStates["crouch"] then
			oldIdle, oldMove, oldState = "crouch", "crouchMove", "crouch"
		elseif humanStates["prone"] then
			oldIdle, oldMove, oldState = "prone", "proneMove", "prone"
		elseif humanStates["stand"] then
			oldIdle, oldMove, oldState = "stand", "walk", "stand"
		end
		if mKs["LeftShift"] then
			oldIdle, oldMove, oldState = "stand", "run", "run"
			animPlaySpeed, soundPlaySpeed = 1.8, 1.25
		end
		if not humanStates["climb"] then
			humanStates["climb"] = true
			anims[p.."climb"]:Play(0.2, 1, animPlaySpeed)
			if equippedTool["Toggle"] == "Equipped" then
				local isDualWielded = toolboxFrame:FindFirstChild(equippedTool["Slot"]).IsDualWielded.Value
				if not isDualWielded and not string.find(equippedTool["Slot"], "Utility") then
					toolAnims[FindToolSetting("Anim_climb")]:Play(0.2, 1, animPlaySpeed)
				else
					QuickUnequip(false)
				end
			end
		end
		if humanStates["fall"] then
			humanStates["fall"] = false
			anims[p.."jump"]:Stop()
			anims[p.."fall"]:Stop()
		end
		if oldIdle then
			anims[p..oldIdle]:Stop(0.2)
			anims[p..oldMove]:Stop(0.2)
			if equippedTool["Toggle"] == "Equipped" then
				toolAnims[FindToolSetting("Anim_"..oldIdle)]:Stop(0.2)
				toolAnims[FindToolSetting("Anim_"..oldMove)]:Stop(0.2)
			end
			humanStates[oldState] = false
		end
		if input1 < -1 then
			animPlaySpeed = -animPlaySpeed
			humanStates["climbDirection"] = "Down"
			rep.CharacterSound:FireServer(p, "Metal", soundPlaySpeed, true)
		elseif input1 == 0 then
			animPlaySpeed = 0
			humanStates["climbDirection"] = "None"
			rep.CharacterSound:FireServer(p, "Metal", 0, false)
		else
			humanStates["climbDirection"] = "Up"
			rep.CharacterSound:FireServer(p, "Metal", soundPlaySpeed, true)
		end
		anims[p.."climb"]:AdjustSpeed(animPlaySpeed)
		if equippedTool["Toggle"] == "Equipped" and FindToolSetting("Anim_climb") then
			toolAnims[FindToolSetting("Anim_climb")]:AdjustSpeed(animPlaySpeed)
		end
	elseif event == "Swimming" and not humanStates["swim"] then
		if humanStates["animated"] then
			StopAnimatedState()
		end
		local oldIdle, oldMove, oldState
		if humanStates["crouch"] then
			oldIdle, oldMove, oldState = "crouch", "crouchMove", "crouch"
		elseif humanStates["prone"] then
			oldIdle, oldMove, oldState = "prone", "proneMove", "prone"
		elseif humanStates["stand"] then
			oldIdle, oldMove, oldState = "stand", "walk", "stand"
		elseif humanStates["climb"] then
			oldIdle, oldState = "climb", "climb"
		end
		if humanStates["fall"] then
			humanStates["fall"] = false
			anims[p.."jump"]:Stop()
			anims[p.."fall"]:Stop()
		else
			rep.CharacterSound:FireServer(p, floorMaterialSounds[currentFloorMaterial], 0, false)
		end
		if oldIdle then
			anims[p..oldIdle]:Stop(0.2)
			if equippedTool["Toggle"] == "Equipped" then
				toolAnims[FindToolSetting("Anim_"..oldIdle)]:Stop(0.2)
			end
			humanStates[oldState] = false
			if oldMove then
				anims[p..oldMove]:Stop(0.2)
				if equippedTool["Toggle"] == "Equipped" then
					toolAnims[FindToolSetting("Anim_"..oldMove)]:Stop(0.2)
				end
			end
		end
		anims[p.."swim"]:Play(0.2, 1, 1)
		humanStates["swim"] = true
		if mKs["LeftShift"] then
			anims[p.."swimMove"]:Play(0.2, 1, 1)
			anims[p.."run"]:Stop(0.2)
		end
		if equippedTool["Variant"] ~= "None" and equippedTool["Toggle"] ~= "Unequipping" then
			QuickUnequip(false)
		end
	end
end

function QuickUnequip(instant)
	while equippedTool["Reloading"] ~= "None" do
		wait()
	end
	if not instant then
		equippedTool["Toggle"] = "Unequipping"
		local unequipAnim = toolAnims[FindToolSetting("Anim_quickUnequip")]
		local unequipAnimKeyframeConnection
		unequipAnim:Play(0, 1, 1)
		unequipAnimKeyframeConnection = unequipAnim.KeyframeReached:Connect(function(keyframe)
			if keyframe == "Discard" then
				unequipAnim:AdjustSpeed(0)
				rep.EquipTool:InvokeServer("Unequip", equippedTool["Base"], equippedTool["Config"], equippedTool["Slot"])
				unequipAnim:AdjustSpeed(1)
			elseif keyframe == "Unequipped" then
				unequipAnimKeyframeConnection:Disconnect()
				ResetTool()
			end
		end)
	else
		rep.EquipTool:InvokeServer("Unequip", equippedTool["Base"], equippedTool["Config"], equippedTool["Slot"])
		ResetTool()
	end
end

function ResetTool()
	local lastTool = toolboxFrame:FindFirstChild(equippedTool["Slot"])
	for i,func in pairs(keyFunctions) do
		if func["Effect"] == "Scope" and func["Setting"] == 1 then
			CoroutineLauncher("ToolEffect", "Scope_Down")
		end
	end
	keyFunctions = {}
	if lastTool then 
		if lastTool.Button.Text == "Prop Placer" then
			propFrame.Visible = false
			for i,v in pairs(ignoreList) do
				if v == dragProp["Prop"] then
					table.remove(ignoreList, i)
					break
				end
			end
			if dragProp["Mode"] then
				-- Remove highlight before destroying prop
				if dragProp["Highlight"] then
					dragProp["Highlight"]:Destroy()
					dragProp["Highlight"] = nil
				end
				dragProp["Prop"]:Destroy()
				dragProp["Mode"] = nil
				dragProp["RefMode"] = nil
				dragProp["Prop"] = nil
			end
		elseif lastTool.Button.Text == "Vehicle Placer" then
			vehicleFrame.Visible = false
		elseif lastTool.Button.Text == "Hunter's Clipboard" then
			GUI.ClipboardFrame.Visible = false
		elseif equippedTool["Base"] == "Throwables" then
			GUI.ThrowableFrame.Visible = false
		end
	end
	if lastTool then
		lastTool.BackgroundColor3 = Color3.fromRGB(132, 70, 0)
		lastTool.Button.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
		if string.find(equippedTool["Slot"], "Utility") then
			lastTool.SelectedItem.Value = false
		end
		if FindToolSetting("Setting_reloadMethod") == "SingleRoundTension" then
			lastTool.ChamberState.Value = "Empty"
		end
	end
	equippedTool = {Base = "None", Variant = "None", Slot = "Primary", Config = "None", Aiming = true, Toggle = "Unequipped", 
		Reloading = "None", Recovering = false}
	if mobileFrame.Visible then
		mobileFrame.ReloadButton.Visible = false
		mobileFrame.RelaxButton.Visible = false
		mobileFrame.ChamberButton.Visible = false
		mobileFrame.zFunctionButton.Visible = false
		mobileFrame.tFunctionButton.Visible = false
		mobileFrame.yFunctionButton.Visible = false
	end
	for _,v in pairs(toolAnims) do
		if v.IsPlaying then
			v:Stop()
		end
	end
end

