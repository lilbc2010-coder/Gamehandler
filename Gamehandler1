MarketService.ProcessReceipt = function(receiptInfo)
	local playerProductKey = receiptInfo.PlayerId .. "_" .. receiptInfo.PurchaseId
	local purchased = false
	local success, errorMessage = pcall(function()
		purchased = PurchaseStore:GetAsync(playerProductKey)
	end)
	if success and purchased then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	elseif errorMessage then
		error("Data store error:" .. errorMessage)
	end
	local plr = PlayerService:GetPlayerByUserId(receiptInfo.PlayerId)
	if not plr then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseProcessor = productFunctions[receiptInfo.ProductId]
	local success, result = pcall(purchaseProcessor, receiptInfo, plr)
	if not success or not result then
		warn("Error occurred while processing a product purchase")
		print("\nProductId:", receiptInfo.ProductId)
		print("\nPlayer:", plr)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
 	local success, errorMessage = pcall(function()
		PurchaseStore:SetAsync(playerProductKey, true)
		SaveData(receiptInfo.PlayerId, gameData[plr.Name]["Account"], DataStore)
	end)
	if not success then
		error("Cannot save purchase data: " .. errorMessage)
	end
	rep.ReceiptProcessed:FireClient(plr, gameData[plr.Name]["Account"]["Currency"])
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function rep.CurrencyPurchase.OnServerInvoke(plr, mode, input1)
	if mode == "Tool" then
		local currency = gameData[plr.Name]["Account"]["Currency"]
		local price
		for _,v in pairs(serv.Tools:GetChildren()) do
			local variant = v:FindFirstChild(input1)
			if variant then
				price = variant.Pass.Price.Value
				break
			end
		end
		if currency >= price then
			local newAmount = currency - price
			gameData[plr.Name]["Account"]["Currency"] = newAmount
			gameData[plr.Name]["Account"]["ToolsOwned"][input1] = true
			SaveData(plr.UserId, gameData[plr.Name]["Account"], DataStore)
			return true, newAmount
		else
			return false
		end
	elseif mode == "Morph" then
		local currency = gameData[plr.Name]["Account"]["Currency"]
		local price = serv.Morphs:FindFirstChild(input1).Pass.Price.Value
		if currency >= price then
			local newAmount = currency - price
			gameData[plr.Name]["Account"]["Currency"] = newAmount
			gameData[plr.Name]["Account"]["MorphsOwned"][input1] = true
			SaveData(plr.UserId, gameData[plr.Name]["Account"], DataStore)
			return true, newAmount
		else
			return false
		end
	elseif mode == "Expansion" then
		local currency = gameData[plr.Name]["Account"]["Currency"]
		local item = rep.ExpansionPacks:FindFirstChild(input1)
		local price = item.Price.Value
		if currency >= price then
			local newAmount = currency - price
			gameData[plr.Name]["Account"]["Currency"] = newAmount
			for _,v in pairs(rep.Props:GetChildren()) do
				local pass = v:FindFirstChild("Pass")
				if pass and pass.Value == item.PassName.Value then
					gameData[plr.Name]["Account"]["PropsOwned"][v.Name] = true
				end
			end
			gameData[plr.Name]["Account"]["ExpansionsOwned"][item.PassName.Value] = true
			gameData[plr.Name]["Server"]["PropLimit"] = gameData[plr.Name]["Server"]["PropLimit"] + item.PropLimitBoost.Value
			SaveData(plr.UserId, gameData[plr.Name]["Account"], DataStore)
			return true, newAmount, gameData[plr.Name]["Account"]["PropsOwned"], gameData[plr.Name]["Server"]["PropLimit"]
		else
			return false
		end
	end
end

