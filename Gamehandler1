function rep.SaveLoadPropsChar.OnServerInvoke(plr, mode, input1, input2)
	if mode == "Save" then
		local t = tick()
		if (t - gameData[plr.Name]["Server"]["LastSave"]) > 15 then
			gameData[plr.Name]["Server"]["LastSave"] = t
			if string.find(input1, "Build") then
				gameData[plr.Name]["Account"]["PropSaves"][input1]["Name"] = input2
				gameData[plr.Name]["Account"]["PropSaves"][input1]["Props"] = {}
				for _,v in pairs(gameData[plr.Name]["Server"]["PropsPlaced"]) do
					if not v:FindFirstChild("Chassis") then
						local signData = {}
						if string.find(v.Name, "Sign") then
							for _,b in pairs(v:GetChildren()) do
								if b:FindFirstChild("SignGui") then
									local sign = b.SignGui.Label
									local x, y, f, c = tostring(sign.TextXAlignment), tostring(sign.TextYAlignment),
										tostring(sign.Font), sign.TextColor3
									signData = {sign.Text, {c.r, c.g, c.b}, sign.TextSize, sign.TextStrokeTransparency,
										sign.TextScaled, string.sub(f, 11, string.len(f)), 
										string.sub(x, 21, string.len(x)), string.sub(y, 21, string.len(y))}
									break
								end
							end
						end
						table.insert(gameData[plr.Name]["Account"]["PropSaves"][input1]["Props"], 
							{v.Name, {v.PrimaryPart.CFrame:GetComponents()}, signData})
					end
				end
			else
				if plr.Character then
					local customShirt = gameData[plr.Name]["Server"]["Shirt"] == "Custom" or "Loaded"
					local customPants = gameData[plr.Name]["Server"]["Pants"] == "Custom" or "Loaded"
					if customShirt and plr.Character:FindFirstChild("Shirt") then
						customShirt = plr.Character.Shirt.ShirtTemplate
					elseif not customShirt then
						customShirt = gameData[plr.Name]["Server"]["Shirt"]
					end
					if customPants and plr.Character:FindFirstChild("Pants") then
						customPants = plr.Character.Pants.PantsTemplate
					elseif not customPants then
						customPants = gameData[plr.Name]["Server"]["Pants"]
					end
					local modAcc, modEquip, modTools = {}, {}, {}
					for i,v in pairs(gameData[plr.Name]["Server"]["Accessories"]) do
						modAcc[i] = v
						modAcc[i]["Object"] = nil
					end
					for i,v in pairs(gameData[plr.Name]["Server"]["Equipment"]) do
						modEquip[i] = v
					end
					for i,v in pairs(gameData[plr.Name]["Server"]["Tools"]) do
						modTools[i] = v
					end
					local headColor = plr.Character.MeshHead.Color
					gameData[plr.Name]["Account"]["CharSaves"][input1]["Name"] = input2
					gameData[plr.Name]["Account"]["CharSaves"][input1]["RPName"] = rep.CharacterBios:FindFirstChild(plr.Name).RPName.Value
					gameData[plr.Name]["Account"]["CharSaves"][input1]["Bio"] = rep.CharacterBios:FindFirstChild(plr.Name).Value
					gameData[plr.Name]["Account"]["CharSaves"][input1]["BodyColor"] = {r = headColor.r, g = headColor.g, b = headColor.b}
					gameData[plr.Name]["Account"]["CharSaves"][input1]["Accessories"] = modAcc
					gameData[plr.Name]["Account"]["CharSaves"][input1]["Equipment"] = modEquip
					gameData[plr.Name]["Account"]["CharSaves"][input1]["Tools"] = modTools
					gameData[plr.Name]["Account"]["CharSaves"][input1]["Shirt"] = customShirt
					gameData[plr.Name]["Account"]["CharSaves"][input1]["Pants"] = customPants
				else
					return false
				end
			end
			SaveData(plr.UserId, gameData[plr.Name]["Account"], DataStore)
			return true
		else
			return false
		end
	elseif mode == "Load" then
		if string.find(input1, "Build") then
			if #gameData[plr.Name]["Account"]["PropSaves"][input1]["Props"] + #gameData[plr.Name]["Server"]["PropsPlaced"] <=
				gameData[plr.Name]["Server"]["PropLimit"] and 
				typeof(gameData[plr.Name]["Account"]["PropSaves"][input1]["Props"][1]) == "table" then
					local creationTime = os.time()
				for _,v in pairs(gameData[plr.Name]["Account"]["PropSaves"][input1]["Props"]) do
					local prop = rep.Props:FindFirstChild(v[1])
					if prop then
						PlaceProp(plr.Name, prop, CFrame.new(unpack(v[2])), creationTime, v[3])
					end
				end
				return #gameData[plr.Name]["Account"]["PropSaves"][input1]["Props"]
			end
		else
			local loadout, dataBase
			if not input2 then
				dataBase = gameData[plr.Name]["Server"]["LastCharacter"]
			else
				dataBase = gameData[plr.Name]["Account"]["CharSaves"][input1]
			end
			if not dataBase then return end
			if not dataBase["Equipment"] then return end
			loadout = {Tools = dataBase["Tools"], Equipment = dataBase["Equipment"], Shirt = dataBase["Shirt"],
				Pants = dataBase["Pants"], Accessories = dataBase["Accessories"], BodyColor = dataBase["BodyColor"], 
				RPName = dataBase["RPName"], Bio = dataBase["Bio"]}
			for _,v in pairs(plr.Character.Humanoid:GetAccessories()) do
				LoadItem(plr, "RemoveAccessory", v)
			end
			for i,v in pairs(loadout["Accessories"]) do
				LoadItem(plr, "AddAccessory", string.sub(i, 3, string.len(i)))
				local acc = gameData[plr.Name]["Server"]["Accessories"]
				if v["Texture"] then
					LoadItem(plr, "AccessoryChange_SetId", acc[i]["Object"], v["Texture"])
				end
				if v["r"] then
					LoadItem(plr, "AccessoryChange_SetColor", acc[i]["Object"], Vector3.new(v["r"], v["g"], v["b"]))
				end
			end
			local preset = true
			for i,v in pairs(loadout["Equipment"]) do
				if v ~= loadout["Equipment"]["Head"] then
					preset = false
					break
				end
			end
			if preset then
				LoadItem(plr, "MorphChange_Preset", loadout["Equipment"]["Head"])
			else
				for i,v in pairs(loadout["Equipment"]) do
					LoadItem(plr, "MorphChange_"..i, v)
				end
			end
			for _,v in pairs({"Primary", "Secondary", "Utility1", "Utility2", "Utility3"}) do
				if loadout["Tools"][v]["Variant"] ~= "None" then
					LoadItem(plr, "ToolChange", loadout["Tools"][v]["Base"], loadout["Tools"][v]["Variant"], v)
				elseif gameData[plr.Name]["Server"]["Tools"][v] ~= "None" then
					LoadItem(plr, "ToolChange", "None", gameData[plr.Name]["Server"]["Tools"][v]["Variant"])
				end
			end
			LoadItem(plr, "BodyColorChange_SetColor", loadout["BodyColor"])
			LoadItem(plr, "ShirtChange", loadout["Shirt"])
			LoadItem(plr, "PantsChange", loadout["Pants"])
			LoadItem(plr, "NameChange", loadout["RPName"])
			LoadItem(plr, "BioChange", loadout["Bio"])
			--make shirts and pants load in from previous Custom shirts/pants
			return loadout
		end
	end
end

function OrganizeCustomization()
	local morphs = Instance.new("Folder")
	for _,v in pairs(serv.Morphs:GetChildren()) do
		local val = Instance.new("StringValue")
		val.Name = v.Name
		val.Value = "Humanoid"
		val.Parent = morphs
		if v:FindFirstChild("Pass") then
			local pass = v.Pass:Clone()
			pass.Parent = val
		end
		for _,n in pairs(v:GetChildren()) do
			if n:IsA("Folder") then
				local containerName = containerNames[string.sub(n.Name, 1, string.len(n.Name) - 5)]
				if containerName and not val:FindFirstChild(containerName) then
					local newVal = Instance.new("BoolValue")
					newVal.Name = containerName
					newVal.Parent = val
				end
				for _,m in pairs(n:GetChildren()) do
					local oT = Instance.new("NumberValue")
					oT.Value = m.Transparency
					oT.Name = "StoredTransparency"
					oT.Parent = m
				end
			end
		end
		if v:FindFirstChild("NonHumanoid") then
			val.Value = v.NonHumanoid.Value
		end
	end
	morphs.Name = "Morphs"
	morphs.Parent = rep
	local shirts = Instance.new("Folder")
	for _,v in pairs(serv.Shirts:GetChildren()) do
		local sv = Instance.new("StringValue")
		sv.Name = v.Name
		sv.Value = v.Creator.Value
		sv.Parent = shirts
	end
	shirts.Name = "Shirts"
	shirts.Parent = rep
	local pants = Instance.new("Folder")
	for _,v in pairs(serv.Pants:GetChildren()) do
		local sv = Instance.new("StringValue")
		sv.Name = v.Name
		sv.Value = v.Creator.Value
		sv.Parent = pants
	end
	pants.Name = "Pants"
	pants.Parent = rep
	for _,v in pairs(serv.Tools:GetChildren()) do
		local f = Instance.new("StringValue")
		f.Name = v.Name
		f.Value = v.Value
		for _,n in pairs(v:GetChildren()) do
			if n:IsA("Folder") then
				local variant = Instance.new("BoolValue")
				variant.Name = n.Name
				variant.Parent = f
				for _,m in pairs(n:GetChildren()) do
					if not m:IsA("Model") then
						local a = m:Clone()
						a.Parent = variant
					end
				end
			elseif (n:IsA("StringValue") or n:IsA("NumberValue")or n:IsA("IntValue") or n:IsA("BoolValue")) and 
				(string.find(n.Name, "Anim") or string.find(n.Name, "Setting") or string.find(n.Name, "Sound")) then
				local a = n:Clone()
				a.Parent = f
			elseif n.Name == "Model_OffHand" then
				local isDualWielded = false
				if string.find(v.Value, "Utility") then
					isDualWielded = true
				elseif n:FindFirstChild("Tip") then
					isDualWielded = true
				end
				if isDualWielded then
					local d = Instance.new("BoolValue")
					d.Name = "Setting_isDualWielded"
					d.Parent = f
				end
			end
		end
		f.Parent = rep.Tools
	end
	for _,v in pairs(serv.Vehicles:GetChildren()) do
		local f = Instance.new("BoolValue")
		f.Name = v.Name
		f.Parent = rep.Vehicles
		for _,n in pairs(v:GetChildren()) do
			if n:IsA("IntValue") or n:IsA("StringValue") then
				local nC = n:Clone()
				nC.Parent = f
			end
		end
	end
end
	
function Scan(object, mode)
	for _,item in pairs(object:GetChildren()) do
		if mode == "Prop" and (item:IsA("BasePart") or item:IsA("UnionOperation") or item:IsA("MeshPart")) then
			PhysicsService:SetPartCollisionGroup(item, "Props")
		end
		if item.Name == "V4Terra" or item.Name == "RoadScale" then
			item:Destroy()
		elseif item.Name == "Teleporter" then
			if string.find(item.Target.Value, "Personal") then
				local targetName = item.Target.Value
				local destination = item.Parent:FindFirstChild(targetName)
				local newName = "Teleporter_"..item.Parent.Owner.Value.."'s "..string.sub(targetName, 21, string.len(targetName))
				local reference = Instance.new("ObjectValue")
				reference.Name = "TeleporterReference"
				reference.Value = item
