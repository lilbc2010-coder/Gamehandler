-- Smooth easing function for interactive objects (eliminates stuttering)
local function EaseInOutSine(t)
	return -(math.cos(math.pi * t) - 1) / 2
end

function InteractDoor(door, rotationMode)
	local rotation = -1
	local goalCF = door.GoalCF.Value
	if rotationMode == "ReverseDoor" then
		rotation = 1
	end
	local newVal = "Open"
	if door.Mode.Value == "Open" then
		newVal = "Closed"
		if rotationMode == "ReverseDoor" then
			rotation, goalCF = -1, door.StartCF.Value
		else
			rotation, goalCF = 1, door.StartCF.Value
		end
	end
	door.Debounce.Value = true
	door.Mode.Value = newVal
	local soundPlayed = false
	local startT = tick()
	local startCF = door.PrimaryPart.CFrame
	local objectRunner 
	if newVal == "Open" then
		CoroutineLauncher("PlaySound", door.PrimaryPart, "InteractiveSounds", "DoorOpen", 1, {95, 105})
		soundPlayed = true
	end
	objectRunner = RunService.Stepped:connect(function()
		if door.Parent then
			local rawProgress = math.min((tick() - startT) / 0.5, 1)
			local easedProgress = EaseInOutSine(rawProgress)
			local interval = easedProgress * 90
			door:SetPrimaryPartCFrame(startCF * CFrame.Angles(0, math.rad(interval * rotation), 0))
			if not soundPlayed and interval >= 20 then
				CoroutineLauncher("PlaySound", door.PrimaryPart, "InteractiveSounds", "DoorClose", 1, {95, 105})
				soundPlayed = true
			end
			if rawProgress >= 1 then
				door:SetPrimaryPartCFrame(goalCF)
				objectRunner:disconnect()
				wait(0.4)
				door.Debounce.Value = false
			end
		else
			objectRunner:Disconnect()
		end
	end)
end

