function AddNewAccessory(newAccessory)
	local panel = charFrame.BodyFrame.AccessoryTemplate:Clone()
	panel.AccessoryName.Text = newAccessory.Name
	panel.Accessory.Value = newAccessory
	for _,n in pairs({"SetColor", "ResetColor", "SetId", "ResetId", "SetR", "SetB", "SetG", "DestroyAccessory"}) do
		InitializeButton(panel:FindFirstChild(n).Button)
	end
	for _,n in pairs({"R", "G", "B"}) do
		local frame = panel:FindFirstChild(n.."Frame")
		frame.Slider.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				accessorySlider["Dragging"] = frame.Slider
				accessorySlider["Offset"] = mouse.X - frame.Slider.AbsolutePosition.X
			end
		end)
	end
	local panelCount = #charFrame.BodyFrame.ItemScrollFrame:GetChildren()
	panel.Position = UDim2.new(0.03, 0, 0, 10 + ((panelCount - 1) * 360))
	panel.Parent = charFrame.BodyFrame.ItemScrollFrame
	local searchStr = "="
	if string.find(newAccessory.Handle.Mesh.TextureId, "rbx") then
		searchStr = "://"
	end
	local _,_,_,id = string.find(newAccessory.Handle.Mesh.TextureId, "(%w+)"..searchStr.."(%w+)")
	panel.IdBox.Text = id
	for i,n in pairs({R = "x", G = "y", B = "z"}) do
		local setting = newAccessory.Handle.Mesh.VertexColor[n]
		local sliderFrame = panel:FindFirstChild(i.."Frame")
		panel:FindFirstChild("Set"..i.."Box").Text = math.floor(setting * 255)
		sliderFrame.Setting.Value = setting
		sliderFrame.Slider.Position = UDim2.new(setting * 0.9, 0, -0.25, 0)
	end
	panel.Visible = true
	charFrame.BodyFrame.ItemScrollFrame.AddNewAccessory.Position = UDim2.new(0.03, 0, 0, 10 + (panelCount * 360))
end

function RemoveAccessory(panel)
	local panelPos = panel.Position.Y.Offset
	for _,n in pairs(buttons) do
		if n[1]:IsDescendantOf(panel) then
			for _,m in pairs(n[3]) do
				m:Disconnect()
			end
		end
	end
	panel:Destroy()
	local scrollFrame = charFrame.BodyFrame.ItemScrollFrame
	local panels = scrollFrame:GetChildren()
	for _,n in pairs(panels) do
		if n.Position.Y.Offset > panelPos then
			n.Position = UDim2.new(0.03, 0, 0, n.Position.Y.Offset - 360)
		end
	end
end

function LoadData(loadedData)
	for _,v in pairs({"Primary", "Secondary", "Utility1", "Utility2", "Utility3"}) do
		toolFrame:FindFirstChild(v.."Button").Label.Text = loadedData["Tools"][v]["Variant"]
		if loadedData["Tools"][v]["Variant"] ~= "None" then
			AssignTool(loadedData["Tools"][v]["Variant"], loadedData["Tools"][v]["Base"], 
				toolboxFrame:FindFirstChild(v))
		else
			toolboxFrame:FindFirstChild(v).Button.Text = "None"
		end
	end
	ChangeBodyColor()
	for _,v in pairs(charFrame.BodyFrame.ItemScrollFrame:GetChildren()) do
		if v.Name ~= "AddNewAccessory" then
			RemoveAccessory(v)
		end
	end
	for _,v in pairs(human:GetAccessories()) do
		AddNewAccessory(v)
	end
	customizeFrame.NameFrame.Text = loadedData["RPName"]
	customizeFrame.BioFrame.Text = loadedData["Bio"]
	ChangeHumanoidMode(loadedData["Equipment"]["Head"])
end

function ChangeHumanoidMode(itemName)
	local lastP, newP, morphType
	if itemName ~= "None" then
		morphType = rep.Morphs:FindFirstChild(itemName).Value
		lastP = string.sub(p, 1, string.len(p) - 1)
		newP = ""
		if morphType ~= "Humanoid" then
			for _,n in pairs(toolboxFrame:GetChildren()) do
				if n.Name ~= "ToggleFrame" and n.Button.Text ~= "None" then
					rep.LoadItem:InvokeServer("ToolChange", "None", n.Button.Text)
					n.Button.Text = "None"
				end
			end
			for _,n in pairs(toolFrame:GetChildren()) do
				if string.find(n.Name, "Button") then
					n.Label.Text = "None"
				end
			end
			newP = morphType.."_"
			gameFrame.HeadwearFrame.State.Value = "Helmet Only"
			rep.Headwear:FireServer("Helmet Only")
		end
	else
		morphType = "Humanoid"
		lastP = string.sub(p, 1, string.len(p) - 1)
		newP = ""
	end
	if morphType ~= lastP then
		anims[p.."stand"]:Stop(0.2)
		humanState = morphType
		p = newP
		SetCharacterCollision(char, true)
		anims[p.."stand"]:Play(0, 1, 1)
		for _,v in pairs(animFrame.ScrollFrame:GetChildren()) do
			v.Visible = false
		end
		local morphFrame = animFrame.ScrollFrame:FindFirstChild(morphType.."Frame")
		if morphFrame then
			morphFrame.Visible = true
		end
	end
end

function AssignTool(varName, baseName, toolButton)
	toolButton.Button.Text = varName
	toolButton.Base.Value = baseName
	local isDualWielded = FindToolSetting("Setting_isDualWielded", baseName, varName)
	if rep.Tools:FindFirstChild(baseName).Value ~= "Utility" then
		toolButton.MagSize.Value = FindToolSetting("Setting_magSize", baseName, varName)
		toolButton.MagCount.Value = toolButton.MagSize.Value
		local reloadMethod = FindToolSetting("Setting_reloadMethod", baseName, varName)
		local chamberMethod = FindToolSetting("Setting_chambering", baseName, varName)
		if string.find(reloadMethod, "SingleRound") then
			if chamberMethod == "Hammer" or reloadMethod == "SingleRoundTension" then
				toolButton.ChamberState.Value = "Empty"
			else
				toolButton.ChamberState.Value = "Loaded"	
			end
		elseif (reloadMethod == "Bulk" and string.find(chamberMethod, "Semiauto") or
			reloadMethod == "MagazineBeltFeed") then
			toolButton.ChamberState.Value = "Loaded"
		end
		if isDualWielded then
			toolButton.MagCount_OffHand.Value = toolButton.MagCount.Value
			toolButton.ChamberState_OffHand.Value = toolButton.ChamberState.Value
		end
	end
	if isDualWielded then
		toolButton.IsDualWielded.Value = true
	else
		toolButton.IsDualWielded.Value = false
	end
end

function SaveFile(v)
	if v.Parent.Name == "Confirm" then
		if string.find(GUI.ConfirmSaveLoadFrame.Mode.Value, "Save") then
			notifier.Text = "SAVING"
			notifier.Visible = true
			local slotName = GUI.ConfirmSaveLoadFrame.Mode.Value
			slotName = string.sub(slotName, 6, string.len(slotName))
			local newName = GUI.SaveLoadPropsFrame.NameBox.Text
			if string.find(slotName, "Char") then
				newName = GUI.SaveLoadCharacterFrame.NameBox.Text
			end
			local approved = rep.SaveLoadPropsChar:InvokeServer("Save", slotName, newName)
			if approved then
				GUI.ConfirmSaveLoadFrame:TweenPosition(UDim2.new(0.4, 0, 1.4, 0), "Out", "Sine", 0.2)
				if string.find(slotName, "Char") then
					dataFrame.LoadCharFrame:FindFirstChild(slotName).Button.Text = newName
					GUI.SaveLoadCharacterFrame:FindFirstChild(slotName).Button.Text = newName
				else
					propFrame.LoadBuildFrame:FindFirstChild(slotName).Button.Text = newName
					GUI.SaveLoadPropsFrame:FindFirstChild(slotName).Button.Text = newName
				end
				notifier.Text = "SAVED"
				notifierCount = notifierCount + 1
				CoroutineLauncher("NotifierDelay")
			else
				notifier.Text = "YOU MAY ONLY SAVE ONCE EVERY 15 SECONDS"
				notifierCount = notifierCount + 1
				CoroutineLauncher("NotifierDelay")
			end
		else
			notifier.Text = "LOADING"
			notifier.Visible = true
			local slotName, isSaved = GUI.ConfirmSaveLoadFrame.Mode.Value, true
			if string.find(slotName, "PreviousCharacter") then
				slotName, isSaved = "Load_LastCharacter", false
			end
			local loadedData = rep.SaveLoadPropsChar:InvokeServer("Load", string.sub(slotName, 6, string.len(slotName)), isSaved)
			--if props, loadedData = prop count, if character, loadedData = character data
			GUI.ConfirmSaveLoadFrame:TweenPosition(UDim2.new(0.4, 0, 1.4, 0), "Out", "Sine", 0.2)
			if loadedData then
				notifier.Text = "LOADED"
				if typeof(loadedData) == "number" then
					propFrame.CountLabel.Count.Value = propFrame.CountLabel.Count.Value + loadedData
					propFrame.CountLabel.Text = tostring(loadedData) .."/".. tostring(rep.PropLimit.Value)
				else
					LoadData(loadedData)
				end
			else
				notifier.Text = "FAILED TO LOAD"
			end
			notifierCount = notifierCount + 1
			CoroutineLauncher("NotifierDelay")
		end
	else
		if GUI.ConfirmSaveLoadFrame.Mode.Value == "Save" then
			GUI.SaveLoadPropsFrame:TweenPosition(UDim2.new(0.35, 0, 0.3, 0), "Out", "Sine", 0.2)
		end
		GUI.ConfirmSaveLoadFrame:TweenPosition(UDim2.new(0.4, 0, 1.4, 0), "Out", "Sine", 0.2)
	end
end

