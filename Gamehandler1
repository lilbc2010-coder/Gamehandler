						FindToolSetting(baseName, variantName, "Sound_cylinder"), 0, pitchRange)
				end
			elseif string.find(interaction, "Slide") then
				local slide, shell, w = true, true, nil
				if string.find(interaction, "NoChamber") then
					slide = false
				end
				if string.find(interaction, "NoShell") then
					shell = false
				end
				if slide then
					w = tool.Handle.Weld_Slide
					w.C1 = w.C1 * CFrame.new(0, 0, 0.2)
				end
				if shell then
					tool.Chamber.Shell:Emit(1)
				end
				wait(0.1)
				if slide then
					w = tool.Handle.Weld_Slide
					w.C1 = w.C1 * CFrame.new(0, 0, -0.2)
				end
			elseif interaction == "Empty" then
				for _,v in pairs(tool:GetChildren()) do
