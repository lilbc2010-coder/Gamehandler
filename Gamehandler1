function UpdatePropRadios(mode, sound)
	for _,v in pairs(game.Players:GetChildren()) do
		if gameData[v.Name] then
			for _,v in pairs(gameData[v.Name]["Server"]["PropsPlaced"]) do
				if v.Name == "Radio" then
					if string.find(mode, "Announcement") then
						if string.find(mode, "Begin") then
							v.Speaker.Track.Volume = 0
							v.Speaker.Announcement.Volume = 1
							v.Speaker.MusicRunning.Value = false
						end
						v.Speaker.Announcement.SoundId = sound.SoundId
						v.Speaker.Announcement:Play()
						if string.find(mode, "End") then
							wait(sound.TimeLength)
							v.Speaker.MusicRunning.Value = true
							v.Speaker.Track.Volume = 1
							v.Speaker.Announcement.Volume = 0
						end
					else
						v.Speaker.Track.SoundId = sound.SoundId
						v.Speaker.Track.PlaybackSpeed = sound.PlaybackSpeed
						v.Speaker.Track:Play()
					end
				end
			end
		end
	end
end

function PlaySound(source, folder, sound, duration, pitchRange, volume, timePos)
	local s = serv:FindFirstChild(folder):findFirstChild(sound):Clone()
	s.Parent = source
	s.PlaybackSpeed = math.random(pitchRange[1], pitchRange[2]) / 100
	if not volume then
		volume = s.Volume
	end
	s.Volume = volume
	s.TimePosition = timePos
	s:Play()
	if duration == 0 then 
		duration = s.TimeLength
	end
	if duration then
		wait(duration)
		s:Destroy()
	end
end

