					CoroutineLauncher("LaunchThrowable", tool.Handle.CFrame, extraSettings)
				end
			elseif string.find(interaction, "Cylinder") then
				if string.find(interaction, "Empty") then
					for _,v in pairs(tool.Swivel:GetChildren()) do
						if v.name == "Chamber" then
							v.Shell:Emit(1)
						end
					end
					if FindToolSetting(baseName, variantName, "Setting_isDualWielded") then
						for _,v in pairs(char:FindFirstChild(variantName.."_OffHand").Swivel:GetChildren()) do
							if v.name == "Chamber" then
								v.Shell:Emit(1)
							end
						end
					end
					CoroutineLauncher("PlaySound", tool.Handle, "ToolSounds", 
						FindToolSetting(baseName, variantName, "Sound_empty"), 0, {95, 105})
				else
					local rotation, pitchRange = 65, {95, 105}
					if string.find(interaction, "In") then
						rotation, pitchRange = -rotation, {105, 115}
					end
					local w = tool.Handle.Weld_Swivel
					w.C1 = w.C1 * CFrame.Angles(0, 0, math.rad(rotation))
					if FindToolSetting(baseName, variantName, "Setting_isDualWielded") then
						tool = char:FindFirstChild(variantName.."_OffHand")
						w = tool.Handle.Weld_Swivel
						w.C1 = w.C1 * CFrame.Angles(0, 0, math.rad(rotation))
					end
