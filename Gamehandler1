		throwable:Destroy()
	elseif mode == "Smoke" then
		CoroutineLauncher("SmokeGrenade", throwable.PrimaryPart.CFrame)
	elseif mode == "Flash" then
		CoroutineLauncher("PlaySound", throwable.PrimaryPart, "ToolSounds", "ThrowableFragFar1", 0, {95, 105})
		throwable.PrimaryPart.Blast:Emit(20)
		throwable.PrimaryPart.Dust:Emit(10)
		wait(10)
		throwable:Destroy()
	end
