function rep.EquipTool.OnServerInvoke(plr, state, baseName, variantName, toolSlot)
	local char = plr.Character
	if char then
		local models = {char:FindFirstChild(variantName), char:FindFirstChild(variantName.."_OffHand")}
		if not models[1] and state == "Equip" and gameData[plr.Name]["Account"]["ToolsOwned"][variantName] then
			models[1] = serv.Tools:FindFirstChild(baseName):FindFirstChild(variantName).Model:Clone()
			models[1]:SetPrimaryPartCFrame(CFrame.new())
			local holster = models[1]:FindFirstChild("Holster")
			if holster then
				holster:Destroy()
			end
			models[1].PrimaryPart = models[1].Handle
			models[1].Name = variantName
			local falseWeld = Instance.new("BoolValue")
			falseWeld.Name = "PrimaryWeld"
			falseWeld.Parent = models[1].PrimaryPart
			WeldToolParts(models[1])
			models[1].Parent = char
		end
		local newTool
		if models[1] then
			if state == "Equip" then
				for i,model in pairs(models) do
					if model then
						local nameSuffix, weldPart, wName = "", char.RightHand, "HandleWeld"
						if i == 2 then
							nameSuffix, weldPart, wName = "_OffHand", char.LeftHand, "OffHandleWeld"
						end
						if model:IsA("Model") and model.PrimaryPart:FindFirstChild("PrimaryWeld") then
							model.PrimaryPart.PrimaryWeld:Destroy()
						else
							local toolFolder = serv.Tools:FindFirstChild(baseName):FindFirstChild(variantName)
							model = toolFolder:FindFirstChild("Model"..nameSuffix):Clone()
							WeldToolParts(model)
							model.Name = variantName..nameSuffix
							char:FindFirstChild(variantName..nameSuffix):Destroy()
							model.Parent = char
						end
						wait()
						if model:IsA("Model") and model.PrimaryPart then
							model:SetPrimaryPartCFrame(weldPart.CFrame * CFrame.Angles(math.rad(-90), 0, 0))
						end
						local w = Instance.new("Weld") 
						w.Part0 = model.PrimaryPart
						w.Part1 = weldPart
						if not model.PrimaryPart then
							print("Error: Failed to find model.PrimaryPart")
							return
						end
						w.C0 = w.Part0.CFrame:toObjectSpace(w.Part1.CFrame) 
						w.Name = wName
						w.Parent = w.Part1
						model.Parent = char
						if i == 1 then
							newTool = model
							if model:FindFirstChild("Paper") and dummyList[plr.Name] then
								rep.ClipboardUpdateGlobal:FireAllClients("Refresh", plr.Name, dummyList[plr.Name], 
									plr.Character:FindFirstChild("Hunter's Clipboard").Paper)
							end
						end
					end
				end
				if variantName == "Geiger Counter" then
					newTool.Handle.Counter:Play()
					CoroutineLauncher("GeigerCounter", newTool.Handle)
				end
				if string.find(baseName, "Melee") then
					local idleSound = FindToolSetting(baseName, variantName, "Sound_idle")
					local isContinuous = FindToolSetting(baseName, variantName, "Setting_isContinuous")
					if idleSound then
						local s = serv.ToolSounds:FindFirstChild(idleSound):Clone()
						s.Parent = newTool.Handle
						s.Name = "Idle"
						s:Play()
					end
					if isContinuous then
						local s = serv.ToolSounds:FindFirstChild(FindToolSetting(baseName, variantName, "Sound_activate")):Clone()
						s.Name = "Activate"
						s.Parent = newTool.Handle
					end
				end
			elseif state == "Unequip" then
				if gameData[plr.Name]["Server"]["Tools"][toolSlot]["Variant"] == variantName then
					ToolFindAndCheck(plr.Name, char, baseName, variantName, toolSlot)
				end
			end
		end
	end
end
	
function ToolFindAndCheck(plrName, char, baseName, variantName, toolSlot)
	local lastToolName = gameData[plrName]["Server"]["Tools"][toolSlot]["Variant"]
	local lastTool = char:FindFirstChild(lastToolName)
	local lastOffHandTool = char:FindFirstChild(lastToolName.."_OffHand")
	local effectSustained = false
	if lastTool then
		if lastTool:IsA("Model") and (baseName == "Lights" and FindToolSetting(baseName, variantName, "Setting_doesDisplay") and 
			lastTool:FindFirstChild("Light") and lastTool.Light.Light.Enabled) then
			effectSustained = true
		end
		lastTool:Destroy()
		if lastOffHandTool then
			lastOffHandTool:Destroy()
		end
		gameData[plrName]["Server"]["Tools"][toolSlot]["Base"] = "None"
		gameData[plrName]["Server"]["Tools"][toolSlot]["Variant"] = "None"
		for _,v in pairs(char:GetChildren()) do
			if v:IsA("MeshPart") and v:FindFirstChild("HandleWeld") then
				v.HandleWeld:Destroy()
			end
		end
	end
	local toolBase = serv.Tools:FindFirstChild(baseName)
	if not toolBase then
		for _,v in pairs(serv.Tools:GetChildren()) do
			if v:FindFirstChild(variantName) then
				toolBase = v
				baseName = v.Name
				break
			end
		end
	end
	local storedTool = toolBase:FindFirstChild(variantName)
	if storedTool:FindFirstChild("Pass") or storedTool:FindFirstChild("LevelReq") or storedTool:FindFirstChild("Price") then
		if gameData[plrName]["Account"]["ToolsOwned"][storedTool.Name] then
			gameData[plrName]["Server"]["Tools"][toolSlot] = {Variant = variantName, Base = baseName}
			local doesDisplay = FindToolSetting(baseName, variantName, "Setting_doesDisplay")
			if (toolSlot == "Primary" or toolSlot == "Secondary") or doesDisplay then
				WeldToHolster(char, storedTool, effectSustained)
			else
				local toolIsOwned = Instance.new("BoolValue")
				toolIsOwned.Name = variantName
				toolIsOwned.Parent = char
				if storedTool:FindFirstChild("Model_OffHand") then
					toolIsOwned = Instance.new("BoolValue")
					toolIsOwned.Name = variantName.."_OffHand"
					toolIsOwned.Parent = char
				end
			end
			return true
		end
		gameData[plrName]["Server"]["Tools"][toolSlot] = {Variant = "None", Base = "None"}
		return false
	else
		gameData[plrName]["Server"]["Tools"][toolSlot] = {Variant = variantName, Base = baseName}
		local doesDisplay = FindToolSetting(baseName, variantName, "Setting_doesDisplay")
		if (toolSlot == "Primary" or toolSlot == "Secondary") or doesDisplay then
			WeldToHolster(char, storedTool, effectSustained)
		else
			local toolIsOwned = Instance.new("BoolValue")
			toolIsOwned.Name = variantName
			toolIsOwned.Parent = char
			if storedTool:FindFirstChild("Model_OffHand") then
				toolIsOwned = Instance.new("BoolValue")
				toolIsOwned.Name = variantName.."_OffHand"
				toolIsOwned.Parent = char
			end
		end
		return true
	end
end

function rep.LoadItem.OnServerInvoke(plr, interaction, input1, input2, input3)
	return LoadItem(plr, interaction, input1, input2, input3)
end

function LoadItem(plr, interaction, input1, input2, input3)
	--if loading tool: input1 = base name, input2 = variant name, input3 = tool slot
	--if deleting tool: input1 = "None", input2 = variant name
	--if loading morph: input1 = item name
	local char = plr.Character
	if char then
		if string.find(interaction, "ToolChange") then
			if input1 == "None" then
				gameData[plr.Name]["Server"]["Tools"][input2] = {Variant = "None", Base = "None"}
				local previousTool = char:FindFirstChild(input2)
				if previousTool then
					previousTool:Destroy()
					local previousToolOffHand = char:FindFirstChild(input2.."_OffHand")
					if previousToolOffHand then
						previousToolOffHand:Destroy()
					end
				end
				return true
			end
			return ToolFindAndCheck(plr.Name, char, input1, input2, input3)
		elseif string.find(interaction, "MorphChange") then
			if string.find(interaction, "Preset") then
				if input1 ~= "None" then
					local morph = serv.Morphs:FindFirstChild(input1)
					local plrOwnsItem = true
					if morph:FindFirstChild("Pass") then
						if not gameData[plr.Name]["Account"]["MorphsOwned"][morph.Name] then
							plrOwnsItem = false
						end
					end
					if plrOwnsItem then
						for _,v in pairs(char:GetChildren()) do
							if string.find(v.Name, "Container") then
								v:Destroy()
							end
						end
						for i,v in pairs(bodyPartNames) do
							local container = Instance.new("Folder")
							container.Name = i.."Container"
							container.Parent = char
						end
						local transparency = 0
						for _,v in pairs(char.PrimaryPart:GetChildren()) do
							if v:IsA("Sound") then
								v:Stop()
							end
						end
						local nonHumanoid = morph:FindFirstChild("NonHumanoid")
						if nonHumanoid then
							transparency = 1
							if nonHumanoid.Value == "FlyingBot" then
								char.PrimaryPart.FlyingBot_Hover:Play()
							end
						elseif char.PrimaryPart.FlyingBot_Hover.IsPlaying then
							char.PrimaryPart.FlyingBot_Hover:Stop()
						end
						for _,v in pairs(char:GetChildren()) do
							if containerNames[v.Name] then
								local part = v
								if v.Name == "Head" then
									part = char.MeshHead
									local face = part:FindFirstChild("face")
									if face then
										face.Transparency = transparency
									end
								end
								part.Transparency = transparency
							elseif v:IsA("Accessory") then
								v.Handle.Transparency = transparency
							end
							if v:FindFirstChild("WeldPart") then
								v:Destroy()
							end
						end
						for _,item in pairs(morph:GetChildren()) do
							if item:IsA("Folder") then
								local trueName = string.sub(item.Name, 1, string.len(item.Name) - 5)
								if containerNames[trueName] then
									local container = char:FindFirstChild(containerNames[trueName].."Container")
									local charWeldPart = char:FindFirstChild(trueName)
									for _,part in pairs(item:GetChildren()) do
										local clo = part:Clone()
										local w = Instance.new('Weld')
										w.Part0 = charWeldPart
										w.Part1 = clo
										w.C0 = morph:FindFirstChild(trueName).CFrame:inverse() * part.CFrame
										w.Parent = charWeldPart
										clo.Parent = container
									end
									if morph:FindFirstChild(containerNames[trueName].."Invisible") then
										charWeldPart.Transparency = 1
									end
								else
									local origin = morph:FindFirstChild(trueName)
									local clo = origin:Clone()
									local charWeldPart = char:FindFirstChild(clo.WeldPart.Value)
									clo.CFrame = charWeldPart.CFrame
									local m = Instance.new('Motor6D')
									m.Part0 = charWeldPart
									m.Part1 = clo
									m.C0 = morph:FindFirstChild(origin.WeldPart.Value).CFrame:inverse() * origin.CFrame
									m.Parent = charWeldPart
									clo.Parent = char
									local container = Instance.new("Folder")
									container.Name = trueName.."Container"
									container.Parent = char
									for _,part in pairs(item:GetChildren()) do
										local charWeldPart = char:FindFirstChild(trueName)
										local clo = part:Clone()
										local w = Instance.new('Weld')
										w.Part0 = charWeldPart
										w.Part1 = clo
										w.C0 = morph:FindFirstChild(trueName).CFrame:inverse() * part.CFrame
										w.Parent = charWeldPart
										clo.Parent = container
									end
								end
								if containerNames[trueName] then
									gameData[plr.Name]["Server"]["Equipment"][containerNames[trueName]] = morph.Name
								end
							end
						end
						for _,container in pairs(char:GetChildren()) do
							if container:IsA("Folder") and string.find(container.Name, "Container") then
								for _,part in pairs(container:GetChildren()) do
									local beam = part:FindFirstChild("Beam")
									if beam then
										local jointName = string.sub(part.Name, 1, string.len(part.Name) - 1)
										beam.Attachment1 = container:FindFirstChild(jointName.."2").A1
									end
								end
							end
						end
						if nonHumanoid then
							char.HumanState.Value = "NonHumanoid"
						end
						return true
					else
						return false
					end
				else
					for _,v in pairs(char:GetChildren()) do
						if string.find(v.Name, "Container") then
							v:Destroy()
						end
					end
					for i,v in pairs(bodyPartNames) do
						local container = Instance.new("Folder")
						container.Name = i.."Container"
						container.Parent = char
					end
					for _,v in pairs(char:GetChildren()) do
						if containerNames[v.Name] then
							gameData[plr.Name]["Server"]["Equipment"][containerNames[v.Name]] = "None"
							local part = v
							if v.Name == "Head" then
								part = char.MeshHead
								local face = part:FindFirstChild("face")
								if face then
									face.Transparency = 0
								end
							end
							part.Transparency = 0
						elseif v:IsA("Accessory") then
							v.Handle.Transparency = 0
						end
					end
					return true
				end
			else
				local trueName = string.sub(interaction, 13, string.len(interaction))
				local previousContainer = char:FindFirstChild(trueName.."Container")
				if previousContainer then
					local cName = string.sub(previousContainer.Name, 1, string.len(previousContainer.Name) - 9)
					previousContainer:Destroy()
					for _,v in pairs(bodyPartNames[cName]) do
						if v == "Head" then
							v = "MeshHead"
						end
						char:FindFirstChild(v).Transparency = 0
					end
				end
				if input1 ~= "None" then
					local container = Instance.new("Folder")
					container.Name = trueName.."Container"
					local morph = serv.Morphs:FindFirstChild(input1)
					local plrOwnsItem = true
					if morph:FindFirstChild("Pass") then
						if not gameData[plr.Name]["Account"]["MorphsOwned"][morph.Name] then
							plrOwnsItem = false
						end
					end
					if plrOwnsItem then
						for _,v in pairs(bodyPartNames[trueName]) do
							local folder = morph:FindFirstChild(v.."Parts")
							if folder then
								local charWeldPart = char:FindFirstChild(v)
								for _,part in pairs(folder:GetChildren()) do
									local clo = part:Clone()
									local w = Instance.new('Weld')
									w.Part0 = charWeldPart
									w.Part1 = clo
									w.C0 = morph:FindFirstChild(v).CFrame:inverse() * part.CFrame
									w.Parent = charWeldPart
									clo.Parent = container
								end
								if morph:FindFirstChild(trueName.."Invisible") then
									charWeldPart.Transparency = 1
								end
							end
						end
						for _,part in pairs(container:GetChildren()) do
							local beam = part:FindFirstChild("Beam")
							if beam then
								local jointName = string.sub(part.Name, 1, string.len(part.Name) - 1)
								beam.Attachment1 = container:FindFirstChild(jointName.."2").A1
							end
						end
						container.Parent = char
						gameData[plr.Name]["Server"]["Equipment"][trueName] = morph.Name
						RestructureHumanoid(char, morph, container)
						return true
					else
						return false
					end
				else
					gameData[plr.Name]["Server"]["Equipment"][trueName] = "None"
					RestructureHumanoid(char)
					return true
				end
			end
		elseif interaction == "NameChange" then
			local newName = Chat:FilterStringAsync(input1, plr, plr)
			local falseHead = FindFalseHumanoid(char)
			falseHead.Name = newName
			rep.CharacterBios:FindFirstChild(plr.Name).RPName.Value = newName
			gameData[plr.Name]["Server"]["RPName"] = newName
			return newName
		elseif interaction == "BioChange" then
			local newBio = Chat:FilterStringAsync(input1, plr, plr)
			rep.CharacterBios:FindFirstChild(plr.Name).Value = newBio
			gameData[plr.Name]["Server"]["Bio"] = newBio
			return newBio
		elseif interaction == "ShirtChange" then
			local shirt = char:FindFirstChild("Shirt")
			if shirt then
				local shirtInStorage = false
				if not serv.PlayerClothes.Shirts:FindFirstChild(plr.Name) then
					for _,v in pairs(serv.Shirts:GetChildren()) do
						if v.ShirtTemplate == shirt.ShirtTemplate then
							shirtInStorage = true
							break
						end
					end
				else
					shirtInStorage = true
				end
				if not shirtInStorage then
					local storage = Instance.new("StringValue")
					storage.Value = shirt.ShirtTemplate
					storage.Name = plr.Name
					storage.Parent = serv.PlayerClothes.Shirts
				end
				shirt:Destroy()
			end
			local plrShirt = serv.PlayerClothes.Shirts:FindFirstChild(plr.Name)
			if plrShirt then
				if input1 == "Custom" then
					shirt = Instance.new("Shirt")
					shirt.ShirtTemplate = plrShirt.Value
					shirt.Name = "Shirt"
					shirt.Parent = char
					gameData[plr.Name]["Server"]["Shirt"] = "Custom"
				elseif string.find(input1, "://") then
					shirt = Instance.new("Shirt")
					shirt.ShirtTemplate = input1
					shirt.Name = "Shirt"
					shirt.Parent = char
					gameData[plr.Name]["Server"]["Shirt"] = "Loaded"
				else
					shirt = serv.Shirts:FindFirstChild(input1):Clone()
					shirt.Name = "Shirt"
					shirt.Parent = char
					gameData[plr.Name]["Server"]["Shirt"] = input1
				end
			end
		elseif interaction == "PantsChange" then
			local pants = char:FindFirstChild("Pants")
			if pants then
				local pantsInStorage = false
				if not serv.PlayerClothes.Pants:FindFirstChild(plr.Name) then
					for _,v in pairs(serv.Pants:GetChildren()) do
						if v.PantsTemplate == pants.PantsTemplate then
							pantsInStorage = true
							break
						end
					end
				end
				if not pantsInStorage then
					local storage = Instance.new("StringValue")
					storage.Value = pants.PantsTemplate
					storage.Name = plr.Name
					storage.Parent = serv.PlayerClothes.Pants
				end
				pants:Destroy()
			end
			local plrPants = serv.PlayerClothes.Pants:FindFirstChild(plr.Name)
			if plrPants then
				if input1 == "Custom" then
					pants = Instance.new("Pants")
					pants.PantsTemplate = plrPants.Value
					pants.Name = "Pants"
					pants.Parent = char
					gameData[plr.Name]["Server"]["Pants"] = "Custom"
				elseif string.find(input1, "://") then
					pants = Instance.new("Pants")
					pants.PantsTemplate = input1
					pants.Name = "Pants"
					pants.Parent = char
					gameData[plr.Name]["Server"]["Pants"] = "Loaded"
				else
					pants = serv.Pants:FindFirstChild(input1):Clone()
					pants.Name = "Pants"
					pants.Parent = char
					gameData[plr.Name]["Server"]["Pants"] = input1
				end
			end
		elseif interaction == "AddAccessory" then
			if not input1 or (input1 and bannedAccessoryList["id"..input1]) then
				return false
			end
			local newAccessory = InsertService:LoadAsset(input1)
			local item = newAccessory:FindFirstChildOfClass("Accessory")
			if not item then
				return false
			end
			if not item.Handle:FindFirstChild("Mesh") then
				item.Handle.SpecialMesh.Name = "Mesh"
			end
			for _,v in pairs(newAccessory:GetChildren()) do
				for _,n in pairs(char:GetChildren()) do
					if n:IsA("Accessory") and n.Handle.Mesh.MeshId == v.Handle.Mesh.MeshId then
						newAccessory:Destroy()
						return false
					end
				end
				break
			end
			item.Parent = serv
			newAccessory:Destroy()
			newAccessory = item
			newAccessory.Handle.CanCollide = false
			local originalId = Instance.new("NumberValue")
			originalId.Name = "OriginalId"
			originalId.Value = input1
			originalId.Parent = newAccessory.Handle.Mesh
			gameData[plr.Name]["Server"]["Accessories"]["id"..input1] = {Name = newAccessory.Name, Object = newAccessory}
			char.Humanoid:AddAccessory(newAccessory)
			return newAccessory
		elseif interaction == "RemoveAccessory" then
			for _,v in pairs(char:GetChildren()) do
				if v:IsA("Accessory") and v == input1 then
					gameData[plr.Name]["Server"]["Accessories"]["id"..v.Handle.Mesh.OriginalId.Value] = nil
					v:Destroy()
					return true
				end
			end
			return false
		elseif string.find(interaction, "AccessoryChange") then
			if string.find(interaction, "ResetId") then
				local ot = input1.Handle.Mesh:FindFirstChild("OriginalTexture")
				if ot then
					input1.Handle.Mesh.TextureId = ot.Value
					gameData[plr.Name]["Server"]["Accessories"]["id"..input1.Handle.Mesh.OriginalId.Value]["Texture"] = nil
				end
			elseif string.find(interaction, "SetId") then
				if not input1.Handle.Mesh:FindFirstChild("OriginalTexture") then
					local ot = Instance.new("StringValue")
					ot.Name = "OriginalTexture"
					ot.Value = input1.Handle.Mesh.TextureId
					ot.Parent = input1.Handle.Mesh
				end
				input1.Handle.Mesh.TextureId = "rbxassetid://"..input2
				gameData[plr.Name]["Server"]["Accessories"]["id"..input1.Handle.Mesh.OriginalId.Value]["Texture"] = input2
			elseif string.find(interaction, "ResetColor") then
				input1.Handle.Mesh.VertexColor = Vector3.new(1, 1, 1)
				local t = gameData[plr.Name]["Server"]["Accessories"]["id"..input1.Handle.Mesh.OriginalId.Value]["Texture"]
				for _,v in pairs({"r", "g", "b"}) do
					gameData[plr.Name]["Server"]["Accessories"]["id"..input1.Handle.Mesh.OriginalId.Value][v] = nil
				end
			elseif string.find(interaction, "SetColor") then
				input1.Handle.Mesh.VertexColor = input2
				local t = gameData[plr.Name]["Server"]["Accessories"]["id"..input1.Handle.Mesh.OriginalId.Value]["Texture"]
				for i,v in pairs({r = "X", g = "Y", b = "Z"}) do
					gameData[plr.Name]["Server"]["Accessories"]["id"..input1.Handle.Mesh.OriginalId.Value][i] = input2[v]
				end
			end
		elseif string.find(interaction, "BodyColorChange") then
			if string.find(interaction, "SetColor") then
				if not char.Humanoid:FindFirstChild("OriginalColor") then
					local oc = Instance.new("Color3Value")
					oc.Name = "OriginalColor"
					oc.Value = char.MeshHead.Color
					oc.Parent = char.Humanoid
				end
				local newColor = Color3.new(input1["r"], input1["g"], input1["b"])
				for _,v in pairs(char:GetChildren()) do
					if containerNames[v.Name] then
						v.Color = newColor
					end
				end
				gameData[plr.Name]["Server"]["BodyColor"] = input1
				char.MeshHead.Color = newColor
			elseif string.find(interaction, "ResetColor") then
				local color = char.Humanoid:FindFirstChild("OriginalColor")
				if color then
					for _,v in pairs(char:GetChildren()) do
						if containerNames[v.Name] then
							v.Color = color.Value
						end
					end
					char.MeshHead.Color = color.Value
					gameData[plr.Name]["Server"]["BodyColor"] = color.Value
				end
			end
		end
	end
end
	
function RestructureHumanoid(char, morph, ignore)
	local lastHumanState = char.HumanState.Value
	local nextHumanState = "Humanoid"
	local transparency = 0
	if morph and morph:FindFirstChild("NonHumanoid") then
		transparency = 1
		nextHumanState = "NonHumanoid"
	elseif lastHumanState == "NonHumanoid" then
		for _,v in pairs(char:GetChildren()) do
			if v ~= ignore and string.find(v.Name, "Container") then
				v:Destroy()
			end
		end
		char.HumanState.Value = "Humanoid"
	end
	for _,v in pairs(char.PrimaryPart:GetChildren()) do
		if v:IsA("Sound") and v.IsPlaying then
			v:Stop()
		end
	end
	if nextHumanState ~= lastHumanState then
		for _,v in pairs(char:GetChildren()) do
			local cName = containerNames[v.Name]
			if cName then
				local part = v
				if part.Name == "Head" then
					part = char.MeshHead
					local face = part:FindFirstChild("face")
					if face then
						face.Transparency = transparency
					end
				end
				local changeTransparency = true
				if morph and morph:FindFirstChild(cName.."Invisible") and char:FindFirstChild(cName.."Container") then
					changeTransparency = false
				end
				if changeTransparency then
					part.Transparency = transparency
				end
			elseif v:IsA("Accessory") then
				v.Handle.Transparency = transparency
			end
		end
	end
end
	
