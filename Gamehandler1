function GenerateTargetedLightning(origin, targetPos)
	local segmentlength = 2
	local variance = 1.5
	local timetofade = .25
	local range = 20
    local m = Instance.new("Model")
    m.Name = "Lightning"
    local lastpos = origin
    local totalsegments = math.ceil(range / segmentlength)
    local direction = (targetPos - origin).unit
    local struck = false
    for i = 1, totalsegments do
        if not struck then
			local r1, r2, r3 = math.random(), math.random(), math.random() 
            local entropy = Vector3.new(variance * ((r1 * 2) - 1), variance * ((r2 * 2) - 1), variance * ((r3 * 2) - 1))
            local newpos = origin + (direction * (range * (i / totalsegments))) + entropy
            local hit, endpos = LightningRaycast(lastpos, (newpos - lastpos).unit, (lastpos - newpos).magnitude)
            local l = Instance.new("Part")
            l.CanCollide = false
            l.Anchored = true
            l.BrickColor = BrickColor.new("White")
			l.Material = Enum.Material.Neon
            l.Size = Vector3.new(0.2, (lastpos - endpos).magnitude, 0.2)
            local light = Instance.new("PointLight")
            light.Parent = l
            light.Range = 7
            light.Brightness = 9
            light.Color = l.Color
            l.CFrame = CFrame.new(lastpos, endpos) * CFrame.Angles(math.pi/2, 0, 0) * CFrame.new(0, - (lastpos - endpos).magnitude/2, 0)
            l.Parent = m
            lastpos = endpos
        end
    end
    m.Parent = game.Workspace
	wait(0.2)
	m:Destroy()
end

function LightningRaycast(spos,vec,currentdist,char)
    local hit2, pos2 = game.Workspace:FindPartOnRay(Ray.new(spos + (vec * 0.01), vec * currentdist), char)
    if hit2 ~= nil and pos2 then
        if hit2.Transparency >= 0.5 or hit2.Name == "Handle" then
            local currentdist = currentdist - (pos2 - spos).magnitude
            return LightningRaycast(pos2, vec, currentdist)
        end
    end
    return hit2, pos2
end

