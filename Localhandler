function ToggleMetavision()
	local button = gameFrame.MetaFrame
	local activated = button.On
	local newMode = true
	if activated.Value then
		newMode = false
	end
	rep.Metavision:FireServer(newMode)
	activated.Value = newMode
	for _,v in pairs(game.Players:GetChildren()) do
		local upperTorso = v.Character and v.Character:FindFirstChild("UpperTorso")
		if upperTorso and upperTorso:FindFirstChild("PlayerDisplay") and upperTorso.CFrame.p.Y > -110 and 
			not upperTorso:FindFirstChild("OriginalTransparency") then
			upperTorso.PlayerDisplay.Display.Visible = newMode
		end
	end
	if activated.Value then
		CoroutineLauncher("MetavisionUpdater")
	end
end

function MetavisionUpdater()
	local activated = gameFrame.MetaFrame.On
	while activated.Value do
		wait(1)
		if activated.Value then
			for _,v in pairs(game.Players:GetChildren()) do
				local upperTorso = v.Character and v.Character:FindFirstChild("UpperTorso")
				if upperTorso and upperTorso:FindFirstChild("PlayerDisplay") then
					if upperTorso.CFrame.p.Y > -110 and not upperTorso:FindFirstChild("OriginalTransparency") then
						upperTorso.PlayerDisplay.Display.Visible = true
					elseif upperTorso.CFrame.p.Y <= -110 or upperTorso:FindFirstChild("OriginalTransparency") then
						upperTorso.PlayerDisplay.Display.Visible = false
					end
				end
			end
		end
	end
end

function ToggleTool(v)
	if equippedTool["Reloading"] ~= "None" or equippedTool["Recovering"] or anims["Drive"].IsPlaying then
		return
	end
	local toolboxFrame = toolboxFrame
	if equippedTool["Toggle"] == "Unequipped" and v.Text ~= equippedTool["Variant"] and v.Text ~= "None" 
		and not humanStates["swim"] and not humanStates["fall"] then
		EquipTool(v)
	elseif equippedTool["Toggle"] == "Equipped" and (v.Text ~= "None" and equippedTool["Toggle"] == "Equipped") then
		local lastTool = toolboxFrame:FindFirstChild(equippedTool["Slot"])
		if lastTool then
			lastTool.BackgroundColor3 = Color3.fromRGB(132, 70, 0)
			lastTool.Button.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
		end
		if equippedTool["Variant"] ~= equippedTool["Config"] then
			ReconfigureUndermount()
		end
		local state = "stand"
		if humanStates["climb"] then
			state = "climb"
		elseif humanStates["crouch"] then
			state = "crouch"
		elseif humanStates["prone"] then
			state = "prone"
			if humanStates["moving"] then
				return
			else
				ChangeSpeed("ProneToggling")
			end
		end
		local endEffect = FindToolSetting("Setting_endEffect")
		if endEffect and string.find(endEffect, "Client") and toolboxFrame:FindFirstChild(equippedTool["Slot"]).SelectedItem.Value then
			CoroutineLauncher("ToolEffect", string.sub(endEffect, 8, string.len(endEffect)))
		end
		local unequipAnim = toolAnims[FindToolSetting("Anim_"..state.."ToggleEquip")]
		equippedTool["Toggle"] = "Unequipping"
		unequipAnim:Play(0.2, 1, -1)
		unequipAnim.TimePosition = unequipAnim.Length
		local stopIdle = "stand"
		local stopMovement
		if humanStates["prone"] then
			stopIdle = "prone"
		elseif humanStates["crouch"] then
			stopIdle = "crouch"
		end
		toolAnims[FindToolSetting("Anim_"..stopIdle)]:Stop(0.4)
		if humanStates["moving"] then
			if state ~= "climb" then
				if humanStates["run"] then
					stopMovement = "run"
				elseif humanStates["stand"] then
					stopMovement = "walk"
				else
					stopMovement = stopIdle.."Move"
				end
			end
			if stopMovement then
				if not FindToolSetting("Anim_"..stopMovement) then
					print("Failed to load: Anim_"..stopMovement)
				end
				toolAnims[FindToolSetting("Anim_"..stopMovement)]:Stop(0.2)
			end
		end
		if not string.find(equippedTool["Slot"], "Utility") and (lastTool.ChamberState.Value == "Loaded" and 
			FindToolSetting("Setting_chambering") == "Hammer") then
			lastTool.ChamberState.Value = "Empty"
			if FindToolSetting("Setting_isDualWielded") then
				lastTool.ChamberState_OffHand.Value = "Empty"
			end
		end
		local isEquipping = equippedTool["Variant"] ~= v.Text and v.Text ~= "None"
		local animConnection
		animConnection = unequipAnim.KeyframeReached:Connect(function(keyframe)
			if keyframe == "Discard" then
				wait(0.1)
				unequipAnim:AdjustSpeed(0)
				rep.EquipTool:InvokeServer("Unequip", equippedTool["Base"], equippedTool["Config"], equippedTool["Slot"])
				unequipAnim:AdjustSpeed(-1)
				for i,v in pairs(ignoreList) do
					if v.Name == lastTool.Button.Text then
						table.remove(ignoreList, i)
						break
					end
				end
			elseif keyframe == "Unequipped" then
				if not isEquipping then
					equippedTool["Toggle"] = "Unequipped"
				end
				ResetTool()
				if humanStates["prone"] and not isEquipping then
					ChangeSpeed("Prone")
					if CheckMovementKeys() then
						anims["proneMove"]:Play(0.2, 1, 1)
						humanStates["moving"] = true
					end
				end
				animConnection:Disconnect()
				if isEquipping then
					EquipTool(v, true)
				end
			end
		end)
	end
end

function ScanProp(item)
