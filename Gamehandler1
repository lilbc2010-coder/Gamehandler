function FindToolSetting(baseName, variantName, itemName)
	local toolHome = serv.Tools:FindFirstChild(baseName)
	local toolItem = toolHome:FindFirstChild(variantName):FindFirstChild(itemName)
	if not toolItem then
		toolItem = toolHome:FindFirstChild(itemName)
		if toolItem then
			toolItem = toolItem.Value
		else
			toolItem = false
		end
	else
		toolItem = toolItem.Value
	end
	return toolItem
end
