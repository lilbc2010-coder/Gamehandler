function InteractElectricDoor(button)
	local doorModel = button.Parent
	doorModel.Debounce.Value = true
	local goal1CF, goal2CF = doorModel.Door1.OutCF.Value, doorModel.Door2.OutCF.Value
	if doorModel.Open.Value then
		doorModel.Open.Value = false
		goal1CF = doorModel.Door1.InCF.Value
		goal2CF = doorModel.Door2.InCF.Value
	else
		doorModel.Open.Value = true
	end
	CoroutineLauncher("PlaySound", button, "InteractiveSounds", "ButtonBeep", 0, {95, 105})
	wait(1)
	CoroutineLauncher("PlaySound", button, "InteractiveSounds", "ElectricDoor", 0, {95, 105})
	wait(0.4)
	local firstT = tick()
	local start1CF, start2CF = doorModel.Door1.PrimaryPart.CFrame, doorModel.Door2.PrimaryPart.CFrame
	local objectRunner
	objectRunner = RunService.Stepped:connect(function()
		local interval = math.min((tick() - firstT) / 2, 1)
		doorModel.Door1:SetPrimaryPartCFrame(start1CF:lerp(goal1CF, interval))
		doorModel.Door2:SetPrimaryPartCFrame(start2CF:lerp(goal2CF, interval))
		if interval == 1 then
			objectRunner:Disconnect()
			wait(0.2)
			doorModel.Debounce.Value = false
		end
	end)
end

