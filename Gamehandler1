rep.ToolInteraction.OnServerEvent:Connect(function(plr, interaction, baseName, variantName, chamberState, isOffHand, extraSettings)
	--throwable: extraSettings = {power, angle, type}
	local char = plr.Character
	if char then
		local suffix = ""
		if isOffHand then
			suffix = "_OffHand"
		end
		local tool = char:FindFirstChild(variantName..suffix)
		if tool and tool:IsA("Model") then
			if string.find(interaction, "StabStart") then
				tool.Blade.Trail.Enabled = true
			elseif string.find(interaction, "StabStop") then
				tool.Blade.Trail.Enabled = false
			elseif interaction == "ActivateStart" then
				tool.Handle.Smoke.Enabled = true
				tool.Handle.Activate.PlaybackSpeed = math.random(95, 105) / 100
				tool.Handle.Activate:Play()
			elseif interaction == "ActivateStop" then
				tool.Handle.Smoke.Enabled = false
				tool.Handle.Activate:Stop()
			elseif string.find(interaction, "PumpSlide") then
				local offset = -0.3
				if string.find(interaction, "In") then
					offset = -offset
					local originalColor = tool.Chamber.OriginalColor
					if originalColor:IsA("Color3Value") then
						tool.Chamber.Color = originalColor.Value
					else
						tool.Chamber.BrickColor = originalColor.Value
					end
				elseif chamberState ~= "Empty" then
					tool.Chamber.Shell:Emit(1)
					tool.Chamber.BrickColor = BrickColor.new("Really black")
				end
				local w = tool.Handle.Weld_Pump
				w.C0 = w.C0 * CFrame.new(0, 0, offset)
			elseif string.find(interaction, "Bow") then
				if string.find(interaction, "Knock") then
					for _,v in pairs(tool:GetChildren()) do
						if v.Name == "Knocked" then
							v.Transparency = 0
						end
					end
				elseif string.find(interaction, "Draw") then
					for _,v in pairs(tool.Drawn:GetChildren()) do
						v.Transparency = 0
					end
					for _,v in pairs(tool.Loose:GetChildren()) do
						v.Transparency = 1
					end
					for _,v in pairs(tool:GetChildren()) do
						if v.Name == "Knocked" then
							v.Transparency = 1
						end
					end
					local w = tool.Handle.Weld_LeftBow
					w.C1 = w.C1 * CFrame.Angles(0, math.rad(15), 0)
					w = tool.Handle.Weld_RightBow
					w.C1 = w.C1 * CFrame.Angles(0, math.rad(15), 0)
				elseif string.find(interaction, "Loose") then
					local w = tool.Handle.Weld_LeftBow
					w.C1 = w.C1 * CFrame.Angles(0, math.rad(-15), 0)
					w = tool.Handle.Weld_RightBow
					w.C1 = w.C1 * CFrame.Angles(0, math.rad(-15), 0)
					for _,v in pairs(tool.Drawn:GetChildren()) do
						v.Transparency = 1
					end
					for _,v in pairs(tool.Loose:GetChildren()) do
						v.Transparency = 0
					end
				end
			elseif string.find(interaction, "PumpRotate") then
				local rotation = 35
				if string.find(interaction, "Up") then
					rotation = -rotation
				elseif chamberState ~= "Empty" then
					tool.Chamber.Shell:Emit(1)
				end
				local w = tool.Handle.Weld_Pump
				w.C1 = w.C1 * CFrame.Angles(math.rad(rotation), 0, 0)
			elseif string.find(interaction, "Pistol") then
				local charge = tool:FindFirstChild("ChargeHandle")
				local offset = 0.2
				if string.find(interaction, "In") then
					offset = -offset
				elseif chamberState ~= "Empty" then
					tool.Chamber.Shell:Emit(1)
				end
				local w = tool.Handle.Weld_Slide
				w.C1 = w.C1 * CFrame.new(0, 0, offset)
				if charge then
					w = tool.Handle.Weld_ChargeHandle
					w.C1 = w.C1 * CFrame.new(0, 0, offset)
				end
			elseif interaction == "Pickaxe Swing" then
				CoroutineLauncher("MineWall", tool.Handle.Position, variantName, plr)
			elseif string.find(interaction, "Grenade") then
				if string.find(interaction, "Toss") then
					for _,v in pairs(tool:GetChildren()) do
						if v:IsA("Model") and v.PrimaryPart.Transparency == 0 then
							for _,b in pairs(v:GetChildren()) do
								b.Transparency = 1
							end
							break
						end
					end
