		equippedTool["Recovering"] or plrState == "Customizing" or mKs["LeftShift"] or humanStates["fall"]) then
		if equippedTool["Toggle"] == "Equipped" and FindToolSetting("Setting_crouchNull") then
			return
		end
		ChangeState("Crouch")
	end
end

